<div class="wo-create-page">

    <div class="wo-create-card">

        <div class="wo-create-header">

            <div class="wo-create-icon">
                📋
            </div>

            <div>

                <h1>Buat Work Order</h1>

                <p>
                    Laporkan kebutuhan atau masalah IT Anda.
                </p>

            </div>

        </div>


        <div class="wo-create-form">

            <%- include("form") %>

        </div>

    </div>

</div>

<script>
(function () {

    const targetSections =
        <%- JSON.stringify(targetSections || []) %>;

    const categories =
        <%- JSON.stringify(categories || []) %>;

    const departmentSelect =
        document.getElementById("targetDepartmentId");

    const sectionSelect =
        document.getElementById("targetSectionId");

    const kategori =
        document.getElementById("kategori");

    const subkategori =
        document.getElementById("subkategori");

    const hint =
        document.getElementById("targetScopeHint");

    if (!departmentSelect || !sectionSelect || !kategori || !subkategori) {
        return;
    }

    function resetCategories(message) {
        kategori.innerHTML = '<option value="">Pilih Kategori</option>';
        kategori.disabled = true;
        subkategori.innerHTML = '<option value="">Pilih Sub Kategori</option>';
        subkategori.disabled = true;
        if (hint) hint.querySelector("small").textContent = message;
    }

    function loadSections() {
        const departmentId = Number(departmentSelect.value);

        sectionSelect.innerHTML = '<option value="">Pilih Seksi Tujuan</option>';
        sectionSelect.disabled = true;
        resetCategories("Pilih Seksi Tujuan untuk menentukan scope pekerjaan.");

        if (!departmentId) return;

        targetSections
            .filter(section => Number(section.department_id) === departmentId)
            .forEach(section => {
                const option = document.createElement("option");
                option.value = section.id;
                option.textContent = section.nama;
                sectionSelect.appendChild(option);
            });

        sectionSelect.disabled = sectionSelect.options.length <= 1;
    }

    function loadCategories() {
        const sectionId = Number(sectionSelect.value);
        kategori.innerHTML = '<option value="">Pilih Kategori</option>';
        kategori.disabled = true;
        subkategori.innerHTML = '<option value="">Pilih Sub Kategori</option>';
        subkategori.disabled = true;

        const section = targetSections.find(item => Number(item.id) === sectionId);
        if (!section) {
            if (hint) hint.querySelector("small").textContent = "Pilih Seksi Tujuan untuk menentukan scope pekerjaan.";
            return;
        }

        const allowed = new Set((section.categoryIds || []).map(Number));

        categories
            .filter(category => allowed.has(Number(category.id)))
            .forEach(category => {
                const option = document.createElement("option");
                option.value = category.nama;
                option.textContent = category.nama;
                kategori.appendChild(option);
            });

        kategori.disabled = kategori.options.length <= 1;

        if (hint) {
            hint.querySelector("small").textContent =
                kategori.disabled
                    ? "Seksi ini belum memiliki Kategori."
                    : "Kategori yang tampil hanya yang menjadi scope Seksi tujuan.";
        }
    }

    function loadSubcategories() {
        const selected = kategori.value;
        subkategori.innerHTML = '<option value="">Pilih Sub Kategori</option>';
        subkategori.disabled = true;
        if (!selected) return;

        const category = categories.find(item => item.nama === selected);
        if (!category || !Array.isArray(category.subcategories)) return;

        category.subcategories.forEach(item => {
            const option = document.createElement("option");
            option.value = item.nama;
            option.textContent = item.nama;
            subkategori.appendChild(option);
        });

        subkategori.disabled = category.subcategories.length === 0;
    }

    departmentSelect.addEventListener("change", loadSections);
    sectionSelect.addEventListener("change", loadCategories);
    kategori.addEventListener("change", loadSubcategories);

    resetCategories("Pilih Seksi Tujuan untuk menentukan scope pekerjaan.");

})();
</script>