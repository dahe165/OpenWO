<div class="wo-create-page">

    <div class="wo-create-card">

        <div class="wo-create-header">

            <div class="wo-create-icon">
                📋
            </div>

            <div>

                <h1>Buat Work Order</h1>

                <p>
                    Laporkan kebutuhan atau masalah IT Anda.
                </p>

            </div>

        </div>


        <div class="wo-create-form">

            <%- include("form") %>

        </div>

    </div>

</div>

<script>
(function () {

    /*
     * =====================================
     * MASTER DATA
     * =====================================
     *
     * Data kategori dan subkategori
     * berasal dari database melalui controller.
     */

    const categories =
        <%- JSON.stringify(categories || []) %>;


    const kategori =
        document.getElementById("kategori");


    const subkategori =
        document.getElementById("subkategori");


    if (!kategori || !subkategori) {
        return;
    }


    kategori.addEventListener(
        "change",
        function () {

            const selected =
                this.value;


            /*
             * Reset subkategori
             */

            subkategori.innerHTML =
                '<option value="">Pilih Sub Kategori</option>';


            subkategori.disabled = true;


            if (!selected) {
                return;
            }


            /*
             * Cari kategori berdasarkan nama.
             */

            const category =
                categories.find(
                    function (item) {
                        return item.nama === selected;
                    }
                );


            if (
                !category ||
                !Array.isArray(
                    category.subcategories
                )
            ) {
                return;
            }


            /*
             * Masukkan subkategori aktif.
             */

            category.subcategories.forEach(
                function (item) {

                    const option =
                        document.createElement(
                            "option"
                        );

                    option.value =
                        item.nama;

                    option.textContent =
                        item.nama;

                    subkategori.appendChild(
                        option
                    );

                }
            );


            /*
             * Aktifkan dropdown
             * jika tersedia subkategori.
             */

            if (
                category.subcategories.length > 0
            ) {
                subkategori.disabled =
                    false;
            }

        }
    );

})();
</script>