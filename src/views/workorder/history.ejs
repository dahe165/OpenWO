<div class="page-header">
    <h1>Riwayat Work Order</h1>

    <p>
        Daftar Work Order yang telah selesai dan ditutup.
    </p>
</div>


<div class="wo-list">

    <% if (!workorders || workorders.length === 0) { %>

        <div class="empty-state">

            <h3>Belum Ada Riwayat</h3>

            <p>
                Belum ada Work Order yang ditutup.
            </p>

        </div>

    <% } %>


    <% workorders.forEach(wo => { %>

        <div class="wo-card">

            <!-- Header -->
            <div class="wo-card-header">

                <div>

                    <strong class="wo-number">
                        <%= wo.nomor %>
                    </strong>

                    <h3>
                        <%= wo.judul %>
                    </h3>

                </div>


                <div class="wo-status">

                    <% if (wo.eskalasi) { %>

                        <span class="status status-escalated">
                            ⚠ Ditutup • Eskalasi Manager
                        </span>

                    <% } else { %>

                        <span class="status status-closed">
                            ✓ Ditutup
                        </span>

                    <% } %>

                </div>

            </div>


            <!-- Informasi -->
            <div class="wo-info">

                <div>

                    <strong>Pelapor</strong>

                    <span>
                        <%= wo.pelapor || "-" %>
                    </span>

                </div>


                <div>

                    <strong>Kategori</strong>

                    <span>
                        <%= wo.kategori || "-" %>
                    </span>

                </div>


                <div>

                    <strong>Subkategori</strong>

                    <span>
                        <%= wo.subkategori || "-" %>
                    </span>

                </div>


                <div>

                    <strong>Ditutup</strong>

                    <span>
                        <% if (wo.updatedAt) { %>

                            <%= new Date(
                                wo.updatedAt
                            ).toLocaleString(
                                "id-ID",
                                {
                                    day: "2-digit",
                                    month: "short",
                                    year: "numeric",
                                    hour: "2-digit",
                                    minute: "2-digit"
                                }
                            ) %>

                        <% } else { %>

                            -

                        <% } %>
                    </span>

                </div>

            </div>


            <!-- Eskalasi -->
            <% if (wo.eskalasi) { %>

                <div class="wo-escalation-info">

                    <strong>
                        ⚠ Eskalasi
                    </strong>

                    <span>
                        Diteruskan ke
                        <%= wo.eskalasiLevel || "Manager" %>
                    </span>

                </div>

            <% } %>


            <!-- Action -->
            <div class="wo-actions">

                <a
                    href="/workorder/<%= wo.id %>"
                    class="btn-action"
                >
                    Lihat Detail
                </a>

            </div>

        </div>

    <% }) %>

</div>

<style>
/* =========================================================
   WORK ORDER HISTORY
   ========================================================= */

.page-header {
    margin-bottom: 24px;
}

.page-header h1 {
    margin: 0 0 6px;
    font-size: 28px;
    font-weight: 700;
    color: var(--text);
}

.page-header p {
    margin: 0;
    color: #6b7280;
    font-size: 14px;
}

.wo-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
}

/* History card */

.wo-list .wo-card {
    margin: 0;
    padding: 22px;
    border: 1px solid #e5e7eb;
    border-radius: 16px;
    background: var(--card);
    box-shadow: 0 6px 18px rgb(15 23 42 / .05);
    cursor: default;
}

.wo-list .wo-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 24px rgb(15 23 42 / .08);
}

/* Header */

.wo-card-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 20px;
}

.wo-card-header h3 {
    margin: 7px 0 0;
    font-size: 17px;
    font-weight: 700;
    color: var(--text);
}

.wo-card-header .wo-number {
    display: inline-block;
    font-size: 12px;
    color: var(--primary);
    font-weight: 700;
}

/* Status */

.wo-card-header .wo-status {
    flex-shrink: 0;
}

.status {
    display: inline-flex;
    align-items: center;
    padding: 6px 10px;
    border-radius: 999px;
    font-size: 11px;
    font-weight: 700;
    white-space: nowrap;
}

.status-closed {
    color: #15803d;
    background: #ecfdf3;
    border: 1px solid #bbf7d0;
}

.status-escalated {
    color: #b45309;
    background: #fffbeb;
    border: 1px solid #fde68a;
}

/* Information */

.wo-info {
    display: grid;
    grid-template-columns:
        repeat(4, minmax(0, 1fr));

    gap: 12px;
    margin-top: 20px;
    padding-top: 18px;
    border-top: 1px solid #eef0f3;
}

.wo-info > div {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 5px;
}

.wo-info strong {
    font-size: 11px;
    font-weight: 600;
    color: #94a3b8;
}

.wo-info span {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 13px;
    font-weight: 600;
    color: var(--text);
}

/* Escalation */

.wo-escalation-info {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 16px;
    padding: 11px 13px;
    border-radius: 10px;
    background: #fffbeb;
    border: 1px solid #fde68a;
    color: #92400e;
    font-size: 12px;
}

.wo-escalation-info strong {
    font-weight: 700;
}

.wo-escalation-info span {
    color: #a16207;
}

/* Action */

.wo-list .wo-actions {
    display: flex;
    justify-content: flex-end;
    margin-top: 18px;
    padding-top: 16px;
    border-top: 1px solid #eef0f3;
}

.wo-list .wo-actions .btn-action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 38px;
    padding: 0 15px;
    border-radius: 9px;
    background: #f8fafc;
    border: 1px solid #dfe3e8;
    color: #475569;
    text-decoration: none;
    font-size: 12px;
    font-weight: 700;
    transition:
        background .2s ease,
        color .2s ease,
        border-color .2s ease,
        transform .2s ease;
}

.wo-list .wo-actions .btn-action:hover {
    background: var(--primary);
    border-color: var(--primary);
    color: #fff;
    transform: translateX(2px);
}

/* Empty */

.empty-state {
    padding: 50px 25px;
    text-align: center;
    background: var(--card);
    border: 1px dashed #d7dce3;
    border-radius: 16px;
}

.empty-state h3 {
    margin: 0 0 7px;
    font-size: 17px;
    color: var(--text);
}

.empty-state p {
    margin: 0;
    color: #94a3b8;
    font-size: 13px;
}

/* Responsive */

@media (max-width: 800px) {

    .wo-info {
        grid-template-columns:
            repeat(2, minmax(0, 1fr));
    }

}

@media (max-width: 600px) {

    .page-header h1 {
        font-size: 23px;
    }

    .wo-list .wo-card {
        padding: 18px;
        border-radius: 14px;
    }

    .wo-card-header {
        flex-direction: column;
        gap: 12px;
    }

    .wo-card-header h3 {
        font-size: 16px;
    }

    .wo-card-header .wo-status {
        align-self: flex-start;
    }

    .wo-info {
        grid-template-columns: 1fr 1fr;
        gap: 16px 10px;
    }

    .wo-list .wo-actions {
        justify-content: stretch;
    }

    .wo-list .wo-actions .btn-action {
        width: 100%;
    }

}

@media (max-width: 400px) {

    .wo-info {
        grid-template-columns: 1fr;
    }

}
</style>