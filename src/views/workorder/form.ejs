<form action="/workorder" method="POST">

    <% if (canCreateForOther) { %>

        <!-- =====================================
             PELAPOR
             ===================================== -->

        <div class="wo-form-field">

            <label
                for="pelaporId"
                class="form-label"
            >
                Pelapor
            </label>

            <select
                id="pelaporId"
                name="pelaporId"
                class="form-select"
                required
            >

                <option value="">
                    Pilih Pelapor
                </option>

                <% users.forEach(function(user) { %>

                    <option
                        value="<%= user.id %>"
                    >
                        <%= user.nama %>
                        <% if (user.seksi || user.bagian) { %>
                            —
                            <%= user.seksi || "" %>
                            <% if (user.seksi && user.bagian) { %>
                                •
                            <% } %>
                            <%= user.bagian || "" %>
                        <% } %>
                    </option>

                <% }); %>

            </select>

        </div>

    <% } %>


    <!-- =====================================
         JUDUL
         ===================================== -->

    <%- include("../components/form/input", {

        label: "Judul Work Order",

        name: "title",

        placeholder: "Contoh : Internet Kantor Mati"

    }) %>


    <!-- =====================================
         KATEGORI & SUB KATEGORI
         ===================================== -->

    <div class="wo-form-row">

        <!-- KATEGORI -->

        <div class="wo-form-field">

            <label
                for="kategori"
                class="form-label"
            >
                Kategori
            </label>

            <select
                id="kategori"
                name="kategori"
                class="form-select"
                required
            >

                <option value="">
                    Pilih Kategori
                </option>

                <% categories.forEach(function(category) { %>

                    <option value="<%= category.nama %>">
                        <%= category.nama %>
                    </option>

                <% }); %>

            </select>

        </div>


        <!-- SUB KATEGORI -->

        <div class="wo-form-field">

            <label
                for="subkategori"
                class="form-label"
            >
                Sub Kategori
            </label>

            <select
                id="subkategori"
                name="subkategori"
                class="form-select"
                required
                disabled
            >

                <option value="">
                    Pilih Sub Kategori
                </option>

            </select>

        </div>

    </div>

        <!-- =====================================
         PRIORITAS
         ===================================== -->

    <div class="wo-form-field">

        <label
            for="prioritas"
            class="form-label"
        >
            Prioritas
        </label>

        <select
            id="prioritas"
            name="prioritas"
            class="form-select"
            required
        >

            <option value="">
                Pilih Prioritas
            </option>

            <% priorities.forEach(function(priority) { %>

                <option
                    value="<%= priority.nama %>"
                >
                    <%= priority.nama %>
                </option>

            <% }); %>

        </select>

    </div>

    <!-- =====================================
         DESKRIPSI
         ===================================== -->

    <%- include("../components/form/textarea", {

        label: "Deskripsi",

        name: "description",

        placeholder: "Jelaskan permasalahan..."

    }) %>


    <!-- =====================================
         SUBMIT
         ===================================== -->

    <%- include("../components/button/primary", {

        text: "Simpan Work Order"

    }) %>

</form>