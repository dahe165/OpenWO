<div class="container py-4">    

        <div class="mb-4">

        <h1 class="page-title">
            Work Order Saya
        </h1>

        <p class="page-subtitle">
            Pantau dan kerjakan Work Order yang ditugaskan kepada Anda.
        </p>

        </div>

        <div class="search-box">

        <input
            id="searchInput"
            type="text"
            placeholder="🔍 Cari nomor WO atau judul..."
        >

        </div>

        <div class="filter-group">

        <button class="filter-btn active" data-filter="Semua">Semua</button>
        <button class="filter-btn" data-filter="Menunggu">Menunggu</button>
        <button class="filter-btn" data-filter="Ditugaskan">Ditugaskan</button>
        <button class="filter-btn" data-filter="Diproses">Diproses</button>
        <button class="filter-btn" data-filter="Selesai">Selesai</button>

        </div>
    <div id="workorder-content">
        <% workorders.forEach((wo) => { %>

            <div class="wo-card <%= wo.id === activeId ? 'wo-detail' : 'wo-summary' %>" data-id="<%= wo.id %>" data-search="<%= (wo.nomor + ' ' + wo.judul).toLowerCase() %>" data-status="<%= wo.status %>">

            <div class="wo-title">
                <%= wo.judul %>
            </div>

            <div class="wo-number">
                <%= wo.nomor %>
            </div>

                <% if (wo.id === activeId) { %>

                    <%
                        const timelineEvents = wo.timeline || [];

                        const mainStages = [
                            "Dibuat",
                            "Diterima",
                            "Ditugaskan",
                            "Dikerjakan",
                            "Selesai"
                        ];

                        const verificationStages = [
                            "Verifikasi Asman",
                            "Menunggu Verifikasi Manager",
                            "Verifikasi Manager",
                            "Ditutup"
                        ];

                        function getEvent(stage) {
                            return timelineEvents.find(
                                event => event.status === stage
                            );
                        }

                        function getStepClass(stage) {

                            const event = getEvent(stage);

                            if (!event) {
                                return "pending";
                            }

                            const lastEvent =
                                timelineEvents[timelineEvents.length - 1];

                            if (event === lastEvent) {
                                return "active";
                            }

                            return "done";
                        }
                    %>


                    <!-- ================================= -->
                    <!-- TIMELINE PEKERJAAN -->
                    <!-- ================================= -->

                    <div class="wo-timeline-section">

                        <div class="timeline-heading">
                            <span class="timeline-heading-icon">⚙️</span>
                            <span>Proses Pekerjaan</span>
                        </div>


                        <div class="timeline-main">

                            <% mainStages.forEach((stage) => {

                                const event = getEvent(stage);
                                const stepClass = getStepClass(stage);

                            %>

                                <div class="timeline-main-step <%= stepClass %>">

                                    <div class="timeline-step-label">
                                        <%= stage %>
                                    </div>

                                    <div class="timeline-dot">

                                        <% if (stepClass === "done") { %>
                                            ✓
                                        <% } else if (stepClass === "active") { %>
                                            ●
                                        <% } %>

                                    </div>

                                    <% if (event) { %>

                                        <div class="timeline-info">

                                            <strong>
                                                <%= event.user %>
                                            </strong>

                                            <small>
                                                <%= event.role %>
                                            </small>

                                            <small>
                                                <%= new Date(
                                                    event.tanggal
                                                ).toLocaleString(
                                                    "id-ID",
                                                    {
                                                        day: "2-digit",
                                                        month: "short",
                                                        year: "numeric",
                                                        hour: "2-digit",
                                                        minute: "2-digit"
                                                    }
                                                ) %>
                                            </small>

                                        </div>

                                    <% } %>

                                </div>

                            <% }) %>

                        </div>


                        <!-- ================================= -->
                        <!-- VERIFIKASI -->
                        <!-- ================================= -->

                        <div class="verification-flow">

                            <div class="verification-line"></div>

                            <div class="verification-header">

                                <span class="verification-icon">
                                    ✓
                                </span>

                                <div>

                                    <strong>
                                        Tahap Verifikasi
                                    </strong>

                                    <small>
                                        Pemeriksaan dan persetujuan penyelesaian WO
                                    </small>

                                </div>

                            </div>


                            <div class="verification-steps">

                                <% verificationStages.forEach((stage) => {

                                    const event = getEvent(stage);
                                    const stepClass = getStepClass(stage);

                                %>

                                    <div class="verification-step <%= stepClass %>">

                                        <div class="verification-dot">

                                            <% if (stepClass === "done") { %>
                                                ✓
                                            <% } else if (stepClass === "active") { %>
                                                ●
                                            <% } %>

                                        </div>


                                        <div class="verification-content">

                                            <strong>
                                                <%= stage %>
                                            </strong>


                                            <% if (event) { %>

                                                <div class="verification-user">

                                                    <span>
                                                        <%= event.user %>
                                                    </span>

                                                    <span>
                                                        <%= event.role %>
                                                    </span>

                                                </div>


                                                <small>

                                                    <%= new Date(
                                                        event.tanggal
                                                    ).toLocaleString(
                                                        "id-ID",
                                                        {
                                                            day: "2-digit",
                                                            month: "short",
                                                            year: "numeric",
                                                            hour: "2-digit",
                                                            minute: "2-digit"
                                                        }
                                                    ) %>

                                                </small>

                                            <% } else { %>

                                                <small>
                                                    Menunggu proses berikutnya
                                                </small>

                                            <% } %>

                                        </div>

                                    </div>

                                <% }) %>

                            </div>

                        </div>

                    </div>

                <% } else { %>

                    <div class="wo-footer">

                        <div>
                            Status :
                            <strong><%= wo.status %></strong>
                        </div>

                        <div>
                            <%= wo.update %>
                        </div>

                    </div>

                    <a
                        href="/workorder?id=<%= wo.id %>"
                        class="btn-open"
                        data-id="<%= wo.id %>"
                    >
                        Lihat Detail →
                    </a>

                <% } %>

                <!-- AKSI WO -->

                <div class="wo-actions">

                    <% if (wo.status === "Ditugaskan") { %>

                        <form
                            method="POST"
                            action="/workorder/<%= wo.id %>/start"
                        >
                            <button
                                type="submit"
                                class="btn-action btn-start"
                            >
                                ▶ Mulai Kerjakan
                            </button>
                        </form>

                    <% } %>


                    <% if (wo.status === "Diproses") { %>

                        <form
                            method="POST"
                            action="/workorder/<%= wo.id %>/complete"
                        >
                            <button
                                type="submit"
                                class="btn-action btn-complete"
                            >
                                ✓ Selesaikan
                            </button>
                        </form>

                    <% } %>


                    <% if (
                        wo.status === "Selesai" &&
                        role === "asman"
                    ) { %>

                        <form
                            method="POST"
                            action="/workorder/<%= wo.id %>/verify"
                        >
                            <button
                                type="submit"
                                class="btn-action btn-verify"
                            >
                                ✓ Verifikasi WO
                            </button>
                        </form>

                    <% } %>

                    <% if (
                        role === "manager" &&
                        wo.status === "Menunggu Verifikasi Manager"
                    ) { %>

                        <div class="wo-actions">

                            <form
                                method="POST"
                                action="/workorder/<%= wo.id %>/verify-manager"
                            >

                                <button
                                    type="submit"
                                    class="btn-action btn-verify"
                                >
                                    ✓ Verifikasi Manager
                                </button>

                            </form>

                        </div>

                    <% } %>

                </div>

                <!-- FOOTER UNTUK DETAIL -->

                <% if (wo.id === activeId) { %>

                    <div class="wo-footer">

                        <div>
                            👨 <%= wo.pelapor %>
                        </div>

                        <div>
                            <%= wo.update %>
                        </div>

                    </div>

                <% } %>

            </div>

        <% }) %>
    </div>
</div>