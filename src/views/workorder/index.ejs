<div class="container py-4">    

        <div class="mb-4">

        <h1 class="page-title">
            Work Order Saya
        </h1>

        <p class="page-subtitle">
            Pantau dan kerjakan Work Order yang ditugaskan kepada Anda.
        </p>

        </div>

        <div class="search-box">

        <input
            id="searchInput"
            type="text"
            placeholder="🔍 Cari nomor WO atau judul..."
        >

        </div>

        <div class="filter-group">

        <button class="filter-btn active" data-filter="Semua">Semua</button>
        <button class="filter-btn" data-filter="Menunggu">Menunggu</button>
        <button class="filter-btn" data-filter="Ditugaskan">Ditugaskan</button>
        <button class="filter-btn" data-filter="Diproses">Diproses</button>
        <button class="filter-btn" data-filter="Selesai">Selesai</button>

        </div>
    <div id="workorder-content">
        <% workorders.forEach((wo) => { %>

            <div class="wo-card <%= wo.id === activeId ? 'wo-detail' : 'wo-summary' %>" data-id="<%= wo.id %>" data-search="<%= (wo.nomor + ' ' + wo.judul).toLowerCase() %>" data-status="<%= wo.status %>">

            <div class="wo-title">
                <%= wo.judul %>
            </div>

            <div class="wo-number">
                <%= wo.nomor %>
            </div>

                <% if (wo.id === activeId) { %>

                <%
                    const workflowStages = [
                        "Dibuat",
                        "Diterima",
                        "Ditugaskan",
                        "Dikerjakan",
                        "Selesai",
                        "Verifikasi Asman",
                        "Menunggu Verifikasi Manager",
                        "Verifikasi Manager",
                        "Ditutup"
                    ];

                    const timelineEvents = wo.timeline || [];

                    const lastEventIndex = timelineEvents.length - 1;
                %>

                <%
                    const completedStages = timelineEvents.filter(
                        event => workflowStages.includes(event.status)
                    ).length;

                    const progressPercent =
                        completedStages > 1
                            ? ((completedStages - 1) / (workflowStages.length - 1)) * 100
                            : 0;
                %>

                <div class="timeline" style="--timeline-progress: <%= progressPercent %>%">

                    <% workflowStages.forEach((stage, stageIndex) => {

                        const eventIndex = timelineEvents.findIndex(
                            event => event.status === stage
                        );

                        const event = eventIndex !== -1
                            ? timelineEvents[eventIndex]
                            : null;

                        let stepClass = "pending";

                        if (event) {

                            if (eventIndex === lastEventIndex) {
                                stepClass = "active";
                            } else {
                                stepClass = "done";
                            }

                        }

                    %>

                        <div class="step <%= stepClass %>">

                            <span>
                                <%= stage %>
                            </span>

                            <div class="dot">

                                <% if (event && stepClass === "done") { %>
                                    ✓
                                <% } %>

                            </div>

                            <% if (event) { %>

                                <div class="timeline-info">

                                    <strong>
                                        <%= event.user %>
                                    </strong>

                                    <small>
                                        <%= event.role %>
                                    </small>

                                    <small>
                                        <%= new Date(event.tanggal).toLocaleString(
                                            "id-ID",
                                            {
                                                day: "2-digit",
                                                month: "short",
                                                year: "numeric",
                                                hour: "2-digit",
                                                minute: "2-digit"
                                            }
                                        ) %>
                                    </small>

                                </div>

                            <% } %>

                        </div>

                    <% }) %>

                </div>

                <% } else { %>

                    <div class="wo-footer">

                        <div>
                            Status :
                            <strong><%= wo.status %></strong>
                        </div>

                        <div>
                            <%= wo.update %>
                        </div>

                    </div>

                    <a
                        href="/workorder?id=<%= wo.id %>"
                        class="btn-open"
                        data-id="<%= wo.id %>"
                    >
                        Lihat Detail →
                    </a>

                <% } %>

                <!-- AKSI WO -->

                <div class="wo-actions">

                    <% if (wo.status === "Ditugaskan") { %>

                        <form
                            method="POST"
                            action="/workorder/<%= wo.id %>/start"
                        >
                            <button
                                type="submit"
                                class="btn-action btn-start"
                            >
                                ▶ Mulai Kerjakan
                            </button>
                        </form>

                    <% } %>


                    <% if (wo.status === "Diproses") { %>

                        <form
                            method="POST"
                            action="/workorder/<%= wo.id %>/complete"
                        >
                            <button
                                type="submit"
                                class="btn-action btn-complete"
                            >
                                ✓ Selesaikan
                            </button>
                        </form>

                    <% } %>


                    <% if (
                        wo.status === "Selesai" &&
                        role === "asman"
                    ) { %>

                        <form
                            method="POST"
                            action="/workorder/<%= wo.id %>/verify"
                        >
                            <button
                                type="submit"
                                class="btn-action btn-verify"
                            >
                                ✓ Verifikasi WO
                            </button>
                        </form>

                    <% } %>

                    <% if (
                        role === "manager" &&
                        wo.status === "Menunggu Verifikasi Manager"
                    ) { %>

                        <div class="wo-actions">

                            <form
                                method="POST"
                                action="/workorder/<%= wo.id %>/verify-manager"
                            >

                                <button
                                    type="submit"
                                    class="btn-action btn-verify"
                                >
                                    ✓ Verifikasi Manager
                                </button>

                            </form>

                        </div>

                    <% } %>

                </div>

                <!-- FOOTER UNTUK DETAIL -->

                <% if (wo.id === activeId) { %>

                    <div class="wo-footer">

                        <div>
                            👨 <%= wo.pelapor %>
                        </div>

                        <div>
                            <%= wo.update %>
                        </div>

                    </div>

                <% } %>

            </div>

        <% }) %>
    </div>
</div>