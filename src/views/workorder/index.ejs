<style>
.wo-header-main {
    display: flex;
    align-items: center;
    gap: 10px;
    flex: 1;
    min-width: 0;
}

.wo-header-icon {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    min-width: 34px;
    height: 34px;
    margin-top: 2px;
    font-size: 24px;
    line-height: 1;
}

.wo-header-main .wo-title-area {
    flex: 1;
    min-width: 0;
}

@media (max-width: 600px) {
    .wo-header-main { gap: 8px; }
    .wo-header-icon {
        width: 30px; min-width: 30px; height: 30px; font-size: 21px;
    }
}
</style>

<div class="container py-4">    

        <div class="mb-4">

        <h1 class="page-title">
            Work Order Saya
        </h1>

        <p class="page-subtitle">
            Pantau dan kerjakan Work Order yang ditugaskan kepada Anda.
        </p>

        </div>

        <%- include("../components/button/floating", {
            href: "/workorder/create",
            icon: "＋",
            text: "Buat Work Order",
            label: "Buat Work Order"
        }) %>

        <div class="search-box">

        <input
            id="searchInput"
            type="text"
            placeholder="🔍 Cari nomor WO atau judul..."
        >

        </div>

        <div class="filter-group">

            <button
                class="filter-btn <%= status === 'Semua' ? 'active' : '' %>"
                data-filter="Semua"
            >
                Semua
            </button>

            <button
                class="filter-btn <%= status === 'Menunggu' ? 'active' : '' %>"
                data-filter="Menunggu"
            >
                Menunggu
            </button>

            <button
                class="filter-btn <%= status === 'Diterima' ? 'active' : '' %>"
                data-filter="Diterima"
            >
                Diterima
            </button>

            <button
                class="filter-btn <%= status === 'Ditugaskan' ? 'active' : '' %>"
                data-filter="Ditugaskan"
            >
                Ditugaskan
            </button>

            <button
                class="filter-btn <%= status === 'Diproses' ? 'active' : '' %>"
                data-filter="Diproses"
            >
                Diproses
            </button>

            <button
                class="filter-btn <%= status === 'Waiting' ? 'active' : '' %>"
                data-filter="Waiting"
            >
                Waiting
            </button>

            <button
                class="filter-btn <%= status === 'Selesai' ? 'active' : '' %>"
                data-filter="Selesai"
            >
                Selesai
            </button>

        </div>

        <div id="wo-result-info" class="wo-result-info">

            <% if (pagination.totalItems > 0) { %>

                Menampilkan
                <strong>
                    <%= pagination.from %>–<%= pagination.to %>
                </strong>
                dari
                <strong>
                    <%= pagination.totalItems %>
                </strong>
                Work Order

            <% } else { %>

                Tidak ada Work Order ditemukan

            <% } %>

        </div>

    <div id="workorder-list">

        <div id="workorder-content">

        <% workorders.forEach((wo) => { %>

            <div class="wo-card <%= wo.id === activeId ? 'wo-detail' : 'wo-summary' %>" data-id="<%= wo.id %>" data-search="<%= (wo.nomor + ' ' + wo.judul).toLowerCase() %>" data-status="<%= wo.status %>">

            <div class="wo-header">

                <div class="wo-header-main">

                    <span class="wo-header-icon">
                        <%
                        let woIcon = "🛠️";

                        if (wo.kategori === "Incident") {
                            woIcon = "⚠️";
                        }

                        if (
                            wo.judul.toLowerCase().includes("internet") ||
                            wo.judul.toLowerCase().includes("wifi")
                        ) {
                            woIcon = "🌐";
                        }

                        if (
                            wo.judul.toLowerCase().includes("lan") ||
                            wo.judul.toLowerCase().includes("jaringan")
                        ) {
                            woIcon = "🛜";
                        }

                        if (
                            wo.judul.toLowerCase().includes("komputer") ||
                            wo.judul.toLowerCase().includes("pc")
                        ) {
                            woIcon = "🖥️";
                        }

                        if (
                            wo.judul.toLowerCase().includes("printer")
                        ) {
                            woIcon = "🖨️";
                        }
                        %>
                        <%= woIcon %>
                    </span>

                    <div class="wo-title-area">

                        <div class="wo-title">

                            <span>
                                <%= wo.judul %>
                            </span>

                            <% if (wo.id !== activeId && wo.prioritas) { %>

                                <% const priorityColor = (priorityColors && priorityColors[wo.prioritas]) || "#64748b"; %>

                                <span
                                    class="wo-priority"
                                    style="--priority-color:<%= priorityColor %>;"
                                >
                                    <span class="wo-priority-dot"></span>
                                    <%= wo.prioritas %>
                                </span>

                            <% } %>

                        </div>

                        <div class="wo-meta">

                            <span class="wo-number">
                                <%= wo.nomor %>
                            </span>

                            <span class="wo-meta-separator">
                                |
                            </span>

                            <span class="wo-category">
                                <%= wo.kategori %>
                            </span>

                            <span class="wo-meta-separator">
                                |
                            </span>

                            <span class="wo-created">
                                <%= new Date(
                                    wo.createdAt
                                ).toLocaleString(
                                    "id-ID",
                                    {
                                        day: "2-digit",
                                        month: "short",
                                        year: "numeric",
                                        hour: "2-digit",
                                        minute: "2-digit"
                                    }
                                ) %>
                            </span>

                        </div>

                    </div>

                </div>


                <%
                    let displayStatus =
                        wo.status;

                    if (
                        wo.status === "Diproses"
                    ) {
                        displayStatus =
                            "Sedang Dikerjakan";
                    }
                %>


                <div class="wo-current-status">

                    <span class="status-dot"></span>

                    <span>
                        <%= displayStatus %>
                    </span>

                </div>

            </div>

                    <% if (
                        wo.id === activeId &&
                        timelineDisplayMode !== "compact" &&
                        Number(wo.createdBy) !== Number(wo.pelaporId)
                    ) { %>

                        <div class="wo-person timeline-reporter">

                            <span class="wo-person-label">
                                Pelapor:
                            </span>

                            <strong>
                                <%= wo.pelapor || "-" %>
                            </strong>

                            <% if (
                                wo.pelaporSection ||
                                wo.pelaporDepartment
                            ) { %>                            

                                <small class="wo-person-org">

                                    <% if (wo.pelaporSection) { %>
                                        <%= wo.pelaporSection %>
                                    <% } %>

                                    <% if (
                                        wo.pelaporSection &&
                                        wo.pelaporDepartment
                                    ) { %>

                                        <span class="wo-org-separator">
                                            •
                                        </span>

                                    <% } %>

                                    <% if (wo.pelaporDepartment) { %>
                                        <%= wo.pelaporDepartment %>
                                    <% } %>

                                </small>

                            <% } %>

                        </div>

                    <% } %>

            <!------>

                <% if (wo.id === activeId) { %>

                    <%
                        const timelineEvents = wo.timeline || [];

                        const mainStages = [
                            "Dibuat",
                            "Diterima",
                            "Ditugaskan",
                            "Dikerjakan",
                            "Selesai"
                        ];

                        const verificationStages = [];

                        if (workflow?.closing && workflow?.verification) {
                            verificationStages.push("Verifikasi Asman");

                            if (workflow?.escalation) {
                                verificationStages.push(
                                    "Menunggu Verifikasi Manager",
                                    "Verifikasi Manager"
                                );
                            }

                            verificationStages.push("Ditutup");
                        } else if (workflow?.closing && !workflow?.verification) {
                            verificationStages.push("Ditutup");
                        }

                        function getEvent(stage) {
                            return timelineEvents.find(
                                event => event.status === stage
                            );
                        }

                        function getStepClass(stage) {

                            const event = getEvent(stage);

                            if (!event) {
                                return "pending";
                            }

                            const lastEvent =
                                timelineEvents[timelineEvents.length - 1];

                            if (event === lastEvent) {
                                return "active";
                            }

                            return "done";
                        }
                    %>

                    <!-- ================================= -->
                    <!-- TIMELINE PEKERJAAN -->
                    <!-- ================================= -->
                    
                    <div class="wo-timeline-section">

                        <% if (timelineDisplayMode === "compact") { %>
                            <div class="timeline-context-group">
                                <div class="timeline-context timeline-reporter-context">
                                    <span class="timeline-context-label">Pelapor</span>
                                    <strong><%= wo.pelapor || "-" %></strong>
                                    <% if (wo.pelaporSection || wo.pelaporDepartment) { %>
                                        <span class="timeline-context-org">
                                            <% if (wo.pelaporSection) { %><%= wo.pelaporSection %><% } %>
                                            <% if (wo.pelaporSection && wo.pelaporDepartment) { %>
                                                <span class="timeline-context-separator">•</span>
                                            <% } %>
                                            <% if (wo.pelaporDepartment) { %><%= wo.pelaporDepartment %><% } %>
                                        </span>
                                    <% } %>
                                </div>

                                <% if (wo.targetSection || wo.targetDepartment) { %>
                                    <div class="timeline-context timeline-target-context">
                                        <span class="timeline-context-label">Tujuan WO</span>
                                        <strong>
                                            <%= wo.targetSection || "-" %>
                                            <% if (wo.targetDepartment) { %>
                                                <span class="timeline-context-separator">•</span>
                                                <%= wo.targetDepartment %>
                                            <% } %>
                                        </strong>
                                    </div>
                                <% } %>
                            </div>
                        <% } %>

                        <div class="timeline-heading">
                            <span class="timeline-heading-icon">📌</span>
                            <span>Timeline</span>
                        </div>

                        <div class="timeline-main timeline-main-<%= timelineDisplayMode %>">

                            <% mainStages.forEach((stage) => {

                                const event = getEvent(stage);
                                const stepClass = getStepClass(stage);

                            %>

                                <div class="timeline-main-step <%= stepClass %> timeline-mode-<%= timelineDisplayMode %>" style="--timeline-stage-color: <%= timelineProgressColors?.[stage] || '#64748b' %>;">

                                    <div class="timeline-dot">

                                        <% if (stepClass === "done") { %>
                                            ✓
                                        <% } else if (stepClass === "active") { %>
                                            ●
                                        <% } %>

                                    </div>

                                    <div class="timeline-step-label">
                                        <%= stage %>
                                    </div>

                                    <% if (event) { %>

                                        <div class="timeline-info">

                                            <% if (timelineDisplayMode === "compact") { %>

                                                <small class="timeline-date">
                                                    <%= new Date(event.tanggal).toLocaleDateString(
                                                        "id-ID",
                                                        { day: "2-digit", month: "short", year: "numeric" }
                                                    ) %>
                                                </small>

                                                <small class="timeline-time">
                                                    <%= new Date(event.tanggal).toLocaleTimeString(
                                                        "id-ID",
                                                        { hour: "2-digit", minute: "2-digit", hour12: false }
                                                    ) %>
                                                </small>

                                                <div class="timeline-person-block">
                                                    <strong><%= event.user %></strong>
                                                    <small><%= event.role %></small>
                                                </div>

                                            <% } else { %>

                                                <strong>
                                                    <%= event.user %>
                                                </strong>

                                                <small>
                                                    <%= event.role %>
                                                </small>

                                                <% if (event.section_nama || event.department_nama) { %>
                                                    <small class="timeline-org">
                                                        <% if (event.section_nama) { %>
                                                            <%= event.section_nama %>
                                                        <% } %>
                                                        <% if (event.section_nama && event.department_nama) { %>
                                                            <span class="timeline-org-separator">•</span>
                                                        <% } %>
                                                        <% if (event.department_nama) { %>
                                                            <%= event.department_nama %>
                                                        <% } %>
                                                    </small>
                                                <% } %>

                                                <small class="timeline-date">
                                                    <%= new Date(event.tanggal).toLocaleDateString(
                                                        "id-ID",
                                                        { day: "2-digit", month: "short", year: "numeric" }
                                                    ) %>
                                                </small>

                                                <small class="timeline-time">
                                                    <%= new Date(event.tanggal).toLocaleTimeString(
                                                        "id-ID",
                                                        { hour: "2-digit", minute: "2-digit", hour12: false }
                                                    ) %>
                                                </small>

                                            <% } %>

                                        </div>

                                    <% } %>

                                </div>

                                <% if (
                                    stage === "Dikerjakan" &&
                                    wo.status === "Waiting"
                                ) { %>

                                    <form
                                        method="POST"
                                        action="/workorder/<%= wo.id %>/resume-waiting"
                                        class="timeline-waiting-form"
                                    >

                                        <button
                                            type="submit"
                                            class="timeline-waiting-button"
                                            title="Lanjutkan Pekerjaan"
                                            aria-label="Lanjutkan Pekerjaan"
                                        >
                                            ⏸
                                        </button>

                                    </form>

                                <% } %>

                            <% }) %>

                        </div>


                        <!-- ================================= -->
                        <!-- VERIFIKASI -->
                        <!-- ================================= -->

                        <% if (workflow?.closing) { %>
                        <div class="verification-flow">

                            <div class="verification-line"></div>

                            <div class="verification-header">

                                <span class="verification-icon">
                                    ✓
                                </span>

                                <div>

                                    <strong>
                                        Tahap Verifikasi
                                    </strong>

                                    <small>
                                        Pemeriksaan dan persetujuan penyelesaian WO
                                    </small>

                                </div>

                            </div>


                            <div class="verification-steps">

                                <% verificationStages.forEach((stage) => {

                                    const event = getEvent(stage);
                                    const stepClass = getStepClass(stage);

                                %>

                                    <div class="verification-step <%= stepClass %>">

                                        <div class="verification-dot">

                                            <% if (stepClass === "done") { %>
                                                ✓
                                            <% } else if (stepClass === "active") { %>
                                                ●
                                            <% } %>

                                        </div>


                                        <div class="verification-content">

                                            <strong>
                                                <%= stage %>
                                            </strong>


                                            <% if (event) { %>

                                                <div class="verification-user">

                                                    <span>
                                                        <%= event.user %>
                                                    </span>

                                                    <span>
                                                        <%= event.role %>
                                                    </span>

                                                </div>


                                                <small class="verification-date">
                                                    <%= new Date(event.tanggal).toLocaleDateString(
                                                        "id-ID",
                                                        { day: "2-digit", month: "short", year: "numeric" }
                                                    ) %>
                                                </small>

                                                <small class="verification-time">
                                                    <%= new Date(event.tanggal).toLocaleTimeString(
                                                        "id-ID",
                                                        { hour: "2-digit", minute: "2-digit", hour12: false }
                                                    ) %>
                                                </small>

                                            <% } else { %>

                                                <small>
                                                    Menunggu proses berikutnya
                                                </small>

                                            <% } %>

                                        </div>

                                    </div>

                                <% }) %>

                            </div>

                        </div>
                        <% } %>

                    </div>                    

                <% } else { %>

                    <div class="wo-footer">

                    <!--- <div>
                            Status :
                            <strong><%= wo.status %></strong>
                        </div>
                        <div>
                            <%= wo.update %>
                        </div> --->

                    </div>
                    
                <% } %>

                <!-- INFORMASI WO Tambahkan Pelapor & Teknisi -->

                <% if (wo.id === activeId) { %>
                    
                    <% if (wo.status === "Selesai") { %>

                    <!-- ================================= -->
                    <!-- HASIL PENYELESAIAN -->
                    <!-- ================================= -->

                    <div class="completion-result">

                        <div class="completion-result-main">

                            <span class="completion-result-icon">
                                📝
                            </span>

                            <div class="completion-result-content">

                                <div class="completion-result-header">

                                    <strong>
                                        Hasil Penyelesaian
                                    </strong>

                                    <small>
                                        Laporan pekerjaan teknisi
                                    </small>

                                </div>

                                <div class="completion-result-description">

                                    <% if (wo.resolutionDescription) { %>

                                        <span>
                                            <%= wo.resolutionDescription %>
                                        </span>

                                    <% } else { %>

                                        <span class="result-empty">
                                            Belum ada laporan penyelesaian.
                                        </span>

                                    <% } %>

                                </div>

                            </div>

                        </div>

                        <% if (wo.completionPhoto) { %>

                            <div class="completion-result-photo-wrap">

                                <img
                                    src="<%= wo.completionPhoto %>"
                                    alt="Bukti pekerjaan"
                                    class="completion-photo-thumb"
                                >

                            </div>

                        <% } %>

                    </div>

                    <% } %>

                <% } else { %>

                    <!-- ================================= -->
                    <!-- INFORMASI RINGKASAN WO -->
                    <!-- ================================= -->

                    <div class="wo-assignment-info">

                    <!-- ============================= -->
                    <!-- PELAPOR -->
                    <!-- ============================= -->

                    <div class="wo-person">

                        <span class="wo-person-label">
                            Pelapor:
                        </span>

                        <strong>
                            <%= wo.pelapor || "-" %>
                        </strong>


                        <% if (
                            wo.pelaporSection ||
                            wo.pelaporDepartment
                        ) { %>

                            <small class="wo-person-org">

                                <% if (wo.pelaporSection) { %>

                                    <%= wo.pelaporSection %>

                                <% } %>


                                <% if (
                                    wo.pelaporSection &&
                                    wo.pelaporDepartment
                                ) { %>

                                    <span class="wo-org-separator">
                                        •
                                    </span>

                                <% } %>


                                <% if (wo.pelaporDepartment) { %>

                                    <%= wo.pelaporDepartment %>

                                <% } %>

                            </small>

                        <% } %>

                    </div>


                    <!-- ============================= -->
                    <!-- TEKNISI -->
                    <!-- ============================= -->

                    <div class="wo-person">

                        <span class="wo-person-label">
                            Teknisi:
                        </span>

                        <strong>
                            <%= wo.teknisi || "Belum ditugaskan" %>
                        </strong>


                        <% if (
                            wo.teknisiSection ||
                            wo.teknisiDepartment
                        ) { %>

                            <small class="wo-person-org">

                                <% if (wo.teknisiSection) { %>

                                    <%= wo.teknisiSection %>

                                <% } %>


                                <% if (
                                    wo.teknisiSection &&
                                    wo.teknisiDepartment
                                ) { %>

                                    <span class="wo-org-separator">
                                        •
                                    </span>

                                <% } %>


                                <% if (wo.teknisiDepartment) { %>

                                    <%= wo.teknisiDepartment %>

                                <% } %>

                            </small>

                        <% } %>

                    </div>

                </div>

                <% } %>                    

                <!-- AKSI WO -->

                <div class="wo-actions">                    
                    
                    <% if (
                        role === "asman" &&
                        wo.status === "Diterima"
                    ) { %>

                        <form
                            method="POST"
                            action="/workorder/<%= wo.id %>/assign"
                            class="assign-form"
                        >

                            <select
                                name="technicianId"
                                class="technician-select"
                                required
                            >

                                <option value="">
                                    Pilih Teknisi
                                </option>

                                <% technicians.forEach(technician => { %>

                                    <option
                                        value="<%= technician.id %>"
                                    >
                                        <%= technician.nama %>
                                    </option>

                                <% }) %>

                            </select>

                            <button
                                type="submit"
                                class="btn-action btn-assign"
                            >
                                ✓ Tugaskan Teknisi
                            </button>

                        </form>

                    <% } %>
                    
                    <!------>

                    <% if (
                        role === "asman" &&
                        wo.status === "Menunggu"
                    ) { %>

                        <form
                            method="POST"
                            action="/workorder/<%= wo.id %>/accept">

                            <button
                                type="submit"
                                class="btn-action btn-accept">

                                ✓ Terima WO
                            </button>
                        </form>

                    <% } %>

                    <% if (
                        role === "teknisi" &&
                        Number(wo.teknisiId) === Number(currentUserId) &&
                        wo.status === "Ditugaskan"
                    ) { %>

                        <form
                            method="POST"
                            action="/workorder/<%= wo.id %>/start">

                            <button
                                type="submit"
                                class="btn-action btn-start">

                                ▶ Mulai Kerjakan
                            </button>
                        </form>

                    <% } %>


                    <% if (
                        role === "teknisi" &&
                        Number(wo.teknisiId) === Number(currentUserId) &&
                        wo.status === "Diproses"
                    ) { %>

                        <% if (
                            wo.id === activeId &&
                            completeMode
                        ) { %>

                            <form
                                id="completion-form-<%= wo.id %>"
                                method="POST"
                                action="/workorder/<%= wo.id %>/complete"
                                class="completion-form"
                                enctype="multipart/form-data"
                            >

                                <div class="completion-header">

                                    <span class="completion-icon">
                                        📝
                                    </span>

                                    <div>

                                        <strong>
                                            Penyelesaian Pekerjaan
                                        </strong>

                                        <small>
                                            Lengkapi hasil pekerjaan sebelum menyelesaikan Work Order.
                                        </small>

                                    </div>

                                </div>


                                <div class="completion-field">

                                    <label for="resolution-<%= wo.id %>">
                                        Deskripsi Penyelesaian
                                    </label>

                                    <textarea
                                        id="resolution-<%= wo.id %>"
                                        name="resolutionDescription"
                                        rows="4"
                                        placeholder="Jelaskan pekerjaan yang telah dilakukan..."
                                        required
                                    ></textarea>

                                </div>


                                <div class="completion-field">

                                    <label for="photo-<%= wo.id %>">
                                        📷 Foto Penyelesaian
                                    </label>

                                    <input
                                        type="file"
                                        id="photo-<%= wo.id %>"
                                        name="completionPhoto"
                                        accept="image/png,image/jpeg,image/webp"
                                    >

                                    <small class="field-hint">
                                        Tambahkan foto sebagai bukti penyelesaian.
                                    </small>

                                </div>

                            </form>

                        <% } %>

                        <div class="technician-action-bar">

                            <form
                                method="POST"
                                action="/workorder/<%= wo.id %>/waiting"
                                class="waiting-form"
                            >

                                <button
                                    type="submit"
                                    class="btn-action btn-waiting"
                                >
                                    ⏸ Waiting
                                </button>

                                <select
                                    name="reason"
                                    class="waiting-reason"
                                    required
                                >

                                    <option value="">
                                        Pilih alasan menunggu...
                                    </option>

                                    <option value="Menunggu Barang">
                                        📦 Menunggu Barang
                                    </option>

                                    <option value="Menunggu User">
                                        👤 Menunggu User
                                    </option>

                                    <option value="Menunggu Vendor">
                                        🏢 Menunggu Vendor
                                    </option>

                                    <option value="Menunggu Keputusan">
                                        👔 Menunggu Keputusan
                                    </option>

                                    <option value="Lainnya">
                                        📝 Lainnya
                                    </option>

                                </select>

                            </form>

                            <% if (
                                wo.id === activeId &&
                                completeMode
                            ) { %>

                                <button
                                    type="submit"
                                    form="completion-form-<%= wo.id %>"
                                    class="btn-action btn-complete technician-complete-action"
                                >
                                    ✓ Selesaikan Work Order
                                </button>

                            <% } else { %>

                                <button
                                    type="button"
                                    class="btn-action btn-complete btn-open-completion technician-complete-action"
                                    data-id="<%= wo.id %>"
                                >
                                    ✓ Selesaikan
                                </button>

                            <% } %>

                        </div>

                    <% } %>

                    <% if (
                        role === "teknisi" &&
                        Number(wo.teknisiId) === Number(currentUserId) &&
                        wo.status === "Waiting"
                    ) { %>

                        <form
                            method="POST"
                            action="/workorder/<%= wo.id %>/resume-waiting"
                        >

                            <button
                                type="submit"
                                class="btn-action btn-start"
                            >
                                ▶ Lanjutkan Pekerjaan
                            </button>

                        </form>

                    <% } %>

                    <% if (
                        wo.status === "Selesai" &&
                        role === "asman" &&
                        workflow?.closing &&
                        workflow?.verification
                    ) { %>

                        <div class="asman-verification-action">

                            <div class="asman-action-row">

                                <div class="asman-primary-action">

                                    <form
                                        method="POST"
                                        action="/workorder/<%= wo.id %>/verify"
                                        class="verify-form">

                                        <button
                                            type="submit"
                                            class="btn-action btn-verify">

                                            ✓ Verifikasi WO
                                        </button>
                                    </form>


                                    <% if (workflow?.escalation) { %>
                                    <button
                                        type="submit"
                                        form="<%= 'escalate-' + wo.id %>"
                                        class="btn-action btn-escalate-primary"
                                        style="display:none;">
                                        
                                        ⚠ Eskalasi ke Manager
                                    </button>
                                    <% } %>

                                </div>

                                <% if (workflow?.escalation) { %>
                                <label class="escalation-toggle">

                                    <input
                                        type="checkbox"
                                        class="escalation-toggle-input">

                                    <span class="escalation-toggle-slider"></span>

                                    <span class="escalation-toggle-label">
                                        Eskalasi ke Manager
                                    </span>

                                </label>
                                <% } %>

                            </div>


                            <% if (workflow?.escalation) { %>
                            <form
                                id="<%= 'escalate-' + wo.id %>"
                                method="POST"
                                action="/workorder/<%= wo.id %>/escalate"
                                class="escalate-form">

                                <textarea
                                    name="reason"
                                    class="escalate-reason"
                                    placeholder="Alasan eskalasi ke Manager..."
                                    required
                                ></textarea>
                            </form>
                            <% } %>

                        </div>

                    <% } %>                    

                    <% if (
                        role === "manager" &&
                        wo.status === "Menunggu Verifikasi Manager"
                    ) { %>

                        <div class="wo-actions">

                            <form
                                method="POST"
                                action="/workorder/<%= wo.id %>/verify-manager">

                                <button
                                    type="submit"
                                    class="btn-action btn-verify">

                                    ✓ Verifikasi Manager
                                </button>

                            </form>

                        </div>

                    <% } %>                    

                </div>

                <!-- FOOTER UNTUK DETAIL -->

                <% if (wo.id === activeId) { %>

                    <div class="wo-footer">
                        <!--
                        <div>
                            👨 <%= wo.pelapor %>
                        </div>
                        --->
                    </div>

                <% } %>

            </div>

        <% }) %>

        </div>

        <%
            const totalPages =
                pagination.totalPages;

            const currentPage =
                pagination.page;

            const paginationParams =
                new URLSearchParams();

            if (search) {

                paginationParams.set(
                    "search",
                    search
                );

            }

            if (
                status &&
                status !== "Semua"
            ) {

                paginationParams.set(
                    "status",
                    status
                );

            }


            /*
            * Membuat daftar halaman yang
            * perlu ditampilkan.
            *
            * null = ...
            */

            const pages = [];

            if (totalPages <= 7) {

                for (
                    let i = 1;
                    i <= totalPages;
                    i++
                ) {

                    pages.push(i);

                }

            } else {

                pages.push(1);


                /*
                * Bagian awal
                */

                if (currentPage <= 4) {

                    pages.push(2);
                    pages.push(3);
                    pages.push(4);
                    pages.push(5);

                    pages.push(null);

                }


                /*
                * Bagian tengah
                */

                else if (
                    currentPage >= 5 &&
                    currentPage <= totalPages - 4
                ) {

                    pages.push(null);

                    pages.push(
                        currentPage - 1
                    );

                    pages.push(
                        currentPage
                    );

                    pages.push(
                        currentPage + 1
                    );

                    pages.push(null);

                }


                /*
                * Bagian akhir
                */

                else {

                    pages.push(null);

                    pages.push(
                        totalPages - 4
                    );

                    pages.push(
                        totalPages - 3
                    );

                    pages.push(
                        totalPages - 2
                    );

                    pages.push(
                        totalPages - 1
                    );

                }


                pages.push(totalPages);

            }
        %>


        <% if (pagination && pagination.totalPages > 1) { %>

            <div class="wo-pagination">

                <!-- PREVIOUS -->

                <% if (currentPage > 1) { %>

                    <%
                        paginationParams.set(
                            "page",
                            currentPage - 1
                        );
                    %>

                    <a
                        href="/workorder?<%= paginationParams.toString() %>"
                        class="page-btn page-prev"
                        aria-label="Halaman sebelumnya"
                    >
                        ‹
                    </a>

                <% } %>


                <!-- PAGE NUMBERS -->

                <% pages.forEach(pageNumber => { %>

                    <% if (pageNumber === null) { %>

                        <span
                            class="page-ellipsis"
                        >
                            …
                        </span>

                    <% } else { %>

                        <%
                            paginationParams.set(
                                "page",
                                pageNumber
                            );
                        %>

                        <a
                            href="/workorder?<%= paginationParams.toString() %>"
                            class="page-btn <%= currentPage === pageNumber ? 'active' : '' %>"
                            <%= currentPage === pageNumber
                                ? 'aria-current="page"'
                                : ''
                            %>
                        >
                            <%= pageNumber %>
                        </a>

                    <% } %>

                <% }); %>


                <!-- NEXT -->

                <% if (currentPage < totalPages) { %>

                    <%
                        paginationParams.set(
                            "page",
                            currentPage + 1
                        );
                    %>

                    <a
                        href="/workorder?<%= paginationParams.toString() %>"
                        class="page-btn page-next"
                        aria-label="Halaman berikutnya"
                    >
                        ›
                    </a>

                <% } %>

            </div>

        <% } %>
    </div>
</div>