<!DOCTYPE html>
<html lang="id">
<head>

    <meta charset="UTF-8">

    <title>OpenWO</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css"
        rel="stylesheet">
    <link rel="stylesheet" href="/css/app.css">
    <link rel="stylesheet" href="/css/style.css">
    <style>

        .btn-create-wo {
            margin: 0 5px;
            transition:
                transform 0.18s ease,
                background-color 0.18s ease,
                color 0.18s ease,
                box-shadow 0.18s ease;
        }

        .btn-create-wo:hover {
            transform: scale(1.06);

            background-color: #0d6efd;
            border-color: #0d6efd;

            color: #ffffff;

            box-shadow:
                0 6px 16px
                rgba(13, 110, 253, 0.22);
        }

    </style>

</head>

<body>

<nav class="navbar navbar-expand-lg navbar-dark bg-primary">

    <div class="container-fluid px-3 px-lg-4">

        <a class="navbar-brand fw-bold" href="/">
            OpenWO
        </a>

        <% if (user) { %>

            <%- include("../partials/topbar-user") %>

        <% } else { %>

            <a
                href="/login"
                class="btn btn-light"
            >
                Login
            </a>

        <% } %>

    </div>

</nav>

<section class="hero">
    <div class="container text-center">

    <h1 class="display-4 fw-bold">

        Kelola Work Order IT

    </h1>

    <p class="lead">

        Pantau • Tugaskan • Selesaikan • Realtime

    </p>

    <div class="mt-4">

        <a
            href="/workorder/create"
            class="btn btn-outline-primary btn-lg btn-create-wo"
        >
            Buat Work Order
        </a>

        <a
            href="/dashboard"
            class="btn btn-outline-primary btn-lg btn-create-wo"
        >
            Dashboard
        </a>

    </div>
    </div>
</section>

<section class="container mt-5">

    <div class="row">

        <div class="col-md-4">

            <div class="card feature-card">

                <div class="card-body">

                    <h5>⚡ Realtime</h5>

                    <p>
                        Menggunakan Socket.IO
                    </p>

                </div>

            </div>

        </div>

        <div class="col-md-4">

            <div class="card feature-card">

                <div class="card-body">

                    <h5>📈 SLA Monitoring</h5>

                    <p>
                        Pantau keterlambatan pekerjaan
                    </p>

                </div>

            </div>

        </div>

        <div class="col-md-4">

            <div class="card feature-card">

                <div class="card-body">

                    <h5>🖥 Asset Management</h5>

                    <p>

                        Kelola perangkat IT

                    </p>

                </div>

            </div>

        </div>

    </div>

</section>
<script src="/js/profile-menu.js"></script>
</body>

</html>