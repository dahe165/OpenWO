    <div class="chart-placeholder">

    <div class="chart-bars">

        <% 
            const maxTrend = Math.max(
                ...trend.map(item => item.total),
                1
            );
        %>

        <% trend.forEach(item => { %>

            <div
                class="chart-bar"
                style="height: <%= Math.max(
                    (item.total / maxTrend) * 100,
                    item.total > 0 ? 8 : 3
                ) %>%"
                data-label="<%= item.label %>"
                data-total="<%= item.total %>"
                >

