<% if (role === "pelapor") { %>

    <%- include("../components/welcome-card") %>

    <%- include("../components/quick-action") %>

    <div class="dashboard-kpi">

        <div class="kpi-card">

            <span class="kpi-icon">
                📋
            </span>

            <div>

                <span class="kpi-label">
                    Total WO
                </span>

                <strong>
                    <%= pelaporDashboard.summary.total %>
                </strong>

            </div>

        </div>


        <div class="kpi-card">

            <span class="kpi-icon">
                🟡
            </span>

            <div>

                <span class="kpi-label">
                    Menunggu
                </span>

                <strong>
                    <%= pelaporDashboard.summary.menunggu %>
                </strong>

            </div>

        </div>


        <div class="kpi-card">

            <span class="kpi-icon">
                🔵
            </span>

            <div>

                <span class="kpi-label">
                    Diproses
                </span>

                <strong>
                    <%= pelaporDashboard.summary.diproses %>
                </strong>

            </div>

        </div>


        <div class="kpi-card">

            <span class="kpi-icon">
                🟢
            </span>

            <div>

                <span class="kpi-label">
                    Selesai
                </span>

                <strong>
                    <%= pelaporDashboard.summary.selesai %>
                </strong>

            </div>

        </div>

    </div>


    <div class="dashboard-panel">

        <div class="panel-header">

            <div>

                <h2>🕘 Work Order Terakhir</h2>

                <p>
                    Aktivitas Work Order Anda
                </p>

            </div>

        </div>


        <% if (
            pelaporDashboard.feed.length === 0
        ) { %>

            <div class="technician-feed-empty">

                Belum ada Work Order.

            </div>

        <% } else { %>

            <div class="technician-feed">

                <% pelaporDashboard.feed.forEach(
                    wo => {
                %>

                    <div class="technician-feed-item">

                        <div class="technician-feed-main">

                            <strong>
                                <%= wo.nomor %>
                            </strong>

                            <h3>
                                <%= wo.judul %>
                            </h3>

                            <span>
                                <%= wo.kategori %>

                                <% if (
                                    wo.subkategori
                                ) { %>

                                    •
                                    <%= wo.subkategori %>

                                <% } %>

                            </span>

                        </div>


                        <div class="technician-feed-meta">

                            <span
                                class="wo-status status-<%= wo.status.toLowerCase() %>"
                            >
                                <%= wo.status %>
                            </span>

                        </div>

                    </div>

                <% }); %>

            </div>

        <% } %>

    </div>


    <% } else if (
        role === "asman" ||
        role === "manager"
    ) { %>

<%- include("../components/welcome-card") %>

<%- include("../components/quick-action") %>

<!-- ==========================================
     KPI CARDS
     ASMAN / MANAGER
     ========================================== -->

<div class="dashboard-kpi kpi-dashboard-enhanced">

    <%- include("../components/kpi-card", {
        key: "total",
        label: "Total WO",
        value: summary.total
    }) %>

    <%- include("../components/kpi-card", {
        key: "menunggu",
        label: "Menunggu",
        value: summary.menunggu
    }) %>

    <%- include("../components/kpi-card", {
        key: "diproses",
        label: "Diproses",
        value: summary.diproses
    }) %>

    <%- include("../components/kpi-card", {
        key: "selesai",
        label: "Selesai",
        value: summary.selesai
    }) %>

</div>

<%- include("../components/charts/trend-workorder", {
    trend: trend
}) %>

<!-- ==========================================
     TREND KATEGORI
     ========================================== -->

<%- include("../components/charts/trend-category", {
    categoryTrend: categoryTrend
}) %>


<%- include("../components/charts/status-workorder", {
    summary: summary
}) %>


<%- include("../components/charts/technician-load", {
    technicianLoad
}) %>


<% } else if (role === "admin") { %>

    <%- include("../components/welcome-card") %>

    <%- include("../components/quick-action") %>


    <div class="dashboard-kpi">

        <%- include("../components/kpi-simple", {
        icon: "👥",
        label: "Total Pengguna",
        value: stats.totalUsers
    }) %>

    <%- include("../components/kpi-simple", {
        icon: "👤",
        label: "Pelapor",
        value: stats.pelapor
    }) %>

    <%- include("../components/kpi-simple", {
        icon: "🧑‍🔧",
            label: "Teknisi",
            value: stats.teknisi
        }) %>

        <%- include("../components/kpi-simple", {
            icon: "🧑‍💼",
            label: "Asman",
            value: stats.asman
        }) %>

        <%- include("../components/kpi-simple", {
            icon: "👔",
            label: "Manager",
            value: stats.manager
        }) %>

    </div>


    <div class="dashboard-panel">

        <div class="panel-header">

            <div>

                <h2>
                    ⚡ Administrasi OpenWO
                </h2>

                <p>
                    Kelola pengguna dan konfigurasi sistem
                </p>

            </div>

        </div>

        <div id="jqtips">
        <a  title="TEST AJE BRO...!"
            href="/admin/users"
            class="admin-menu-card"
        >

            <div class="technician-summary-content">

                <div class="technician-summary-icon">
                    👥
                </div>

                <div>

                    <h2>
                        Kelola Pengguna
                    </h2>

                    <p>
                        Tambah, edit, dan kelola akun
                        pengguna OpenWO.
                    </p>

                </div>

            </div>

            <span class="admin-menu-arrow">
                →
            </span>

        </a>
        </div>

        <!-- =====================================================
            MASTER DATA
            ===================================================== -->

        <a
            href="/admin/master-data"
            class="admin-menu-card"
        >            

            <div class="technician-summary-content">
                
                <div class="technician-summary-icon">
                    📂
                </div>

                <div>

                    <h2>
                        Master Data
                    </h2>

                    <p>
                        Kelola data dasar dan konfigurasi
                        operasional OpenWO.
                    </p>

                </div>

            </div>

            <span class="admin-menu-arrow">
                →
            </span>

        </a>

        <a
            href="/workorder"
            class="admin-menu-card"
        >

            <div class="technician-summary-content">

                <div class="technician-summary-icon">
                    📋
                </div>

                <div>

                    <h2>
                        Lihat Work Order
                    </h2>

                    <p>
                        Pantau seluruh Work Order dan
                        lihat detail progres pekerjaan.
                    </p>

                </div>

            </div>

            <span class="admin-menu-arrow">
                →
            </span>

        </a>

    </div>

    <div class="dashboard-panel">

    <div class="panel-header">

        <div>

            <h2>
                🖥️ Status Sistem
            </h2>

            <p>
                Kondisi komponen utama OpenWO
            </p>

        </div>

    </div>


    <div class="system-status-list">


        <!-- SERVER -->

        <div class="system-status-item">

            <div class="system-status-info">

                <span class="system-status-icon">
                    🖥️
                </span>

                <div>

                    <strong>
                        Server
                    </strong>

                    <small>
                        OpenWO Application
                    </small>

                </div>

            </div>


            <span class="system-status-badge status-online">

                ● Online

            </span>

        </div>


        <!-- DATABASE -->

        <div class="system-status-item">

            <div class="system-status-info">

                <span class="system-status-icon">
                    🗄️
                </span>

                <div>

                    <strong>
                        Database
                    </strong>

                    <small>
                        SQLite
                    </small>

                </div>

            </div>


            <% if (
                databaseStatus === "normal"
            ) { %>

                <span
                    class="system-status-badge status-online"
                >
                    ● Normal
                </span>

            <% } else { %>

                <span
                    class="system-status-badge status-error"
                >
                    ● Error
                </span>

            <% } %>

        </div>


        <!-- SOCKET.IO -->

        <div class="system-status-item">

            <div class="system-status-info">

                <span class="system-status-icon">
                    ⚡
                </span>

                <div>

                    <strong>
                        Real-Time
                    </strong>

                    <small>
                        Socket.IO
                    </small>

                </div>

            </div>


            <span
                id="socketStatus"
                class="system-status-badge status-checking"
            >
                ● Memeriksa...
            </span>

        </div>


    </div>

</div>

<% } else if (role === "teknisi") { %>

<%
    /*
     * ==========================================
     * DASHBOARD TEKNISI — MODERN WORKSPACE
     * ==========================================
     *
     * UI-only redesign.
     * Tidak mengubah controller, database, workflow,
     * atau business rule yang sudah berjalan.
     */
    const techTotal =
        Array.isArray(technicianWorkorders)
            ? technicianWorkorders.length
            : 0;

    const techActive =
        Number(technicianSummary.ditugaskan || 0) +
        Number(technicianSummary.diproses || 0);
%>

<style>
/* ==========================================
   MODERN TECHNICIAN DASHBOARD
   Scope: role teknisi
   ========================================== */

.tech-workspace {
    display: flex;
    flex-direction: column;
    gap: 18px;
}

.tech-hero {
    position: relative;
    overflow: hidden;
    padding: 24px 26px;
    border: 1px solid #e5eaf3;
    border-radius: 18px;
    background:
        radial-gradient(circle at 88% 18%, rgba(59,130,246,.10), transparent 30%),
        linear-gradient(135deg, #ffffff 0%, #f8fbff 100%);
    box-shadow: 0 8px 24px rgba(15, 23, 42, .045);
}

.tech-hero-content {
    position: relative;
    z-index: 2;
    max-width: 700px;
}

.tech-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    margin-bottom: 8px;
    font-size: 11px;
    font-weight: 700;
    color: #2563eb;
    text-transform: uppercase;
    letter-spacing: .03em;
}

.tech-hero h1 {
    margin: 0;
    font-size: clamp(22px, 2vw, 30px);
    line-height: 1.2;
    color: #0f172a;
}

.tech-hero p {
    margin: 8px 0 0;
    max-width: 620px;
    font-size: 13px;
    line-height: 1.6;
    color: #64748b;
}

.tech-date {
    margin-top: 10px;
    font-size: 11px;
    color: #94a3b8;
}

.tech-hero-mark {
    position: absolute;
    top: 50%;
    right: 26px;
    width: 96px;
    height: 96px;
    display: grid;
    place-items: center;
    transform: translateY(-50%);
    border-radius: 28px;
    background: rgba(37, 99, 235, .08);
    color: #2563eb;
    font-size: 42px;
}

.tech-kpis {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px;
}

.tech-kpi {
    min-height: 108px;
    padding: 18px;
    display: flex;
    align-items: flex-start;
    gap: 13px;
    border: 1px solid #e6ebf2;
    border-radius: 16px;
    background: #fff;
    box-shadow: 0 5px 18px rgba(15, 23, 42, .035);
    transition: transform .18s ease, box-shadow .18s ease;
}

.tech-kpi:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 24px rgba(15, 23, 42, .07);
}

.tech-kpi-icon {
    width: 42px;
    height: 42px;
    flex: 0 0 42px;
    display: grid;
    place-items: center;
    border-radius: 13px;
    font-size: 19px;
}

.tech-kpi-icon.total {
    background: #eef4ff;
    color: #2563eb;
}

.tech-kpi-icon.assigned {
    background: #fff7e8;
    color: #d97706;
}

.tech-kpi-icon.progress {
    background: #eef4ff;
    color: #2563eb;
}

.tech-kpi-icon.done {
    background: #ecfdf5;
    color: #059669;
}

.tech-kpi-label {
    display: block;
    margin-bottom: 5px;
    font-size: 11px;
    color: #64748b;
}

.tech-kpi-value {
    display: block;
    font-size: 25px;
    line-height: 1;
    font-weight: 750;
    color: #0f172a;
}

.tech-kpi-note {
    display: block;
    margin-top: 7px;
    font-size: 10px;
    color: #94a3b8;
}

.tech-summary {
    overflow: hidden;
    border: 1px solid #e6ebf2;
    border-radius: 18px;
    background: #fff;
    box-shadow: 0 7px 22px rgba(15, 23, 42, .04);
}

.tech-summary-head {
    padding: 18px 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    border-bottom: 1px solid #edf1f6;
}

.tech-summary-title {
    display: flex;
    align-items: center;
    gap: 11px;
}

.tech-summary-title-icon {
    width: 38px;
    height: 38px;
    display: grid;
    place-items: center;
    border-radius: 11px;
    background: #eef4ff;
    color: #2563eb;
}

.tech-summary-title h2 {
    margin: 0;
    font-size: 15px;
    color: #0f172a;
}

.tech-summary-title p {
    margin: 3px 0 0;
    font-size: 11px;
    color: #94a3b8;
}

.tech-summary-action {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 9px 13px;
    border-radius: 9px;
    background: #2563eb;
    color: #fff !important;
    text-decoration: none;
    font-size: 11px;
    font-weight: 700;
    white-space: nowrap;
}

.tech-summary-stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
}

.tech-summary-stat {
    min-height: 82px;
    padding: 16px 20px;
    border-right: 1px solid #edf1f6;
}

.tech-summary-stat:last-child {
    border-right: 0;
}

.tech-summary-stat-label {
    display: block;
    margin-bottom: 6px;
    font-size: 10px;
    color: #94a3b8;
}

.tech-summary-stat-value {
    display: block;
    font-size: 18px;
    font-weight: 750;
    color: #0f172a;
}

.tech-summary-stat-note {
    display: block;
    margin-top: 4px;
    font-size: 10px;
    color: #64748b;
}

.tech-feed-card {
    overflow: hidden;
    border: 1px solid #e6ebf2;
    border-radius: 18px;
    background: #fff;
    box-shadow: 0 7px 22px rgba(15, 23, 42, .04);
}

.tech-feed-head {
    padding: 17px 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid #edf1f6;
}

.tech-feed-head h2 {
    margin: 0;
    font-size: 15px;
    color: #0f172a;
}

.tech-feed-head a {
    font-size: 11px;
    font-weight: 700;
    color: #2563eb;
    text-decoration: none;
}

.tech-feed-list {
    display: flex;
    flex-direction: column;
}

.tech-feed-row {
    display: grid;
    grid-template-columns: 42px minmax(0, 1fr) auto 24px;
    align-items: center;
    gap: 14px;
    padding: 15px 20px;
    border-bottom: 1px solid #f0f3f7;
    transition: background .18s ease;
}

.tech-feed-row:last-child {
    border-bottom: 0;
}

.tech-feed-row:hover {
    background: #f8fbff;
}

.tech-feed-icon {
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    border-radius: 12px;
    background: #f1f5f9;
    color: #475569;
    font-size: 17px;
}

.tech-feed-main {
    min-width: 0;
}

.tech-feed-number {
    display: block;
    margin-bottom: 3px;
    font-size: 10px;
    font-weight: 700;
    color: #94a3b8;
}

.tech-feed-title {
    display: block;
    overflow: hidden;
    font-size: 13px;
    font-weight: 700;
    color: #0f172a;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.tech-feed-meta {
    display: block;
    margin-top: 4px;
    overflow: hidden;
    font-size: 10px;
    color: #64748b;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.tech-feed-arrow {
    color: #94a3b8;
    font-size: 16px;
}

.tech-status {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 74px;
    padding: 6px 10px;
    border-radius: 999px;
    font-size: 10px;
    font-weight: 700;
}

.tech-status.status-ditugaskan {
    background: #fff7e8;
    color: #b45309;
}

.tech-status.status-diproses {
    background: #eef4ff;
    color: #2563eb;
}

.tech-status.status-selesai {
    background: #ecfdf5;
    color: #059669;
}

.tech-empty {
    padding: 38px 20px;
    text-align: center;
    color: #94a3b8;
    font-size: 12px;
}

.tech-pagination {
    padding: 14px 20px;
    border-top: 1px solid #edf1f6;
}

@media (max-width: 900px) {
    .tech-kpis {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .tech-summary-stats {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .tech-summary-stat:nth-child(2) {
        border-right: 0;
    }

    .tech-summary-stat:nth-child(-n+2) {
        border-bottom: 1px solid #edf1f6;
    }

    .tech-hero-mark {
        opacity: .45;
    }
}

@media (max-width: 650px) {
    .tech-hero {
        padding: 20px;
    }

    .tech-hero-mark {
        display: none;
    }

    .tech-kpis {
        grid-template-columns: 1fr 1fr;
        gap: 10px;
    }

    .tech-kpi {
        min-height: 96px;
        padding: 14px;
    }

    .tech-summary-head {
        align-items: flex-start;
        flex-direction: column;
    }

    .tech-summary-action {
        width: 100%;
        justify-content: center;
    }

    .tech-feed-row {
        grid-template-columns: 36px minmax(0, 1fr) auto;
        gap: 10px;
        padding: 13px 14px;
    }

    .tech-feed-icon {
        width: 36px;
        height: 36px;
        font-size: 15px;
    }

    .tech-feed-arrow {
        display: none;
    }
}

@media (max-width: 420px) {
    .tech-kpis,
    .tech-summary-stats {
        grid-template-columns: 1fr;
    }

    .tech-summary-stat {
        border-right: 0 !important;
        border-bottom: 1px solid #edf1f6;
    }

    .tech-summary-stat:last-child {
        border-bottom: 0;
    }
}
</style>

<div class="tech-workspace">

    <%- include("../components/welcome-card") %>

    <section class="tech-kpis">

        <article class="tech-kpi">
            <div class="tech-kpi-icon total">📋</div>

            <div>
                <span class="tech-kpi-label">Total Work Order</span>

                <strong class="tech-kpi-value">
                    <%= techTotal %>
                </strong>

                <small class="tech-kpi-note">
                    Semua WO Anda
                </small>
            </div>
        </article>


        <article class="tech-kpi">
            <div class="tech-kpi-icon assigned">📌</div>

            <div>
                <span class="tech-kpi-label">Ditugaskan</span>

                <strong class="tech-kpi-value">
                    <%= technicianSummary.ditugaskan %>
                </strong>

                <small class="tech-kpi-note">
                    Siap dikerjakan
                </small>
            </div>
        </article>


        <article class="tech-kpi">
            <div class="tech-kpi-icon progress">⚙️</div>

            <div>
                <span class="tech-kpi-label">Diproses</span>

                <strong class="tech-kpi-value">
                    <%= technicianSummary.diproses %>
                </strong>

                <small class="tech-kpi-note">
                    Sedang dikerjakan
                </small>
            </div>
        </article>


        <article class="tech-kpi">
            <div class="tech-kpi-icon done">✓</div>

            <div>
                <span class="tech-kpi-label">Selesai</span>

                <strong class="tech-kpi-value">
                    <%= technicianSummary.selesai %>
                </strong>

                <small class="tech-kpi-note">
                    Pekerjaan selesai
                </small>
            </div>
        </article>

    </section>    

    <%- include("../components/quick-action") %>

    <section class="tech-summary">

        <div class="tech-summary-stats">

            <div class="tech-summary-stat">
                <span class="tech-summary-stat-label">Total</span>

                <strong class="tech-summary-stat-value">
                    <%= techTotal %>
                </strong>

                <small class="tech-summary-stat-note">
                    Semua WO Anda
                </small>
            </div>


            <div class="tech-summary-stat">
                <span class="tech-summary-stat-label">WO Aktif</span>

                <strong class="tech-summary-stat-value">
                    <%= techActive %>
                </strong>

                <small class="tech-summary-stat-note">
                    Ditugaskan + diproses
                </small>
            </div>


            <div class="tech-summary-stat">
                <span class="tech-summary-stat-label">
                    Sedang Dikerjakan
                </span>

                <strong class="tech-summary-stat-value">
                    <%= technicianSummary.diproses %>
                </strong>

                <small class="tech-summary-stat-note">
                    Status Diproses
                </small>
            </div>


            <div class="tech-summary-stat">
                <span class="tech-summary-stat-label">Selesai</span>

                <strong class="tech-summary-stat-value">
                    <%= technicianSummary.selesai %>
                </strong>

                <small class="tech-summary-stat-note">
                    Status Selesai
                </small>
            </div>

        </div>

    </section>


    <section class="tech-feed-card">

        <div class="tech-feed-head">

            <h2>Work Order Terbaru</h2>

            <a href="/workorder">
                Lihat Semua →
            </a>

        </div>


        <div class="tech-feed-list">

            <% if (
                technicianFeed.length === 0
            ) { %>

                <div class="tech-empty">
                    Belum ada Work Order yang menjadi tanggung jawab Anda.
                </div>

            <% } else { %>

                <% technicianFeed.forEach(wo => { %>

                    <article class="tech-feed-row">

                        <div class="tech-feed-icon">

                            <%
                                const techIcon =
                                    wo.kategori === "Incident"
                                        ? "⚠️"
                                        : wo.kategori === "Service Request"
                                            ? "🔧"
                                            : "🛠️";
                            %>

                            <%= techIcon %>

                        </div>


                        <div class="tech-feed-main">

                            <span class="tech-feed-number">
                                <%= wo.nomor %>
                            </span>

                            <strong class="tech-feed-title">
                                <%= wo.judul %>
                            </strong>

                            <span class="tech-feed-meta">
                                <%= wo.kategori %>

                                <% if (wo.subkategori) { %>
                                    • <%= wo.subkategori %>
                                <% } %>
                            </span>

                        </div>


                        <div>

                            <span
                                class="tech-status status-<%= String(wo.status || '').toLowerCase() %>"
                            >
                                <%= wo.status %>
                            </span>

                        </div>


                        <div class="tech-feed-arrow">
                            →
                        </div>

                    </article>

                <% }); %>

            <% } %>

        </div>

    </section>


        <%- include("../components/pagination", {
            pagination: pagination,
            baseUrl: "/dashboard"
        }) %>

</div>





<% } %>

<script>
const chartBars = document.querySelectorAll(".chart-bar");
const chartTooltip = document.getElementById("chartTooltip");


chartBars.forEach(bar => {

    bar.addEventListener("mouseenter", () => {

        const label = bar.dataset.label;
        const total = bar.dataset.total;

        chartTooltip.querySelector("b").textContent = label;

        chartTooltip.querySelector("small").textContent =
            `${total} Work Order`;

        const rect = bar.getBoundingClientRect();

        chartTooltip.style.left =
            `${rect.left + rect.width / 2}px`;

        chartTooltip.style.top =
            `${rect.top - 10}px`;

        chartTooltip.classList.add("show");

    });

    bar.addEventListener("mouseleave", () => {

        chartTooltip.classList.remove("show");

    });

});

/* ==========================================
   TREND WORK ORDER
   SVG COMPARISON — FINAL
   CURRENT  : 19–25
   PREVIOUS : 12–18

   KOORDINAT FINAL:
   Grid browser menjadi sumber koordinat.
   Tidak lagi menggunakan paddingY tebakan.
   ========================================== */

const trendCurve =
    document.querySelector(
        ".chart-curve-layer"
    );

if (trendCurve) {

    const svgWidth = 1000;
    const svgHeight = 220;
    const maxTrend = 40;

    /*
     * Data 7 hari sebelumnya
     * 12 → 18
     */
    const trendData = [
        <% lastWeekTrend.forEach((item, index) => { %>
            {
                label:
                    "<%= item.label %>",
                total:
                    <%= item.total %>
            }
            <% if (
                index < lastWeekTrend.length - 1
            ) { %>
                ,
            <% } %>
        <% }); %>
    ];

    /*
     * BAR periode saat ini.
     * X curve mengikuti posisi BAR aktual.
     */
    const chartBars =
        Array.from(
            document.querySelectorAll(
                ".chart-bars .chart-bar"
            )
        );

    /*
     * GRID AKTUAL BROWSER
     *
     * 40 dan 0 menjadi anchor utama.
     * Dengan begitu SVG tidak perlu menebak
     * padding atau tinggi area chart.
     */
    const grid40 =
        document.querySelector(
            ".trend-grid-40"
        );

    const grid0 =
        document.querySelector(
            ".trend-grid-0"
        );

    /*
     * ======================================
     * SINKRONISASI BAR DENGAN GRID AKTUAL
     * ======================================
     *
     * Tinggi .chart-bars tidak selalu sama dengan
     * jarak visual Grid 0 → Grid 40. Karena itu
     * persentase tinggi bar saja tidak cukup untuk
     * menjamin puncak bar tepat berada pada garis nilai.
     *
     * Kita gunakan jarak Grid aktual browser sebagai
     * satu-satunya referensi tinggi plot.
     */
    function syncTrendBars() {

        if (
            !grid40 ||
            !grid0
        ) {
            return;
        }

        const grid40Rect =
            grid40.getBoundingClientRect();

        const grid0Rect =
            grid0.getBoundingClientRect();

        const screenY40 =
            grid40Rect.top +
            grid40Rect.height / 2;

        const screenY0 =
            grid0Rect.top +
            grid0Rect.height / 2;

        const plotHeight =
            screenY0 - screenY40;

        if (
            !Number.isFinite(plotHeight) ||
            plotHeight <= 0
        ) {
            return;
        }

        chartBars.forEach(bar => {

            const total =
                Number(
                    bar.dataset.total || 0
                );

            const safeTotal =
                Math.max(
                    0,
                    Math.min(
                        maxTrend,
                        total
                    )
                );

            const height =
                (
                    safeTotal /
                    maxTrend
                ) * plotHeight;

            bar.style.height =
                `${height}px`;
        });
    }


    function renderTrendCurve() {

        if (
            !grid40 ||
            !grid0 ||
            !trendCurve
        ) {
            return;
        }

        /*
         * Bar dan curve memakai sistem koordinat
         * vertikal yang sama.
         */
        syncTrendBars();

        /*
         * Bersihkan hasil render sebelumnya.
         * Penting ketika resize terjadi.
         */
        while (
            trendCurve.firstChild
        ) {
            trendCurve.removeChild(
                trendCurve.firstChild
            );
        }

        const svgRect =
            trendCurve.getBoundingClientRect();

        const grid40Rect =
            grid40.getBoundingClientRect();

        const grid0Rect =
            grid0.getBoundingClientRect();

        /*
         * Titik tengah garis grid.
         * Ini adalah posisi FAKTUAL yang terlihat
         * di browser, bukan hasil asumsi CSS.
         */
        const screenY40 =
            grid40Rect.top +
            grid40Rect.height / 2;

        const screenY0 =
            grid0Rect.top +
            grid0Rect.height / 2;

        const gridDistance =
            screenY0 - screenY40;

        if (
            !Number.isFinite(gridDistance) ||
            gridDistance <= 0 ||
            svgRect.width <= 0 ||
            svgRect.height <= 0
        ) {
            return;
        }

        /*
         * Konversi posisi layar → koordinat SVG.
         */
        function screenToSvgY(
            screenY
        ) {
            const relativeY =
                screenY - svgRect.top;

            return (
                relativeY /
                svgRect.height
            ) * svgHeight;
        }

        /*
         * Nilai data → posisi layar.
         *
         * 40 = posisi grid 40
         * 0  = posisi grid 0
         */
        function valueToScreenY(
            value
        ) {
            const safeValue =
                Math.max(
                    0,
                    Math.min(
                        maxTrend,
                        Number(value) || 0
                    )
                );

            return (
                screenY0 -
                (
                    safeValue /
                    maxTrend
                ) *
                gridDistance
            );
        }

        /*
         * Buat titik curve.
         * X mengikuti tengah BAR periode saat ini.
         * Y mengikuti GRID aktual browser.
         */
        const points =
            trendData
                .map(
                    (item, index) => {

                        const bar =
                            chartBars[index];

                        if (!bar) {
                            return null;
                        }

                        const barRect =
                            bar.getBoundingClientRect();

                        const barCenterX =
                            barRect.left +
                            barRect.width / 2;

                        const relativeX =
                            barCenterX -
                            svgRect.left;

                        const x =
                            (
                                relativeX /
                                svgRect.width
                            ) *
                            svgWidth;

                        const screenY =
                            valueToScreenY(
                                item.total
                            );

                        const y =
                            screenToSvgY(
                                screenY
                            );

                        return {
                            x,
                            y,
                            label:
                                item.label,
                            total:
                                item.total
                        };
                    }
                )
                .filter(Boolean);

        if (
            points.length === 0
        ) {
            return;
        }

        /*
         * ======================================
         * BUAT CURVE BEZIER
         * ======================================
         */
        let curvePath =
            `M ${points[0].x} ${points[0].y}`;

        for (
            let i = 1;
            i < points.length;
            i++
        ) {

            const previous =
                points[i - 1];

            const current =
                points[i];

            const distance =
                current.x -
                previous.x;

            const controlPoint1X =
                previous.x +
                distance * 0.45;

            const controlPoint2X =
                current.x -
                distance * 0.45;

            curvePath +=
                ` C ` +
                `${controlPoint1X} ${previous.y}, ` +
                `${controlPoint2X} ${current.y}, ` +
                `${current.x} ${current.y}`;
        }

        /*
         * ======================================
         * GRADIENT
         * ======================================
         */
        const defs =
            document.createElementNS(
                "http://www.w3.org/2000/svg",
                "defs"
            );

        const gradient =
            document.createElementNS(
                "http://www.w3.org/2000/svg",
                "linearGradient"
            );

        gradient.setAttribute(
            "id",
            "trendCurveGradient"
        );

        gradient.setAttribute(
            "x1",
            "0%"
        );

        gradient.setAttribute(
            "y1",
            "0%"
        );

        gradient.setAttribute(
            "x2",
            "0%"
        );

        gradient.setAttribute(
            "y2",
            "100%"
        );

        const stopTop =
            document.createElementNS(
                "http://www.w3.org/2000/svg",
                "stop"
            );

        stopTop.setAttribute(
            "offset",
            "0%"
        );

        stopTop.setAttribute(
            "stop-color",
            "#2563eb"
        );

        stopTop.setAttribute(
            "stop-opacity",
            "0.065"
        );

        const stopBottom =
            document.createElementNS(
                "http://www.w3.org/2000/svg",
                "stop"
            );

        stopBottom.setAttribute(
            "offset",
            "100%"
        );

        stopBottom.setAttribute(
            "stop-color",
            "#2563eb"
        );

        stopBottom.setAttribute(
            "stop-opacity",
            "0.003"
        );

        gradient.appendChild(
            stopTop
        );

        gradient.appendChild(
            stopBottom
        );

        defs.appendChild(
            gradient
        );

        trendCurve.appendChild(
            defs
        );

        /*
         * ======================================
         * AREA
         * Baseline juga mengikuti grid 0 aktual.
         * ======================================
         */
        const baseline =
            screenToSvgY(
                screenY0
            );

        const areaPath =
            document.createElementNS(
                "http://www.w3.org/2000/svg",
                "path"
            );

        const areaPathData =
            curvePath +
            ` L ${points[points.length - 1].x} ${baseline}` +
            ` L ${points[0].x} ${baseline}` +
            ` Z`;

        areaPath.setAttribute(
            "d",
            areaPathData
        );

        areaPath.setAttribute(
            "fill",
            "url(#trendCurveGradient)"
        );

        areaPath.setAttribute(
            "stroke",
            "none"
        );

        trendCurve.appendChild(
            areaPath
        );

        /*
         * ======================================
         * GARIS CURVE
         * ======================================
         */
        const path =
            document.createElementNS(
                "http://www.w3.org/2000/svg",
                "path"
            );

        path.setAttribute(
            "d",
            curvePath
        );

        path.setAttribute(
            "fill",
            "none"
        );

        path.setAttribute(
            "stroke",
            "#2563eb"
        );

        path.setAttribute(
            "stroke-width",
            "1.8"
        );

        path.setAttribute(
            "stroke-linecap",
            "round"
        );

        path.setAttribute(
            "stroke-linejoin",
            "round"
        );

        /*
         * Curve adalah periode pembanding,
         * sehingga dibuat lebih samar.
         */
        path.setAttribute(
            "opacity",
            "0.35"
        );

        trendCurve.appendChild(
            path
        );
    }

    /*
     * Render setelah layout browser selesai.
     */
    requestAnimationFrame(
        renderTrendCurve
    );

    /*
     * Responsive:
     * chart dihitung ulang ketika ukuran
     * container berubah.
     */
    if (
        typeof ResizeObserver !==
        "undefined"
    ) {
        const trendResizeObserver =
            new ResizeObserver(() => {
                requestAnimationFrame(
                    renderTrendCurve
                );
            });

        trendResizeObserver.observe(
            trendCurve
        );
    } else {
        window.addEventListener(
            "resize",
            () => {
                requestAnimationFrame(
                    renderTrendCurve
                );
            }
        );
    }
}

/* ==========================================
   TREND KATEGORI
   DONUT + BAR CHART
   ========================================== */

const categoryDonut =
    document.getElementById(
        "categoryDonut"
    );

const categoryLegendItems =
    document.querySelectorAll(
        ".category-legend-item"
    );

const categoryBarsFinal =
    document.querySelectorAll(
        ".category-final-item"
    );


/* ==========================================
   DATA KATEGORI
   ========================================== */

const categoryColors = [
    "#2563eb",
    "#10b981",
    "#7c3aed",
    "#f59e0b",
    "#ef4444",
    "#06b6d4"
];


const categories =
    Array.from(
        categoryLegendItems
    ).map(
        (item, index) => {           

            const value =
                item
                    .closest(".category-dashboard-panel")
                    ?.querySelector(
                        `.category-final-item[data-kategori="${CSS.escape(item.dataset.kategori)}"]`
                    );

            const total =
                Number(
                    value
                        ?.querySelector(
                            ".category-final-bar strong"
                        )
                        ?.textContent
                        .trim() || 0
                );


            return {

                kategori:
                    item.dataset.kategori,

                total,

                subkategori:
                    JSON.parse(
                        item.dataset.subkategori ||
                        "{}"
                    ),

                color:
                    categoryColors[
                        index %
                        categoryColors.length
                    ]

            };

        }
    );

/* ==========================================
   HITUNG TOTAL KATEGORI
   ========================================== */

const categoryTotal =
    categories.reduce(
        (sum, item) =>
            sum + item.total,
        0
    );


/* ==========================================
   HITUNG PERSENTASE
   ========================================== */

categories.forEach(
    item => {

        item.percentage =
            categoryTotal > 0
                ? (
                    item.total /
                    categoryTotal
                ) * 100
                : 0;

    }
);


/* ==========================================
   DEBUG SEMENTARA
   ========================================== */

console.table(
    categories.map(
        item => ({

            Kategori:
                item.kategori,

            Jumlah:
                item.total,

            Persentase:
                `${item.percentage.toFixed(2)}%`

        })
    )
);


/* ==========================================
   DONUT
   ========================================== */

if (
    categoryDonut &&
    categories.length
) {

    const total =
        categories.reduce(
            (sum, item) =>
                sum + item.total,
            0
        );


    let current =
        0;


    const segments =
        categories.map(
            item => {

                const percentage =
                    total > 0
                        ? (
                            item.total /
                            total
                        ) * 100
                        : 0;


                const start =
                    current;


                current +=
                    percentage;


                return {

                    ...item,

                    start,

                    end:
                        current,

                    percentage

                };

            }
        );


    const gradient =
        segments
            .map(
                segment =>
                    `${segment.color} ` +
                    `${segment.start}% ` +
                    `${segment.end}%`
            )
            .join(", ");


    categoryDonut.style.background =
        `conic-gradient(${gradient})`;

    /* ==========================================
        LABEL PERSENTASE PADA DONUT
        ========================================== */

        categoryDonut
            .querySelectorAll(".donut-percentage")
            .forEach(
                label => label.remove()
            );


        segments.forEach(
            segment => {

                const label =
                    document.createElement(
                        "span"
                    );

                label.className =
                    "donut-percentage";


                label.textContent =
                    `${segment.percentage.toFixed(1)}%`;


                /*
                * Titik tengah slice.
                */
                const middle =
                    (
                        segment.start +
                        segment.end
                    ) / 2;


                /*
                * Ubah persentase menjadi sudut.
                *
                * -90° membuat titik awal
                * berada di posisi atas.
                */
                const angle =
                    (
                        middle / 100
                    ) * 360 - 90;


                /*
                * Slice kecil diberi jarak
                * sedikit keluar agar teks
                * tidak bertumpuk.
                */
                const isSmall =
                    segment.percentage < 5;


                const radius =
                    isSmall
                        ? 67
                        : 43;


                const radians =
                    angle *
                    Math.PI /
                    180;


                const x =
                    Math.cos(radians) *
                    radius;


                const y =
                    Math.sin(radians) *
                    radius;


                label.style.left =
                    `calc(50% + ${x}px)`;


                label.style.top =
                    `calc(50% + ${y}px)`;


                label.classList.toggle(
                    "small",
                    isSmall
                );


                categoryDonut.appendChild(
                    label
                );

            }
        );


    /*
     * Klik donut.
     */
    categoryDonut.addEventListener(
        "click",
        event => {

            const rect =
                categoryDonut
                    .getBoundingClientRect();


            const centerX =
                rect.left +
                rect.width / 2;


            const centerY =
                rect.top +
                rect.height / 2;


            const x =
                event.clientX -
                centerX;


            const y =
                event.clientY -
                centerY;


            const distance =
                Math.sqrt(
                    x * x +
                    y * y
                );


            /*
             * Klik bagian tengah
             * tidak melakukan apa-apa.
             */
            if (
                distance <
                rect.width * 0.29
            ) {

                return;

            }


            let angle =
                Math.atan2(
                    y,
                    x
                ) *
                180 /
                Math.PI;


            angle += 90;


            if (
                angle < 0
            ) {

                angle += 360;

            }


            const percent =
                angle / 360 * 100;


            const selected =
                segments.find(
                    segment =>
                        percent >=
                            segment.start &&
                        percent <
                            segment.end
                );


            if (
                selected
            ) {

                showCategorySubcategory(
                    selected
                );

            }

        }
    );

}


/* ==========================================
   LEGEND
   ========================================== */

categoryLegendItems.forEach(
    (item, index) => {

        const color =
            categoryColors[
                index %
                categoryColors.length
            ];


        const dot =
            item.querySelector(
                ".category-legend-dot"
            );


        if (dot) {

            dot.style.background =
                color;

        }


        item.addEventListener(
            "click",
            () => {

                showCategorySubcategory(
                    categories[index]
                );

            }
        );

    }
);


/* ==========================================
   BAR CLICK
   ========================================== */

categoryBarsFinal.forEach(
    bar => {

        bar.addEventListener(
            "click",
            () => {

                const kategori =
                    bar.dataset.kategori;


                const selected =
                    categories.find(
                        item =>
                            item.kategori ===
                            kategori
                    );


                if (
                    selected
                ) {

                    showCategorySubcategory(
                        selected
                    );

                }

            }
        );

    }
);

/* ==========================================
   SUBKATEGORI
   DONUT + HORIZONTAL BAR + HIGHLIGHT
   ========================================== */

function showCategorySubcategory(
    category
) {

    if (
        !subcategoryChart ||
        !subcategoryBars ||
        !subcategoryTitle
    ) {
        return;
    }


    /* ======================================
       AMBIL DATA
       ====================================== */

    const values =
        Object.entries(
            category.subkategori || {}
        );


    /* ======================================
       HITUNG TOTAL
       ====================================== */

    const subcategoryTotal =
        values.reduce(
            (sum, item) =>
                sum + Number(item[1] || 0),
            0
        );


    /* ======================================
       HITUNG PERSENTASE
       ====================================== */

    const subcategories =
        values.map(
            ([nama, jumlah]) => {

                const total =
                    Number(jumlah || 0);


                const percentage =
                    subcategoryTotal > 0
                        ? (
                            total /
                            subcategoryTotal
                        ) * 100
                        : 0;


                return {

                    nama,

                    total,

                    percentage

                };

            }
        );


    /* ======================================
       URUTKAN TERBESAR → TERKECIL
       ====================================== */

    subcategories.sort(
        (a, b) =>
            b.total - a.total
    );


    /* ======================================
       DEBUG
       ====================================== */

    console.group(
        `📊 SUBKATEGORI: ${category.kategori}`
    );


    console.table(
        subcategories.map(
            item => ({

                "Sub Kategori":
                    item.nama,

                "Jumlah":
                    item.total,

                "Persentase":
                    `${item.percentage.toFixed(2)}%`

            })
        )
    );

    console.groupEnd();


    /* ======================================
       JUDUL
       ====================================== */

    subcategoryTitle.textContent =
        `📊 Subkategori — ${category.kategori}`;


    /* ======================================
       TOTAL DONUT
       ====================================== */

    const subcategoryTotalElement =
        document.getElementById(
            "subcategoryTotal"
        );


    if (
        subcategoryTotalElement
    ) {

        subcategoryTotalElement.textContent =
            subcategoryTotal;

    }


    /* ======================================
       WARNA
       ====================================== */

    const subcategoryColors = [
        "#2563eb",
        "#10b981",
        "#7c3aed",
        "#f59e0b",
        "#ef4444",
        "#06b6d4",
        "#ec4899",
        "#64748b"
    ];


    /* ======================================
       DONUT
       ====================================== */

    const subcategoryDonut =
        document.getElementById(
            "subcategoryDonut"
        );


    if (
        subcategoryDonut &&
        subcategories.length
    ) {

        /*
         * Hapus label persentase lama.
         */

        subcategoryDonut
            .querySelectorAll(
                ".subcategory-donut-percentage"
            )
            .forEach(
                label =>
                    label.remove()
            );


        let current =
            0;


        const segments =
            subcategories.map(
                (item, index) => {

                    const start =
                        current;


                    current +=
                        item.percentage;


                    return {

                        ...item,

                        start,

                        end:
                            current,

                        color:
                            subcategoryColors[
                                index %
                                subcategoryColors.length
                            ]

                    };

                }
            );


        /*
         * Buat conic-gradient.
         */

        const gradient =
            segments
                .map(
                    segment =>
                        `${segment.color} ` +
                        `${segment.start}% ` +
                        `${segment.end}%`
                )
                .join(", ");


        subcategoryDonut.style.background =
            `conic-gradient(${gradient})`;


        /* ==================================
           LABEL PERSENTASE DONUT
           ================================== */

        segments.forEach(
            segment => {

                const label =
                    document.createElement(
                        "span"
                    );


                label.className =
                    "subcategory-donut-percentage";


                label.textContent =
                    `${segment.percentage.toFixed(1)}%`;


                const middle =
                    (
                        segment.start +
                        segment.end
                    ) / 2;


                const angle =
                    (
                        middle / 100
                    ) * 360 - 90;


                /*
                 * Slice kecil sedikit keluar.
                 */

                const isSmall =
                    segment.percentage < 5;


                const radius =
                    isSmall
                        ? 60
                        : 38;


                const radians =
                    angle *
                    Math.PI /
                    180;


                const x =
                    Math.cos(radians) *
                    radius;


                const y =
                    Math.sin(radians) *
                    radius;


                label.style.left =
                    `calc(50% + ${x}px)`;


                label.style.top =
                    `calc(50% + ${y}px)`;


                label.classList.toggle(
                    "small",
                    isSmall
                );


                subcategoryDonut.appendChild(
                    label
                );

            }
        );

    }


    /* ======================================
       RENDER BAR HORIZONTAL
       ====================================== */

    subcategoryBars.innerHTML =
        "";


    const max =
        Math.max(
            ...subcategories.map(
                item => item.total
            ),
            1
        );


    subcategories.forEach(
        (item, index) => {

            const wrapper =
                document.createElement(
                    "div"
                );


            wrapper.className =
                "subcategory-bar-wrapper";

            wrapper.style.setProperty(
                "--subcategory-color",
                subcategoryColors[
                    index %
                    subcategoryColors.length
                ]
            );


            /*
             * Persentase untuk CSS
             * pseudo-element.
             */

            wrapper.dataset.percentage =
                `${item.percentage.toFixed(1)}%`;


            /* ==============================
               LABEL
               ============================== */

            const label =
                document.createElement(
                    "span"
                );


            label.textContent =
                item.nama;


            /* ==============================
               BAR
               ============================== */

            const bar =
                document.createElement(
                    "div"
                );


            bar.className =
                "subcategory-bar";


            /*
             * Bar horizontal menggunakan
             * proporsi terhadap subkategori
             * terbesar.
             */

            const progress =
                max > 0
                    ? (
                        item.total /
                        max
                    ) * 100
                    : 0;


            bar.style.setProperty(
                "--subcategory-progress",
                `${progress}%`
            );


            /*
             * Tetap masukkan jumlah.
             */

            bar.innerHTML =
                `<strong>${item.total}</strong>`;


            /*
             * Warna bar mengikuti urutan.
             */

            bar.style.setProperty(
                "--subcategory-color",
                subcategoryColors[
                    index %
                    subcategoryColors.length
                ]
            );


            wrapper.appendChild(
                label
            );


            wrapper.appendChild(
                bar
            );


            subcategoryBars.appendChild(
                wrapper
            );

        }
    );


    /* ======================================
       SUBKATEGORI TERBANYAK
       ====================================== */

    const topCategory =
        subcategories[0];


    const topName =
        document.getElementById(
            "subcategoryTopName"
        );


    const topTotal =
        document.getElementById(
            "subcategoryTopTotal"
        );


    const topPercentage =
        document.getElementById(
            "subcategoryTopPercentage"
        );


    if (
        topCategory
    ) {

        if (
            topName
        ) {

            topName.textContent =
                topCategory.nama;

        }


        if (
            topTotal
        ) {

            topTotal.textContent =
                topCategory.total;

        }


        if (
            topPercentage
        ) {

            topPercentage.textContent =
                `${topCategory.percentage.toFixed(1)}%`;

        }

    }


    /* ======================================
       TAMPILKAN PANEL
       ====================================== */

    subcategoryChart.style.display =
        "block";


    subcategoryChart.scrollIntoView({
        behavior: "smooth",
        block: "nearest"
    });

}


if (subcategoryBack) {

    subcategoryBack.addEventListener(
        "click",
        () => {

            subcategoryChart.style.display =
                "none";

        }
    );

}

/* ==========================================
   KPI COMPARISON + SPARKLINE
   ========================================== */

const kpiComparison =
    <%- JSON.stringify(
        typeof kpiComparison !== "undefined"
            ? kpiComparison
            : {}
    ) %>;


function renderKpiSparkline(svg, trend) {

    if (
        !svg ||
        !Array.isArray(trend) ||
        trend.length === 0
    ) {
        return;
    }


    const width = 120;
    const height = 42;

    const paddingX = 0;
    const paddingY = 0;


    const values =
        trend.map(
            item => Number(item.total || 0)
        );


    const max =
        Math.max(
            ...values,
            1
        );


    const points =
        values.map(
            (value, index) => {

                const x =
                    paddingX +
                    (
                        index /
                        Math.max(
                            values.length - 1,
                            1
                        )
                    ) *
                    (
                        width -
                        paddingX * 2
                    );


                const y =
                    height -
                    paddingY -
                    (
                        value / max
                    ) *
                    (
                        height -
                        paddingY * 2
                    );


                return {
                    x,
                    y
                };

            }
        );


    let pathData = "";


    points.forEach(
        (point, index) => {

            if (index === 0) {

                pathData =
                    `M ${point.x} ${point.y}`;

                return;

            }


            const previous =
                points[index - 1];


            const distance =
                point.x -
                previous.x;


            const cp1x =
                previous.x +
                distance * 0.45;


            const cp2x =
                point.x -
                distance * 0.45;


            pathData +=
                ` C ` +
                `${cp1x} ${previous.y}, ` +
                `${cp2x} ${point.y}, ` +
                `${point.x} ${point.y}`;

        }
    );


    const baseline =
        height -
        paddingY;


    const areaPath =
        pathData +
        ` L ${points[points.length - 1].x} ${baseline}` +
        ` L ${points[0].x} ${baseline}` +
        ` Z`;


    svg.innerHTML = `

        <path
            class="spark-area"
            d="${areaPath}"
        ></path>

        <path
            d="${pathData}"
        ></path>

    `;

}


function renderKpiComparison(
    card,
    data
) {

    if (!card || !data) {
        return;
    }


    const changeElement =
        card.querySelector(
            ".kpi-change"
        );


    if (!changeElement) {
        return;
    }


    const change =
        data.change;


    if (
        change === null ||
        change === undefined
    ) {

        changeElement.textContent =
            "Baru";

        changeElement.className =
            "kpi-change new";

        return;

    }


    const rounded =
        Math.abs(change).toFixed(1);


    if (change > 0) {

        changeElement.textContent =
            `↑ ${rounded}%`;

        changeElement.className =
            "kpi-change up";

        return;

    }


    if (change < 0) {

        changeElement.textContent =
            `↓ ${rounded}%`;

        changeElement.className =
            "kpi-change down";

        return;

    }


    changeElement.textContent =
        "0%";

    changeElement.className =
        "kpi-change same";

}


document
    .querySelectorAll(
        ".kpi-enhanced"
    )
    .forEach(
        card => {

            const key =
                card.dataset.kpi;


            const data =
                kpiComparison[key];


            if (!data) {
                return;
            }


            /* ==============================
               PERSENTASE PERBANDINGAN
               ============================== */

            renderKpiComparison(
                card,
                data
            );


            /* ==============================
               SPARKLINE 7 HARI TERAKHIR
               ============================== */

            const svg =
                card.querySelector(
                    ".kpi-sparkline"
                );


            renderKpiSparkline(
                svg,
                data.trend
            );

        }
    );

</script>