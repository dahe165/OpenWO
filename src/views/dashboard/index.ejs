<script>
const chartBars = document.querySelectorAll(".chart-bar");
const chartTooltip = document.getElementById("chartTooltip");


chartBars.forEach(bar => {

    bar.addEventListener("mouseenter", () => {

        const label = bar.dataset.label;
        const total = bar.dataset.total;

        chartTooltip.querySelector("b").textContent = label;

        chartTooltip.querySelector("small").textContent =
            `${total} Work Order`;

        const rect = bar.getBoundingClientRect();

        chartTooltip.style.left =
            `${rect.left + rect.width / 2}px`;

        chartTooltip.style.top =
            `${rect.top - 10}px`;

        chartTooltip.classList.add("show");

    });

    bar.addEventListener("mouseleave", () => {

        chartTooltip.classList.remove("show");

    });

});


const categoryBars =
    document.querySelectorAll(".category-bar");

const subcategoryChart =
    document.getElementById("subcategoryChart");

const subcategoryBars =
    document.getElementById("subcategoryBars");

const subcategoryTitle =
    document.getElementById("subcategoryTitle");

const subcategoryBack =
    document.getElementById("subcategoryBack");


categoryBars.forEach(bar => {

    bar.addEventListener("click", () => {

        const kategori =
            bar.dataset.kategori;

        const subkategori =
            JSON.parse(bar.dataset.subkategori);

        subcategoryTitle.textContent =
            `📂 ${kategori}`;

        subcategoryBars.innerHTML = "";

        const values =
            Object.entries(subkategori);

        const max =
            Math.max(
                ...values.map(item => item[1]),
                1
            );

        values.forEach(([nama, total]) => {

            const wrapper =
                document.createElement("div");

            wrapper.className =
                "subcategory-bar-wrapper";

            const barElement =
                document.createElement("div");

            barElement.className =
                "subcategory-bar";

            barElement.style.height =
                `${Math.max(
                    (total / max) * 100,
                    8
                )}%`;

            barElement.innerHTML =
                `<strong>${total}</strong>`;

            const label =
                document.createElement("span");

            label.textContent = nama;

            wrapper.appendChild(barElement);
            wrapper.appendChild(label);

            subcategoryBars.appendChild(wrapper);

        });

        subcategoryChart.style.display =
            "block";

        subcategoryChart.scrollIntoView({
            behavior: "smooth",
            block: "nearest"
        });

    });

});


if (subcategoryBack) {

    subcategoryBack.addEventListener(
        "click",
        () => {

            subcategoryChart.style.display =
                "none";

        }
    );

}


</script>