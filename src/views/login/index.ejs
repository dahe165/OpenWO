<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title><%= typeof title !== "undefined" ? title : "OpenWO" %></title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <link
        rel="stylesheet"
        href="/css/style.css"
    >

    <style>
        body {
            min-height: 100vh;
            margin: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #f5f7fb;
        }

        .login-page {
            width: 100%;
            max-width: 430px;
            padding: 24px;
        }

        .login-card {
            background: #fff;
            border: 1px solid #e2e6ee;
            border-radius: 18px;
            padding: 34px;
            box-shadow: 0 12px 35px rgba(20, 35, 60, 0.08);
        }

        .login-brand {
            text-align: center;
            margin-bottom: 28px;
        }

        .login-icon {
            width: 58px;
            height: 58px;
            margin: 0 auto 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 16px;
            background: #eef4ff;
            font-size: 28px;
        }

        .login-brand h1 {
            margin: 0;
            font-size: 26px;
            font-weight: 700;
            color: #172033;
        }

        .login-brand p {
            margin: 7px 0 0;
            color: #6b7280;
            font-size: 14px;
        }

        .form-label {
            font-size: 14px;
            font-weight: 600;
            color: #273248;
        }

        .form-control {
            min-height: 46px;
            border-radius: 10px;
        }

        .form-control:focus {
            border-color: #2f6fed;
            box-shadow: 0 0 0 3px rgba(47, 111, 237, 0.12);
        }

        .btn-login {
            width: 100%;
            min-height: 46px;
            margin-top: 8px;
            border: 0;
            border-radius: 10px;
            background: #2864e8;
            color: #fff;
            font-weight: 600;
        }

        .btn-login:hover {
            background: #2058d2;
            color: #fff;
        }

        .back-home {
            display: block;
            margin-top: 14px;
            text-align: center;
            font-size: 13px;
            text-decoration: none;
            color: #2864e8;
        }

        .login-footer {
            margin-top: 24px;
            text-align: center;
            color: #8a93a3;
            font-size: 12px;
        }
    </style>
</head>

<body>

    <main class="login-page">

        <section class="login-card">

            <div class="login-brand">

                <div class="login-icon">
                    🔐
                </div>

                <h1>
                    Masuk ke OpenWO
                </h1>

                <p>
                    Gunakan akun Anda untuk melanjutkan.
                </p>

                <% if (typeof error !== "undefined" && error) { %>

                    <div
                        class="alert alert-danger"
                        role="alert"
                        style="
                            margin-top: 18px;
                            margin-bottom: 0;
                            border-radius: 10px;
                            font-size: 13px;
                        "
                    >
                        <%= error %>
                    </div>

                <% } %>

            </div>

            <form
                method="POST"
                action="/login"
            >

                <input
                    type="hidden"
                    name="returnTo"
                    value="<%= typeof returnTo !== "undefined" ? returnTo : "/dashboard" %>"
                >

                <div class="mb-3">

                    <label
                        for="username"
                        class="form-label"
                    >
                        Username
                    </label>

                    <input
                        type="text"
                        class="form-control"
                        id="username"
                        name="username"
                        placeholder="Masukkan username"
                        autocomplete="username"
                        required
                        autofocus
                    >

                </div>

                <div class="mb-4">

                    <label
                        for="password"
                        class="form-label"
                    >
                        Password
                    </label>

                    <input
                        type="password"
                        class="form-control"
                        id="password"
                        name="password"
                        placeholder="Masukkan password"
                        autocomplete="current-password"
                        required
                    >

                </div>

                <button
                    type="submit"
                    class="btn btn-login"
                >
                    Masuk
                </button>

            </form>

            <a
                href="/"
                class="back-home"
            >
                ← Kembali ke Beranda
            </a>

            <div class="login-footer">
                OpenWO • Work Order IT
            </div>

        </section>

    </main>

</body>

</html>
