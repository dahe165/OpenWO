<script>
(function () {
    const closing = document.querySelector('input[name="workflowClosing"]');
    const verification = document.getElementById('workflowVerification');
    const escalation = document.getElementById('workflowEscalation');
    const escalationLabel = escalation?.closest('.setting-switch');
    const preview = document.getElementById('workflowPreview');

    function update() {
        if (!closing || !verification || !escalation || !preview) return;

        if (!closing.checked) {
            verification.checked = false;
            verification.disabled = true;
            escalation.checked = false;
            escalation.disabled = true;
        } else {
            verification.disabled = false;
            escalation.disabled = !verification.checked;
            if (!verification.checked) escalation.checked = false;
        }

        if (escalationLabel) {
            escalationLabel.classList.toggle('disabled', escalation.disabled);
        }

        document.querySelectorAll('.setting-switch').forEach(label => {
            const input = label.querySelector('input');
            const state = label.querySelector('.setting-state');
            if (input && state) state.textContent = input.checked ? 'ON' : 'OFF';
        });

        const steps = ['Selesai'];
        if (closing.checked) {
            if (verification.checked) {
                steps.push('Verifikasi Asman');
                if (escalation.checked) {
                    steps.push('Menunggu Verifikasi Manager', 'Verifikasi Manager');
                }
            }
            steps.push('Ditutup');
        }

        preview.innerHTML = '<div class="preview-flow">' + steps.map((step, i) =>
            (i ? '<span class="preview-arrow">→</span>' : '') +
            '<span class="preview-step">' + step + '</span>'
        ).join('') + '</div>';
    }

    closing?.addEventListener('change', update);
    verification?.addEventListener('change', update);
    escalation?.addEventListener('change', update);

    // Timeline display mode: make the entire option card interactive
    // and update the selected state immediately without waiting for save.
    document.querySelectorAll('input[name="timelineDisplayMode"]').forEach(input => {
        input.addEventListener('change', () => {
            document.querySelectorAll('.timeline-display-option').forEach(option => {
                const optionInput = option.querySelector('input[name="timelineDisplayMode"]');
                option.classList.toggle('selected', !!optionInput?.checked);
            });
        });
    });

    // Timeline stage colors: sync color picker <-> hex input and preview.
    document.querySelectorAll('[data-stage-color-item]').forEach(item => {
        const picker = item.querySelector('[data-color-picker]');
        const hex = item.querySelector('[data-color-hex]');
        const preview = item.querySelector('[data-color-preview]');

        const validHex = value => /^#[0-9a-fA-F]{6}$/.test(value);

        const refreshPreview = value => {
            if (validHex(value)) {
                item.style.setProperty('--preview-color', value);
            }
        };

        picker?.addEventListener('input', () => {
            if (!picker.value) return;
            hex.value = picker.value.toLowerCase();
            refreshPreview(hex.value);
        });

        hex?.addEventListener('input', () => {
            const value = hex.value.trim();
            if (validHex(value)) {
                picker.value = value;
                refreshPreview(value);
            }
        });

        hex?.addEventListener('blur', () => {
            const value = hex.value.trim();
            if (!validHex(value)) {
                hex.value = picker.value.toLowerCase();
            } else {
                hex.value = value.toLowerCase();
                picker.value = hex.value;
            }
            refreshPreview(hex.value);
        });

        refreshPreview(picker?.value || '#64748b');
    });

    update();
})();
</script>
