<%
    /*
     * ==========================================
     * REPORT - DIAGRAM WORK ORDER
     * ==========================================
     */

    const bulan =
        Number(report?.periode?.bulan) || 1;

    const tahun =
        Number(report?.periode?.tahun) ||
        new Date().getFullYear();


    /*
     * ==========================================
     * NAMA BULAN
     * ==========================================
     */

    const namaBulan = [
        "",
        "Januari",
        "Februari",
        "Maret",
        "April",
        "Mei",
        "Juni",
        "Juli",
        "Agustus",
        "September",
        "Oktober",
        "November",
        "Desember"
    ];


    const periodeLabel =
        `${namaBulan[bulan]} ${tahun}`;


    /*
     * ==========================================
     * TOTAL WORK ORDER
     * ==========================================
     */

    const totalWorkOrder =
        Array.isArray(report?.data)
            ? report.data.length
            : 0;

%>


<div
    class="report-chart-page"
    id="reportChartPage"
>


    <!-- ==========================================
         HEADER
    =========================================== -->

    <div class="report-chart-header">

        <div class="report-chart-title">

            <h1>
                Diagram Work Order
            </h1>

            <p>
                Sub kategori Work Order periode
                <strong>
                    <%= bulan %>/<%= tahun %>
                </strong>
            </p>

        </div>


        <!-- ======================================
             PRINT BUTTON
        ======================================= -->

        <button
            type="button"
            class="report-print-button"
            onclick="openPrintOptions()"
        >

            <span class="report-print-icon">
                🖨️
            </span>

            <span>
                Cetak Diagram
            </span>

        </button>

    </div>



    <!-- ==========================================
         INFO BAR
    =========================================== -->

    <div class="report-chart-info">


        <!-- KEMBALI -->

        <div class="report-info-back">

            <a
                href="/report?month=<%= bulan %>&year=<%= tahun %>"
                class="report-back-button"
            >

                <span>
                    ←
                </span>

                Kembali ke Report

            </a>

        </div>



        <!-- PERIODE -->

        <div class="report-info-item">

            <div class="report-info-icon">
                📅
            </div>

            <div>

                <span>
                    Periode
                </span>

                <strong>
                    <%= periodeLabel %>
                </strong>

            </div>

        </div>



        <!-- TOTAL -->

        <div class="report-info-item">

            <div class="report-info-icon">
                ☷
            </div>

            <div>

                <span>
                    Total Work Order
                </span>

                <strong>
                    <%= totalWorkOrder %>
                </strong>

            </div>

        </div>


    </div>



    <!-- ==========================================
         CHART CARD
    =========================================== -->

    <div class="report-chart-card">


        <div class="report-chart-card-header">

            <div>

                <h2>
                    Diagram Sub Kategori
                </h2>

                <p>
                    Jumlah Work Order per Sub Kategori
                </p>

            </div>

        </div>



        <!-- ======================================
             REUSABLE CHART
        ======================================= -->

        <div class="report-chart-content">

            <%- include(
                "../components/report/report-subcategory-chart",
                {
                    subkategori:
                        report.subkategori
                }
            ) %>

        </div>


    </div>


</div>



<!-- ==================================================
     PRINT OPTIONS MODAL
================================================== -->

<div
    class="print-options-overlay"
    id="printOptionsOverlay"
>


    <div
        class="print-options-modal"
        role="dialog"
        aria-modal="true"
        aria-labelledby="printOptionsTitle"
    >


        <!-- ==========================================
             MODAL HEADER
        =========================================== -->

        <div class="print-options-header">

            <div>

                <h2 id="printOptionsTitle">
                    Pilih Model Cetak
                </h2>

                <p>
                    Tentukan informasi yang ingin
                    ditampilkan pada hasil cetak.
                </p>

            </div>


            <button
                type="button"
                class="print-options-close"
                onclick="closePrintOptions()"
                aria-label="Tutup"
            >
                ×
            </button>

        </div>



        <!-- ==========================================
             OPTIONS
        =========================================== -->

        <div class="print-options-list">


            <!-- DIAGRAM SAJA -->

            <label class="print-option">

                <input
                    type="radio"
                    name="printMode"
                    value="simple"
                    checked
                >

                <span class="print-option-body">

                    <strong>
                        📊 Diagram Saja
                    </strong>

                    <small>
                        Judul, periode, dan diagram.
                    </small>

                </span>

            </label>



            <!-- DIAGRAM + RINGKASAN -->

            <label class="print-option">

                <input
                    type="radio"
                    name="printMode"
                    value="summary"
                >

                <span class="print-option-body">

                    <strong>
                        📄 Diagram + Ringkasan
                    </strong>

                    <small>
                        Diagram ditambah informasi
                        ringkas Work Order.
                    </small>

                </span>

            </label>



            <!-- DETAIL - BELUM AKTIF -->

            <label
                class="
                    print-option
                    print-option-disabled
                "
            >

                <input
                    type="radio"
                    name="printMode"
                    value="detail"
                    disabled
                >

                <span class="print-option-body">

                    <strong>
                        📋 Diagram + Detail
                    </strong>

                    <small>
                        Tersedia setelah Rekap WO
                        detail selesai dibuat.
                    </small>

                </span>

            </label>


        </div>



        <!-- ==========================================
             ACTION
        =========================================== -->

        <div class="print-options-actions">

            <button
                type="button"
                class="print-cancel-button"
                onclick="closePrintOptions()"
            >
                Batal
            </button>


            <button
                type="button"
                class="print-confirm-button"
                onclick="startPrint()"
            >

                🖨️ Cetak

            </button>

        </div>


    </div>

</div>



<style>

