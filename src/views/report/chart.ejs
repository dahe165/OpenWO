    ============================================== */

    .report-chart-bar,
    .report-chart-grid,
    .report-grid-line {

        -webkit-print-color-adjust:
            exact !important;

        print-color-adjust:
            exact !important;

    }


    /* ==============================================
       HIDE MODAL
    ============================================== */

    .print-options-overlay {

        display: none !important;

    }

}

</style>



<script>

/*
 * ==========================================
 * OPEN PRINT OPTIONS
 * ==========================================
 */

function openPrintOptions() {

    const overlay =
        document.getElementById(
            "printOptionsOverlay"
        );

    if (!overlay) {
        return;
    }

    overlay.classList.add("show");

}


/*
 * ==========================================
 * CLOSE PRINT OPTIONS
 * ==========================================
 */

function closePrintOptions() {

    const overlay =
        document.getElementById(
            "printOptionsOverlay"
        );

    if (!overlay) {
        return;
    }

    overlay.classList.remove("show");

}


/*
 * ==========================================
 * START PRINT
 * ==========================================
 */

function startPrint() {

    const selected =
        document.querySelector(
            'input[name="printMode"]:checked'
        );


    const mode =
        selected
            ? selected.value
            : "simple";


    /*
     * Bersihkan mode sebelumnya.
     */

    document.body.classList.remove(
        "print-mode-simple",
        "print-mode-summary",
        "print-mode-detail"
    );


    /*
     * Pasang mode yang dipilih.
     */

    document.body.classList.add(
        `print-mode-${mode}`
    );


    /*
     * Tutup modal.
     */

    closePrintOptions();


    /*
     * Beri waktu browser menerapkan
     * class sebelum membuka print.
     */

    setTimeout(
        function () {

            window.print();

        },
        100
    );

}


/*
 * ==========================================
 * AFTER PRINT
 * ==========================================
 */

window.addEventListener(
    "afterprint",
    function () {

        document.body.classList.remove(
            "print-mode-simple",
            "print-mode-summary",
            "print-mode-detail"
        );

    }
);


/*
 * ==========================================
 * ESC CLOSE MODAL
 * ==========================================
 */

document.addEventListener(
    "keydown",
    function (event) {

        if (
            event.key === "Escape"
        ) {

            closePrintOptions();

        }

    }
);


/*
 * ==========================================
 * CLICK OUTSIDE MODAL
 * ==========================================
 */

document.addEventListener(
    "click",
    function (event) {

        const overlay =
            document.getElementById(
                "printOptionsOverlay"
            );


        if (
            overlay &&
            event.target === overlay
        ) {

            closePrintOptions();

        }

    }
);

</script>