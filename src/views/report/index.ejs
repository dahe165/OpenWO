<div class="report-page">

    <!-- HEADER -->
    <div class="report-header">
        <div>
            <h1>Rekap Bulanan Work Order</h1>

            <p>
                Rekapitulasi Work Order berdasarkan periode
            </p>

            <% if (report.scope && (report.scope.role === "asman" || report.scope.role === "teknisi")) { %>
                <p class="report-scope-note">
                    Scope: <strong>Seksi <%= report.scope.section || "pengguna" %></strong>
                </p>
            <% } else if (report.scope && report.scope.role === "manager") { %>
                <p class="report-scope-note">
                    Scope: <strong><%= report.scope.department || "Bagian pengguna" %><%= report.scope.section ? " · " + report.scope.section : " · Semua Seksi" %></strong>
                </p>
            <% } else if (report.scope && report.scope.role === "admin") { %>
                <p class="report-scope-note">
                    Filter: <strong><%= report.scope.department || "Semua Bagian" %><%= report.scope.section ? " · " + report.scope.section : " · Semua Seksi" %></strong>
                </p>
            <% } %>
        </div>
    </div>


    <!-- FILTER -->
    <div class="report-card report-filter">

        <form
            method="GET"
            action="/report"
        >

            <div class="report-filter-grid">

                <%
                    const reportRole =
                        String(report?.scope?.role || "").toLowerCase();

                    const canOrgFilter =
                        reportRole === "admin" ||
                        reportRole === "manager";

                    const reportDepartments =
                        report?.filterOptions?.departments || [];

                    const reportSections =
                        report?.filterOptions?.sections || [];

                    const reportAllSections =
                        report?.filterOptions?.allSections || reportSections;

                    const selectedDepartmentId =
                        report?.filters?.departmentId || "";

                    const selectedSectionId =
                        report?.filters?.sectionId || "";
                %>

                <% if (canOrgFilter) { %>

                    <% if (reportRole === "admin") { %>
                    <div class="report-field">

                        <label for="department_id">
                            Bagian
                        </label>

                        <select
                            id="department_id"
                            name="department_id"
                            class="form-select"
                        >

                            <option value="">
                                Semua Bagian
                            </option>

                            <% reportDepartments.forEach(function (department) { %>
                                <option
                                    value="<%= department.id %>"
                                    data-department-id="<%= department.id %>"
                                    <%= Number(selectedDepartmentId) === Number(department.id) ? "selected" : "" %>
                                >
                                    <%= department.nama %>
                                </option>
                            <% }); %>

                        </select>

                    </div>
                    <% } else { %>
                    <div class="report-field">

                        <label>
                            Bagian
                        </label>

                        <div class="report-filter-locked">
                            <strong><%= report.scope.department || "Bagian pengguna" %></strong>
                            <input
                                type="hidden"
                                name="department_id"
                                value="<%= selectedDepartmentId %>"
                            >
                        </div>

                    </div>
                    <% } %>

                    <div class="report-field">

                        <label for="section_id">
                            Seksi
                        </label>

                        <select
                            id="section_id"
                            name="section_id"
                            class="form-select"
                        >

                            <option value="">
                                Semua Seksi
                            </option>

                            <% reportSections.forEach(function (section) { %>
                                <option
                                    value="<%= section.id %>"
                                    data-department-id="<%= section.department_id %>"
                                    <%= Number(selectedSectionId) === Number(section.id) ? "selected" : "" %>
                                >
                                    <%= section.nama %>
                                </option>
                            <% }); %>

                        </select>

                        <small class="report-field-hint">
                            <% if (reportRole === "manager") { %>
                                Pilih Seksi di dalam Bagian Anda.
                            <% } else { %>
                                Pilih Bagian terlebih dahulu untuk menyaring daftar Seksi.
                            <% } %>
                        </small>

                    </div>

                <% } %>

                <div class="report-field">

                    <label for="month">
                        Bulan
                    </label>

                    <select
                        id="month"
                        name="month"
                        class="form-select"
                    >

                        <option
                            value="1"
                            <%= report.periode.bulan === 1 ? "selected" : "" %>
                        >
                            Januari
                        </option>

                        <option
                            value="2"
                            <%= report.periode.bulan === 2 ? "selected" : "" %>
                        >
                            Februari
                        </option>

                        <option
                            value="3"
                            <%= report.periode.bulan === 3 ? "selected" : "" %>
                        >
                            Maret
                        </option>

                        <option
                            value="4"
                            <%= report.periode.bulan === 4 ? "selected" : "" %>
                        >
                            April
                        </option>

                        <option
                            value="5"
                            <%= report.periode.bulan === 5 ? "selected" : "" %>
                        >
                            Mei
                        </option>

                        <option
                            value="6"
                            <%= report.periode.bulan === 6 ? "selected" : "" %>
                        >
                            Juni
                        </option>

                        <option
                            value="7"
                            <%= report.periode.bulan === 7 ? "selected" : "" %>
                        >
                            Juli
                        </option>

                        <option
                            value="8"
                            <%= report.periode.bulan === 8 ? "selected" : "" %>
                        >
                            Agustus
                        </option>

                        <option
                            value="9"
                            <%= report.periode.bulan === 9 ? "selected" : "" %>
                        >
                            September
                        </option>

                        <option
                            value="10"
                            <%= report.periode.bulan === 10 ? "selected" : "" %>
                        >
                            Oktober
                        </option>

                        <option
                            value="11"
                            <%= report.periode.bulan === 11 ? "selected" : "" %>
                        >
                            November
                        </option>

                        <option
                            value="12"
                            <%= report.periode.bulan === 12 ? "selected" : "" %>
                        >
                            Desember
                        </option>

                    </select>

                </div>


                <div class="report-field">

                    <label for="year">
                        Tahun
                    </label>

                    <select
                        id="year"
                        name="year"
                        class="form-select"
                    >

                        <%
                            const currentYear =
                                new Date().getFullYear();

                            const startYear =
                                Math.min(
                                    currentYear - 2,
                                    report.periode.tahun - 2
                                );

                            const endYear =
                                Math.max(
                                    currentYear + 2,
                                    report.periode.tahun + 2
                                );
                        %>

                        <% for (
                            let year = startYear;
                            year <= endYear;
                            year++
                        ) { %>

                            <option
                                value="<%= year %>"
                                <%= report.periode.tahun === year ? "selected" : "" %>
                            >
                                <%= year %>
                            </option>

                        <% } %>

                    </select>

                </div>


                <div class="report-filter-action">

                    <button
                        type="submit"
                        class="btn btn-primary"
                    >
                        Tampilkan
                    </button>

                </div>

            </div>

        </form>

    </div>


    <!-- KPI -->
    <div class="report-kpi-grid">

        <div class="report-kpi-card">

            <span class="report-kpi-label">
                TOTAL
            </span>

            <strong>
                <%= report.summary.total %>
            </strong>

            <small>
                Work Order
            </small>

        </div>


        <div class="report-kpi-card">

            <span class="report-kpi-label">
                DIBUAT
            </span>

            <strong>
                <%= report.summary.total %>
            </strong>

            <small>
                Pada periode ini
            </small>

        </div>


        <div class="report-kpi-card">

            <span class="report-kpi-label">
                DIPROSES
            </span>

            <strong>
                <%= report.summary.diproses %>
            </strong>

            <small>
                Work Order
            </small>

        </div>


        <div class="report-kpi-card">

            <span class="report-kpi-label">
                SELESAI
            </span>

            <strong>
                <%= report.summary.selesai %>
            </strong>

            <small>
                Work Order
            </small>

        </div>

    </div>


    <!-- REPORT ACTIONS -->
    <div class="report-card report-actions-card">

        <div class="report-section-header">

            <div>
                <h2>
                    Laporan
                </h2>

                <p>
                    Pilih bentuk laporan yang ingin ditampilkan.
                </p>
            </div>

        </div>


        <div class="report-actions-grid">

            <!-- EXCEL -->
            <a
                href="#"
                class="report-action report-action-excel"
            >

                <span class="report-action-icon">
                    📊
                </span>

                <span class="report-action-content">

                    <strong>
                        Excel
                    </strong>

                    <small>
                        Export data Work Order
                    </small>

                </span>

                <span class="report-action-arrow">
                    →
                </span>

            </a>


            <!-- REKAP WO -->
            <a
                href="/report/workorders?month=<%= report.periode.bulan %>&year=<%= report.periode.tahun %><%= report.filters?.departmentId ? `&department_id=${report.filters.departmentId}` : "" %><%= report.filters?.sectionId ? `&section_id=${report.filters.sectionId}` : "" %>"
                class="report-action report-action-rekap"
            >

                <span class="report-action-icon">
                    📋
                </span>

                <span class="report-action-content">

                    <strong>
                        Rekap WO
                    </strong>

                    <small>
                        Lihat daftar Work Order
                    </small>

                </span>

                <span class="report-action-arrow">
                    →
                </span>

            </a>


            <!-- DIAGRAM -->
            <a
                href="/report/chart?month=<%= report.periode.bulan %>&year=<%= report.periode.tahun %><%= report.filters?.departmentId ? `&department_id=${report.filters.departmentId}` : "" %><%= report.filters?.sectionId ? `&section_id=${report.filters.sectionId}` : "" %>"
                class="report-action report-action-chart"
            >

                <span class="report-action-icon">
                    📈
                </span>

                <span class="report-action-content">

                    <strong>
                        Diagram
                    </strong>

                    <small>
                        Lihat diagram Work Order
                    </small>

                </span>

                <span class="report-action-arrow">
                    →
                </span>

            </a>


            <!-- PDF -->
             
            <%- include("../components/report/report-pdf-menu") %>

        </div>

    </div>


    <!-- PERIOD INFO -->
    <div class="report-period-info">

        Periode
        <strong>
            <%
                const monthNames = [
                    "",
                    "Januari",
                    "Februari",
                    "Maret",
                    "April",
                    "Mei",
                    "Juni",
                    "Juli",
                    "Agustus",
                    "September",
                    "Oktober",
                    "November",
                    "Desember"
                ];
            %>

            <%= monthNames[report.periode.bulan] %>
            <%= report.periode.tahun %>
        </strong>

    </div>

</div>
<style>
.report-filter-locked {
    min-height: 42px;
    display: flex;
    align-items: center;
    padding: 0 12px;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    background: #f8fafc;
    color: #334155;
    font-size: 13px;
}
.report-field-hint {
    display: block;
    margin-top: 5px;
    color: #94a3b8;
    font-size: 10px;
    line-height: 1.4;
}
</style>

<script>
(function () {
    const department = document.getElementById("department_id");
    const section = document.getElementById("section_id");

    if (!department || !section) return;

    /*
     * Gunakan seluruh Seksi aktif sebagai dataset client-side.
     * Seksi selalu dikelompokkan berdasarkan department_id sehingga
     * pilihan Bagian dan Seksi tidak pernah bercampur.
     */
    const allSections = <%- JSON.stringify(report.filterOptions?.allSections || []) %>;
    const selectedSection = "<%= selectedSectionId %>";

    const sectionsByDepartment = allSections.reduce(function (groups, item) {
        const key = String(item.department_id);
        if (!groups[key]) groups[key] = [];
        groups[key].push(item);
        return groups;
    }, {});

    function getDepartmentId() {
        const selected = department.options[department.selectedIndex];
        return selected?.dataset?.departmentId || department.value || "";
    }

    function renderSections(currentOverride) {
        const departmentId = getDepartmentId();
        const current =
            currentOverride !== undefined
                ? String(currentOverride)
                : String(section.value || selectedSection || "");

        section.innerHTML = "";

        const allOption = document.createElement("option");
        allOption.value = "";
        allOption.textContent = "Semua Seksi";
        section.appendChild(allOption);

        let sections = [];

        if (departmentId) {
            sections = sectionsByDepartment[String(departmentId)] || [];
        } else {
            sections = allSections;
        }

        sections.forEach(function (item) {
            const option = document.createElement("option");
            option.value = item.id;
            option.textContent = item.nama;
            option.dataset.departmentId = item.department_id;

            if (String(item.id) === current) {
                option.selected = true;
            }

            section.appendChild(option);
        });

        /* Jika Seksi sebelumnya bukan anak Bagian baru, reset. */
        if (current && !Array.from(section.options).some(function (option) {
            return option.value === current;
        })) {
            section.value = "";
        }
    }

    department.addEventListener("change", function () {
        renderSections("");
    });

    renderSections();
})();
</script>
