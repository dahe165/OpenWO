<div class="report-page report-workorders-page">

    <!-- =====================================================
         HEADER
         ===================================================== -->

    <div class="report-header">

        <div>

            <h1>
                Rekap Work Order
            </h1>

            <p>
                Daftar Work Order berdasarkan periode
            </p>

        </div>


        <div class="report-workorders-header-actions">

            <a
                href="/report?month=<%= report.periode.bulan %>&year=<%= report.periode.tahun %>"
                class="report-secondary-button"
            >
                ← Kembali
            </a>

        </div>

    </div>


    <!-- =====================================================
         PERIODE
         ===================================================== -->

    <%
        const monthNames = [
            "",
            "Januari",
            "Februari",
            "Maret",
            "April",
            "Mei",
            "Juni",
            "Juli",
            "Agustus",
            "September",
            "Oktober",
            "November",
            "Desember"
        ];
    %>


    <div class="report-workorders-period">

        <div>

            <span>
                Periode
            </span>

            <strong>
                <%= monthNames[report.periode.bulan] %>
                <%= report.periode.tahun %>
            </strong>

        </div>


        <div>

            <span>
                Total Work Order
            </span>

            <strong>
                <%= report.data.length %>
            </strong>

        </div>

    </div>


    <!-- =====================================================
         DETAIL WORK ORDER
         ===================================================== -->

    <div class="report-card report-workorders-card">

        <div class="report-section-header">

            <div>

                <h2>
                    Detail Work Order
                </h2>

                <p>
                    Daftar Work Order yang dibuat pada periode terpilih.
                </p>

            </div>

        </div>


        <div class="report-workorders-table-wrap">

            <% if (
                Array.isArray(report.data) &&
                report.data.length > 0
            ) { %>


                <table class="report-workorders-table">

                    <thead>

                        <tr>

                            <th>No</th>

                            <th>No WO</th>

                            <th>Tanggal</th>

                            <th>Sub Kategori</th>

                            <th>Uraian</th>

                            <th>Status</th>

                            <th>Tindakan</th>

                            <th>Pemohon</th>

                            <th>Petugas</th>

                        </tr>

                    </thead>


                    <tbody>

                        <% report.data.forEach(item => { %>

                            <%
                                let tanggal = "-";

                                if (item.tanggal) {

                                    const date =
                                        new Date(
                                            item.tanggal
                                        );

                                    if (
                                        !Number.isNaN(
                                            date.getTime()
                                        )
                                    ) {

                                        tanggal =
                                            date.toLocaleDateString(
                                                "id-ID",
                                                {
                                                    day: "2-digit",
                                                    month: "2-digit",
                                                    year: "numeric"
                                                }
                                            );

                                    }

                                }


                                let statusClass = "";

                                if (
                                    item.status === "Selesai"
                                ) {

                                    statusClass =
                                        "report-status-selesai";

                                } else if (
                                    item.status === "Ditutup"
                                ) {

                                    statusClass =
                                        "report-status-ditutup";

                                } else if (
                                    item.status === "Diproses"
                                ) {

                                    statusClass =
                                        "report-status-diproses";

                                } else if (
                                    item.status === "Ditugaskan"
                                ) {

                                    statusClass =
                                        "report-status-ditugaskan";

                                } else if (
                                    item.status === "Menunggu"
                                ) {

                                    statusClass =
                                        "report-status-menunggu";

                                }
                            %>


                            <tr>

                                <!-- NO -->

                                <td class="report-workorders-no">

                                    <%= item.no %>

                                </td>


                                <!-- NO WO -->

                                <td class="report-workorders-number">

                                    <strong>
                                        <%= item.nomor || "-" %>
                                    </strong>

                                </td>


                                <!-- TANGGAL -->

                                <td>

                                    <%= tanggal %>

                                </td>


                                <!-- SUB KATEGORI -->

                                <td>

                                    <span
                                        class="report-workorders-category"
                                    >
                                        <%= item.subkategori || "-" %>
                                    </span>

                                </td>


                                <!-- URAIAN -->

                                <td
                                    class="report-workorders-description"
                                >

                                    <%= item.uraian || "-" %>

                                </td>


                                <!-- STATUS -->

                                <td>

                                    <span
                                        class="report-workorders-status <%= statusClass %>"
                                    >
                                        <%= item.status || "-" %>
                                    </span>

                                </td>


                                <!-- TINDAKAN -->

                                <td
                                    class="report-workorders-action"
                                >

                                    <%= item.tindakan || "-" %>

                                </td>


                                <!-- PEMOHON -->

                                <td>

                                    <%= item.pemohon || "-" %>

                                </td>


                                <!-- PETUGAS -->

                                <td>

                                    <%= item.petugas || "-" %>

                                </td>

                            </tr>


                        <% }); %>

                    </tbody>

                </table>


            <% } else { %>


                <!-- =================================================
                     EMPTY STATE
                     ================================================= -->

                <div class="report-workorders-empty">

                    <div class="report-workorders-empty-icon">
                        📋
                    </div>

                    <strong>
                        Tidak ada Work Order
                    </strong>

                    <p>
                        Tidak ditemukan Work Order
                        pada periode yang dipilih.
                    </p>

                </div>


            <% } %>

        </div>

    </div>


    <!-- =====================================================
         FOOTER
         ===================================================== -->

    <div class="report-workorders-footer">

        Menampilkan

        <strong>
            <%= report.data.length %>
        </strong>

        Work Order pada periode

        <strong>
            <%= monthNames[report.periode.bulan] %>
            <%= report.periode.tahun %>
        </strong>

    </div>

</div>


<style>

/* =========================================================
   PAGE
   ========================================================= */

.report-workorders-page {
    width: 100%;
}


/* =========================================================
   HEADER
   ========================================================= */

.report-workorders-header-actions {
    display: flex;
    align-items: center;
}


.report-secondary-button {

    display: inline-flex;

    align-items: center;
    justify-content: center;

    min-height: 38px;

    padding: 8px 14px;

    border: 1px solid #dbe2ea;

    border-radius: 10px;

    background: #ffffff;

    color: #475569;

    font-size: 12px;

    font-weight: 600;

    text-decoration: none;

    transition: all 0.15s ease;

}


.report-secondary-button:hover {

    background: #f8fafc;

    border-color: #cbd5e1;

    color: #172033;

    transform: translateY(-1px);

}


/* =========================================================
   PERIOD
   ========================================================= */

.report-workorders-period {

    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 20px;

    margin-bottom: 14px;

    padding: 14px 18px;

    border: 1px solid #e6ebf1;

    border-radius: 12px;

    background: #ffffff;

    box-shadow:
        0 3px 12px
        rgba(30, 50, 80, 0.035);

}


.report-workorders-period > div {

    display: flex;

    flex-direction: column;

    gap: 3px;

}


.report-workorders-period span {

    color: #8993a3;

    font-size: 10px;

}


.report-workorders-period strong {

    color: #172033;

    font-size: 13px;

    font-weight: 700;

}


/* =========================================================
   CARD
   ========================================================= */

.report-workorders-card {

    overflow: hidden;

}


/* =========================================================
   TABLE WRAPPER
   ========================================================= */

.report-workorders-table-wrap {

    width: 100%;

    overflow-x: auto;

    border-top: 1px solid #edf0f4;

}


/* =========================================================
   TABLE
   ========================================================= */

.report-workorders-table {

    width: 100%;

    min-width: 1050px;

    border-collapse: collapse;

    font-size: 11px;

    color: #475569;

}


.report-workorders-table th {

    padding: 11px 10px;

    background: #f8fafc;

    border-bottom: 1px solid #e2e8f0;

    color: #64748b;

    font-size: 10px;

    font-weight: 700;

    text-align: left;

    white-space: nowrap;

}


.report-workorders-table td {

    padding: 11px 10px;

    border-bottom: 1px solid #eef2f6;

    vertical-align: top;

    line-height: 1.45;

}


.report-workorders-table tbody tr {

    transition: background 0.12s ease;

}


.report-workorders-table tbody tr:hover {

    background: #fafcff;

}


/* =========================================================
   NO
   ========================================================= */

.report-workorders-no {

    width: 45px;

    text-align: center;

}


/* =========================================================
   NO WO
   ========================================================= */

.report-workorders-number {

    white-space: nowrap;

}


.report-workorders-number strong {

    color: #334155;

    font-size: 10px;

}


/* =========================================================
   URAIAN
   ========================================================= */

.report-workorders-description {

    min-width: 180px;

    max-width: 300px;

}


/* =========================================================
   TINDAKAN
   ========================================================= */

.report-workorders-action {

    min-width: 160px;

    max-width: 250px;

}


/* =========================================================
   SUB KATEGORI
   ========================================================= */

.report-workorders-category {

    display: inline-flex;

    padding: 4px 7px;

    border-radius: 6px;

    background: #f1f5f9;

    color: #475569;

    font-size: 10px;

    white-space: nowrap;

}


/* =========================================================
   STATUS
   ========================================================= */

.report-workorders-status {

    display: inline-flex;

    align-items: center;

    padding: 4px 8px;

    border-radius: 999px;

    background: #f1f5f9;

    color: #475569;

    font-size: 10px;

    font-weight: 600;

    white-space: nowrap;

}


.report-status-selesai {

    background: #ecfdf5;

    color: #047857;

}


.report-status-ditutup {

    background: #ecfdf5;

    color: #047857;

}


.report-status-diproses {

    background: #eff6ff;

    color: #2563eb;

}


.report-status-ditugaskan {

    background: #fff7ed;

    color: #c2410c;

}


.report-status-menunggu {

    background: #f8fafc;

    color: #64748b;

}


/* =========================================================
   EMPTY
   ========================================================= */

.report-workorders-empty {

    display: flex;

    flex-direction: column;

    align-items: center;

    justify-content: center;

    min-height: 280px;

    padding: 30px;

    text-align: center;

}


.report-workorders-empty-icon {

    width: 54px;

    height: 54px;

    display: flex;

    align-items: center;

    justify-content: center;

    margin-bottom: 12px;

    border-radius: 14px;

    background: #f1f5f9;

    font-size: 24px;

}


.report-workorders-empty strong {

    color: #334155;

    font-size: 14px;

}


.report-workorders-empty p {

    margin: 5px 0 0;

    color: #94a3b8;

    font-size: 12px;

}


/* =========================================================
   FOOTER
   ========================================================= */

.report-workorders-footer {

    margin-top: 10px;

    padding: 0 3px;

    color: #94a3b8;

    font-size: 10px;

}


.report-workorders-footer strong {

    color: #64748b;

}


/* =========================================================
   MOBILE
   ========================================================= */

@media (max-width: 700px) {

    .report-workorders-period {

        align-items: flex-start;

        flex-direction: column;

    }


    .report-workorders-header-actions {

        width: 100%;

    }


    .report-secondary-button {

        width: 100%;

    }

}

</style>