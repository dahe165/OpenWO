<style>
    .asset-hub-page{max-width:1100px;margin:0 auto}
    .asset-hub-header{margin-bottom:26px}
    .asset-hub-header h1{margin:0;color:#111827;font-size:1.7rem;font-weight:750;letter-spacing:-.02em}
    .asset-hub-header p{margin:7px 0 0;color:#64748b;font-size:.88rem;line-height:1.5}
    .asset-hub-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:18px}
    .asset-hub-card{position:relative;min-height:145px;padding:16px 15px 14px;background:#fff;border:1px solid #dbe3ef;border-radius:15px;box-shadow:0 5px 16px rgba(15,23,42,.06);text-decoration:none;color:inherit;display:flex;flex-direction:column;transition:transform .18s ease,box-shadow .18s ease,border-color .18s ease}
    .asset-hub-card:hover{transform:translateY(-3px);box-shadow:0 10px 24px rgba(15,23,42,.11);border-color:#bfdbfe;color:inherit}
    .asset-hub-card.is-disabled{cursor:default;opacity:.86}
    .asset-hub-card.is-disabled:hover{transform:none;box-shadow:0 5px 16px rgba(15,23,42,.06);border-color:#dbe3ef}
    .asset-hub-top{display:flex;align-items:flex-start;justify-content:space-between;gap:10px}
    .asset-hub-icon{width:54px;height:54px;display:flex;align-items:center;justify-content:center;border-radius:13px;background:linear-gradient(135deg,#eff6ff,#f8fafc);border:1px solid #e2e8f0;font-size:29px;box-shadow:inset 0 1px 0 rgba(255,255,255,.9)}
    .asset-hub-links{display:flex;flex-direction:column;align-items:flex-end;gap:4px;font-size:10px}
    .asset-hub-link{color:#2563eb;text-decoration:none;font-weight:700;white-space:nowrap}
    .asset-hub-link:hover{text-decoration:underline;color:#1d4ed8}
    .asset-hub-link.disabled{color:#94a3b8;cursor:default}
    .asset-hub-title{margin-top:9px;color:#1e293b;font-size:13px;font-weight:800}
    .asset-hub-desc{margin-top:3px;color:#64748b;font-size:10.5px;line-height:1.45}
    .asset-hub-badge{margin-top:auto;padding-top:9px;color:#94a3b8;font-size:9px;font-weight:700}
    .asset-hub-card.active .asset-hub-badge{color:#2563eb}
    @media(max-width:1000px){.asset-hub-grid{grid-template-columns:repeat(3,minmax(0,1fr))}}
    @media(max-width:720px){.asset-hub-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:13px}.asset-hub-card{min-height:138px}}
    @media(max-width:480px){.asset-hub-grid{grid-template-columns:1fr}.asset-hub-card{min-height:125px}}
</style>

