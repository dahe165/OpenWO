<style>
    .asset-detail-page{max-width:820px;margin:0 auto}.asset-detail-head{display:flex;align-items:flex-start;justify-content:space-between;gap:15px;margin-bottom:20px}.asset-detail-head h1{margin:0;color:#111827;font-size:1.55rem}.asset-detail-head p{margin:6px 0 0;color:#64748b;font-size:.84rem}.asset-detail-actions{display:flex;gap:8px}.asset-detail-btn{display:inline-flex;align-items:center;justify-content:center;min-height:36px;padding:0 12px;border-radius:9px;text-decoration:none;font-size:11px;font-weight:800}.asset-edit{background:#eff6ff;color:#2563eb}.asset-back{background:#f1f5f9;color:#475569}.asset-card{background:#fff;border:1px solid #e5e7eb;border-radius:14px;box-shadow:0 3px 14px rgba(15,23,42,.045);overflow:hidden}.asset-identity{padding:20px;border-bottom:1px solid #eef2f7}.asset-code{color:#2563eb;font-size:11px;font-weight:800;letter-spacing:.04em}.asset-name{margin-top:4px;color:#111827;font-size:1.25rem;font-weight:800}.asset-status{display:inline-flex;margin-top:10px;padding:5px 9px;border-radius:999px;background:#ecfdf5;color:#047857;font-size:10px;font-weight:800}.asset-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0}.asset-item{padding:15px 20px;border-bottom:1px solid #f1f5f9}.asset-item:nth-child(odd){border-right:1px solid #f1f5f9}.asset-label{color:#94a3b8;font-size:9px;font-weight:800;text-transform:uppercase;letter-spacing:.04em}.asset-value{margin-top:4px;color:#334155;font-size:12px;line-height:1.45}.asset-note{padding:18px 20px;color:#475569;font-size:12px;line-height:1.6}.asset-note strong{display:block;margin-bottom:5px;color:#64748b;font-size:10px;text-transform:uppercase}@media(max-width:650px){.asset-detail-head{flex-direction:column}.asset-detail-actions{width:100%}.asset-detail-btn{flex:1}.asset-grid{grid-template-columns:1fr}.asset-item:nth-child(odd){border-right:0}}
</style>

<div class="asset-detail-page">
    <div class="asset-detail-head">
        <div>
            <h1>Detail Asset</h1>
            <p>Informasi dasar perangkat IT.</p>
        </div>
        <div class="asset-detail-actions">
            <a href="/admin/assets/list" class="asset-detail-btn asset-back">← Kembali</a>
            <a href="/admin/assets/<%= asset.id %>/edit" class="asset-detail-btn asset-edit">Edit Asset</a>
        </div>
    </div>

    <div class="asset-card">
        <div class="asset-identity">
            <div class="asset-code"><%= asset.kode %></div>
            <div class="asset-name"><%= asset.nama %></div>
            <span class="asset-status"><%= asset.status %></span>
        </div>

        <div class="asset-grid">
            <div class="asset-item"><div class="asset-label">Jenis Asset</div><div class="asset-value"><%= asset.jenis || '—' %></div></div>
            <div class="asset-item"><div class="asset-label">Merk</div><div class="asset-value"><%= asset.merk || '—' %></div></div>
            <div class="asset-item"><div class="asset-label">Model</div><div class="asset-value"><%= asset.model || '—' %></div></div>
            <div class="asset-item"><div class="asset-label">Serial Number</div><div class="asset-value"><%= asset.serial_number || '—' %></div></div>
            <div class="asset-item"><div class="asset-label">Bagian</div><div class="asset-value"><%= asset.department_nama || '—' %></div></div>
            <div class="asset-item"><div class="asset-label">Seksi</div><div class="asset-value"><%= asset.section_nama || '—' %></div></div>
            <div class="asset-item"><div class="asset-label">Lokasi</div><div class="asset-value"><%= asset.lokasi || '—' %></div></div>
            <div class="asset-item"><div class="asset-label">Dibuat</div><div class="asset-value"><%= asset.created_at || '—' %></div></div>
        </div>

        <div class="asset-note">
            <strong>Keterangan</strong>
            <%= asset.keterangan || 'Belum ada keterangan.' %>
        </div>
    </div>
</div>
