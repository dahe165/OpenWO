<style>
    .asset-page{max-width:1100px;margin:0 auto}
    .asset-head{display:flex;align-items:flex-start;justify-content:space-between;gap:16px;margin-bottom:22px}
    .asset-head h1{margin:0;color:#111827;font-size:1.7rem;font-weight:700}
    .asset-head p{margin:7px 0 0;color:#6b7280;font-size:.88rem}
    .asset-add{display:inline-flex;align-items:center;justify-content:center;min-height:40px;padding:0 15px;border-radius:10px;background:#2563eb;color:#fff;text-decoration:none;font-size:12px;font-weight:700;white-space:nowrap}
    .asset-add:hover{background:#1d4ed8;color:#fff}
    .asset-tools{display:grid;grid-template-columns:1fr 190px;gap:10px;margin-bottom:16px}
    .asset-search,.asset-filter{width:100%;box-sizing:border-box;min-height:42px;padding:0 13px;border:1px solid #dbe3ef;border-radius:10px;background:#fff;color:#1e293b;font:inherit;font-size:13px;outline:0}
    .asset-search:focus,.asset-filter:focus{border-color:#93c5fd;box-shadow:0 0 0 3px rgba(37,99,235,.08)}
    .asset-table-wrap{overflow:auto;background:#fff;border:1px solid #e5e7eb;border-radius:14px;box-shadow:0 3px 14px rgba(15,23,42,.045)}
    .asset-table{width:100%;min-width:760px;border-collapse:collapse}
    .asset-table th{padding:12px 14px;background:#f8fafc;border-bottom:1px solid #e5e7eb;color:#64748b;font-size:10px;font-weight:800;text-align:left;text-transform:uppercase;letter-spacing:.03em}
    .asset-table td{padding:13px 14px;border-bottom:1px solid #eef2f7;color:#334155;font-size:12px;vertical-align:middle}
    .asset-table tr:last-child td{border-bottom:0}
    .asset-code{color:#172554;font-weight:800}.asset-name{color:#111827;font-weight:700}.asset-muted{color:#64748b;font-size:11px;margin-top:2px}
    .asset-status{display:inline-flex;align-items:center;padding:5px 8px;border-radius:999px;font-size:10px;font-weight:700;white-space:nowrap}
    .asset-status.active{background:#ecfdf5;color:#047857}.asset-status.inactive{background:#f1f5f9;color:#64748b}.asset-status.warning{background:#fff7ed;color:#c2410c}.asset-status.maintenance{background:#eff6ff;color:#2563eb}
    .asset-action{display:inline-flex;align-items:center;justify-content:center;min-height:30px;padding:0 9px;border-radius:8px;background:#eff6ff;color:#2563eb;text-decoration:none;font-size:10px;font-weight:700}
    .asset-action:hover{background:#dbeafe;color:#1d4ed8}
    .asset-empty{padding:42px 20px;text-align:center;color:#64748b;font-size:12px}
    .asset-footer{margin-top:9px;color:#64748b;font-size:11px}
    @media(max-width:700px){.asset-head{flex-direction:column}.asset-add{align-self:flex-start}.asset-tools{grid-template-columns:1fr}.asset-table-wrap{border-radius:12px}}
</style>

<div class="asset-page">
    <div class="asset-head">
        <div>
            <h1>🖥 Asset Management</h1>
            <p>Kelola perangkat IT yang digunakan dalam organisasi.</p>
        </div>
        <a href="/admin/assets/create" class="asset-add">+ Tambah Asset</a>
    </div>

    <div class="asset-tools">
        <input id="assetSearch" class="asset-search" type="search" placeholder="Cari kode, nama, merk, serial number, lokasi..." autocomplete="off">
        <select id="assetStatus" class="asset-filter">
            <option value="">Semua Status</option>
            <% statuses.forEach(status => { %>
                <option value="<%= status %>"><%= status %></option>
            <% }) %>
        </select>
    </div>

    <div class="asset-table-wrap">
        <% if (assets.length === 0) { %>
            <div class="asset-empty">
                Belum ada Asset yang terdaftar.<br>
                Tambahkan Asset pertama untuk memulai.
            </div>
        <% } else { %>
            <table class="asset-table">
                <thead>
                    <tr>
                        <th>Asset</th>
                        <th>Jenis</th>
                        <th>Bagian / Seksi</th>
                        <th>Lokasi</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody id="assetRows">
                    <% assets.forEach(asset => { %>
                        <tr class="asset-row"
                            data-search="<%= [asset.kode,asset.nama,asset.jenis,asset.merk,asset.model,asset.serial_number,asset.lokasi,asset.department_nama,asset.section_nama].filter(Boolean).join(' ').toLowerCase() %>"
                            data-status="<%= asset.status %>">
                            <td>
                                <div class="asset-code"><%= asset.kode %></div>
                                <div class="asset-name"><%= asset.nama %></div>
                                <% if (asset.merk || asset.model) { %>
                                    <div class="asset-muted"><%= [asset.merk,asset.model].filter(Boolean).join(' · ') %></div>
                                <% } %>
                            </td>
                            <td><%= asset.jenis || '—' %></td>
                            <td>
                                <div><%= asset.department_nama || '—' %></div>
                                <div class="asset-muted"><%= asset.section_nama || '—' %></div>
                            </td>
                            <td><%= asset.lokasi || '—' %></td>
                            <td>
                                <span class="asset-status <%= asset.status === 'Aktif' ? 'active' : asset.status === 'Tidak Aktif' ? 'inactive' : asset.status === 'Rusak' ? 'warning' : 'maintenance' %>">
                                    <%= asset.status %>
                                </span>
                            </td>
                            <td><a class="asset-action" href="/admin/assets/<%= asset.id %>">Detail</a></td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
            <div id="assetNoResult" class="asset-empty" style="display:none">Tidak ada Asset yang cocok dengan pencarian.</div>
        <% } %>
    </div>

    <div class="asset-footer">Total: <strong><%= assets.length %></strong> Asset</div>
</div>

<script>
(function(){
    const search = document.getElementById("assetSearch");
    const status = document.getElementById("assetStatus");
    const rows = Array.from(document.querySelectorAll(".asset-row"));
    const noResult = document.getElementById("assetNoResult");

    if (!search || !status) return;

    function applyFilter(){
        const q = (search.value || "").trim().toLowerCase();
        const selected = status.value;
        let visible = 0;

        rows.forEach(row => {
            const matchesText = !q || (row.dataset.search || "").includes(q);
            const matchesStatus = !selected || row.dataset.status === selected;
            row.style.display = matchesText && matchesStatus ? "" : "none";
            if (matchesText && matchesStatus) visible++;
        });

        if (noResult) noResult.style.display = visible ? "none" : "block";
    }

    search.addEventListener("input", applyFilter);
    status.addEventListener("change", applyFilter);
})();
</script>
