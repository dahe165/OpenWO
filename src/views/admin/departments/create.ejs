
<style>
    .department-page{max-width:1180px;margin:0 auto}
    .dp-head{display:flex;justify-content:space-between;align-items:flex-start;gap:20px;margin-bottom:18px}
    .dp-head h1{margin:0;color:#172554;font-size:26px;line-height:1.25}
    .dp-head p{margin:6px 0 0;color:#64748b;font-size:13px}
    .dp-add,.dp-btn{display:inline-flex;align-items:center;justify-content:center;gap:7px;min-height:40px;padding:0 15px;border-radius:10px;text-decoration:none;font-size:12px;font-weight:700;cursor:pointer}
    .dp-add{border:1px solid #2563eb;background:#2563eb;color:#fff;box-shadow:0 4px 12px rgba(37,99,235,.16)}
    .dp-add:hover{background:#1d4ed8}

    .dp-tools{display:flex;gap:12px;margin-bottom:18px}
    .dp-search{flex:1;min-height:42px;box-sizing:border-box;padding:0 13px;border:1px solid #dbe3ef;border-radius:10px;background:#fff;color:#1e293b;font:inherit;font-size:13px;outline:0}
    .dp-search:focus{border-color:#93c5fd;box-shadow:0 0 0 3px rgba(37,99,235,.08)}

    .dept-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}
    .dept-card{padding:18px;border:1px solid #dfe7f1;border-radius:14px;background:#fff;box-shadow:0 3px 14px rgba(15,23,42,.045);transition:.16s}
    .dept-card:hover{border-color:#bfdbfe;box-shadow:0 6px 18px rgba(37,99,235,.07);transform:translateY(-1px)}
    .dept-top{display:flex;align-items:flex-start;gap:13px}
    .dept-mark{width:52px;height:52px;flex:0 0 52px;display:flex;align-items:center;justify-content:center;border-radius:12px;background:#dbeafe;color:#2563eb;font-size:17px;font-weight:800}
    .dept-main{min-width:0;flex:1}
    .dept-code{color:#64748b;font-size:11px;font-weight:800;letter-spacing:.3px}
    .dept-name{margin-top:3px;color:#172554;font-size:16px;font-weight:800;line-height:1.35}
    .dept-status{display:inline-flex;align-items:center;gap:5px;padding:5px 8px;border-radius:999px;font-size:10px;font-weight:700;white-space:nowrap}
    .dept-status.active{background:#ecfdf5;color:#047857}.dept-status.inactive{background:#f1f5f9;color:#64748b}
    .dept-dot{width:6px;height:6px;border-radius:50%;background:currentColor}
    .dept-divider{height:1px;margin:16px 0;background:#edf2f7}
    .dept-description{color:#64748b;font-size:11px;line-height:1.5}
    .dept-actions{display:flex;justify-content:flex-end;gap:7px;margin-top:15px}
    .dp-btn{min-height:34px;padding:0 11px;border:1px solid transparent;border-radius:8px;background:#f8fafc;color:#334155;font-size:10px}
    .dp-edit{background:#eff6ff;color:#2563eb}.dp-edit:hover{background:#dbeafe}
    .dp-toggle{border-color:#e2e8f0}.dp-toggle:hover{background:#f1f5f9}
    .dp-empty{padding:35px;text-align:center;border:1px dashed #cbd5e1;border-radius:12px;background:#fff;color:#64748b;font-size:12px}
    .dp-footer{margin-top:16px;color:#64748b;font-size:11px}
    .dp-no-result{display:none;padding:28px;text-align:center;border:1px dashed #cbd5e1;border-radius:12px;background:#f8fafc;color:#64748b;font-size:12px}

    .department-form-page{max-width:1180px;margin:0 auto}
    .df-back{display:inline-flex;align-items:center;gap:7px;margin-bottom:12px;color:#2563eb;text-decoration:none;font-size:12px;font-weight:600}
    .df-back:hover{text-decoration:underline}
    .df-head{margin-bottom:20px}.df-head h1{margin:0;color:#172554;font-size:28px;line-height:1.2}
    .df-head p{margin:7px 0 0;color:#64748b;font-size:13px}
    .df-layout{display:grid;grid-template-columns:390px minmax(0,1fr);gap:20px}
    .df-info,.df-data{border:1px solid #dfe7f1;border-radius:14px;background:#fff;box-shadow:0 3px 14px rgba(15,23,42,.045)}
    .df-info{padding:24px}.df-data{padding:26px}
    .df-info-title{display:flex;align-items:center;gap:12px;margin-bottom:24px}
    .df-info-icon{width:48px;height:48px;display:flex;align-items:center;justify-content:center;border-radius:12px;background:#dbeafe;color:#2563eb;font-size:22px}
    .df-info-title h2{margin:0;color:#172554;font-size:20px}.df-info-title p{margin:3px 0 0;color:#64748b;font-size:12px}
    .df-item{display:grid;grid-template-columns:48px 1fr;gap:12px;margin-bottom:20px}
    .df-number{width:38px;height:38px;display:flex;align-items:center;justify-content:center;border-radius:10px;background:#eff6ff;color:#2563eb;font-size:14px;font-weight:800}
    .df-item h3{margin:0 0 4px;color:#172554;font-size:13px}.df-item p{margin:0;color:#64748b;font-size:12px;line-height:1.55}
    .df-tip{padding:14px 15px;border-radius:12px;background:#eff6ff;color:#475569;font-size:11px;line-height:1.55}
    .df-tip strong{display:block;margin-bottom:3px;color:#2563eb;font-size:12px}
    .df-data-head{margin-bottom:22px}.df-data-head h2{margin:0;color:#172554;font-size:21px}.df-data-head p{margin:5px 0 0;color:#64748b;font-size:12px}
    .df-group{margin-bottom:18px}.df-group label{display:block;margin-bottom:7px;color:#172554;font-size:12px;font-weight:700}.required{color:#dc2626}
    .df-input{width:100%;min-height:44px;box-sizing:border-box;padding:0 12px;border:1px solid #d5dfeb;border-radius:10px;background:#fff;color:#1e293b;font:inherit;font-size:13px;outline:0}
    .df-input:focus{border-color:#93c5fd;box-shadow:0 0 0 3px rgba(37,99,235,.08)}.df-input::placeholder{color:#94a3b8}
    .df-help{display:block;margin-top:6px;color:#64748b;font-size:11px;line-height:1.4}
    .df-actions{display:flex;justify-content:flex-end;gap:10px;padding-top:20px;margin-top:22px;border-top:1px solid #e8eef5}
    .df-btn{min-height:40px;padding:0 16px;border-radius:9px;font:inherit;font-size:12px;font-weight:700;cursor:pointer}
    .df-cancel{border:1px solid #dbe3ef;background:#fff;color:#475569;text-decoration:none}.df-cancel:hover{background:#f8fafc}
    .df-primary{border:1px solid #2563eb;background:#2563eb;color:#fff;box-shadow:0 4px 12px rgba(37,99,235,.16)}.df-primary:hover{background:#1d4ed8}
    @media(max-width:900px){.dept-grid{grid-template-columns:1fr}.df-layout{grid-template-columns:1fr}}
    @media(max-width:600px){.dp-head{flex-direction:column}.dp-add{align-self:flex-start}.dept-card{padding:15px}.df-info,.df-data{padding:18px}.df-head h1{font-size:24px}.df-actions{flex-direction:column-reverse}.df-btn{width:100%}}
</style>

<div class="department-form-page">
    <a href="/admin/departments" class="df-back">← Kembali ke Master Bagian</a>

    <div class="df-head">
        <h1>Tambah Bagian</h1>
        <p>Tambahkan Bagian baru ke dalam struktur organisasi OpenWO.</p>
    </div>

    <div class="df-layout">
        <aside class="df-info">
            <div class="df-info-title">
                <div class="df-info-icon">⌘</div>
                <div><h2>Informasi</h2><p>Beberapa hal yang perlu diperhatikan.</p></div>
            </div>

            <div class="df-item">
                <div class="df-number">1</div>
                <div><h3>Kode Bagian</h3><p>Gunakan kode singkat dan unik agar Bagian mudah dikenali. Contoh: IT, KDA, HB.</p></div>
            </div>

            <div class="df-item">
                <div class="df-number">2</div>
                <div><h3>Nama Bagian</h3><p>Gunakan nama resmi sesuai struktur organisasi perusahaan. Contoh: Teknologi Informasi.</p></div>
            </div>

            <div class="df-item">
                <div class="df-number">3</div>
                <div><h3>Struktur Organisasi</h3><p>Bagian menjadi induk bagi beberapa Seksi yang dikelola melalui Master Seksi.</p></div>
            </div>

            <div class="df-tip"><strong>💡 Tips</strong>Gunakan kode dan nama yang konsisten dengan dokumen struktur organisasi perusahaan.</div>
        </aside>

        <section class="df-data">
            <div class="df-data-head">
                <h2>Data Bagian</h2>
                <p>Lengkapi informasi Bagian berikut.</p>
            </div>

            <form method="POST" action="/admin/departments">
                <div class="df-group">
                    <label for="kode">Kode Bagian <span class="required">*</span></label>
                    <input type="text" id="kode" name="kode" class="df-input"
                           maxlength="30" required autocomplete="off" placeholder="Contoh: IT">
                    <small class="df-help">Kode singkat untuk identitas Bagian.</small>
                </div>

                <div class="df-group">
                    <label for="nama">Nama Bagian <span class="required">*</span></label>
                    <input type="text" id="nama" name="nama" class="df-input"
                           maxlength="100" required autocomplete="off"
                           placeholder="Contoh: Teknologi Informasi">
                    <small class="df-help">Nama resmi Bagian dalam struktur organisasi.</small>
                </div>

                <div class="df-actions">
                    <a href="/admin/departments" class="df-btn df-cancel">Batal</a>
                    <button type="submit" class="df-btn df-primary">✓ Simpan Bagian</button>
                </div>
            </form>
        </section>
    </div>
</div>
