<div class="admin-user-form">

    <div class="form-header">

        <a
            href="/admin/users"
            class="back-link"
        >
            ← Kembali
        </a>

        <h1>
            Tambah Pengguna
        </h1>

        <p>
            Tambahkan akun pengguna baru ke OpenWO.
        </p>

    </div>


    <form
        action="/admin/users"
        method="POST"
        class="user-form"
    >


        <!-- NAMA LENGKAP -->

        <div class="form-group">

            <label for="nama">
                Nama Lengkap
            </label>

            <input
                type="text"
                id="nama"
                name="nama"
                placeholder="Contoh: Andi Saputra"
                required
                autocomplete="name"
            >

        </div>


        <!-- USERNAME -->

        <div class="form-group">

            <label for="username">
                Username
            </label>

            <input
                type="text"
                id="username"
                name="username"
                placeholder="Contoh: andi"
                required
                autocomplete="username"
            >

            <small>
                Username digunakan untuk masuk ke OpenWO.
            </small>

        </div>


        <!-- ROLE -->

        <div class="form-group">

            <label for="role">
                Role
            </label>

            <select
                id="role"
                name="role"
                required
            >

                <option value="">
                    Pilih Role
                </option>

                <option value="pelapor">
                    Pelapor
                </option>

                <option value="teknisi">
                    Teknisi
                </option>

                <option value="asman">
                    Asman
                </option>

                <option value="manager">
                    Manager
                </option>

                <option value="admin">
                    Admin
                </option>

            </select>

        </div>

        <!-- MASTER BAGIAN -->


        <!-- MASTER BAGIAN -->

        <div class="form-group">

            <label for="department_id">
                Master Bagian
            </label>

            <select
                id="department_id"
                name="department_id"
                required
            >

                <option value="">
                    -- Pilih Bagian --
                </option>

                <% departments.forEach(department => { %>

                    <option
                        value="<%= department.id %>"
                    >
                        <%= department.kode %>
                        -
                        <%= department.nama %>
                    </option>

                <% }) %>

            </select>

            <small>
                Bagian organisasi utama pengguna.
            </small>

        </div>


        <!-- MASTER SEKSI -->

        <div class="form-group">

            <label for="section_id">
                Master Seksi
            </label>

            <select
                id="section_id"
                name="section_id"
            >

                <option value="">
                    -- Pilih Seksi --
                </option>

                <% sections.forEach(section => { %>

                    <option
                        value="<%= section.id %>"
                        data-department-id="<%= section.department_id %>"
                    >
                        <%= section.kode %>
                        -
                        <%= section.nama %>
                    </option>

                <% }) %>

            </select>

            <small>
                Seksi berdasarkan Bagian yang dipilih.
            </small>

        </div>


        <!-- ACTION -->

        <div class="form-actions">

            <a
                href="/admin/users"
                class="btn-cancel"
            >
                Batal
            </a>

            <button
                type="submit"
                class="btn-save"
            >
                Simpan Pengguna
            </button>

        </div>

    </form>

</div>


<style>

.admin-user-form {

    width: 100%;

    max-width: 650px;

    margin: 0 auto;

}


.form-header {

    margin-bottom: 22px;

}


.back-link {

    display: inline-block;

    margin-bottom: 14px;

    color: #2563eb;

    text-decoration: none;

    font-size: 13px;

}


.form-header h1 {

    margin: 0;

    font-size: 22px;

}


.form-header p {

    margin: 6px 0 0;

    color: #777;

    font-size: 13px;

}


.user-form {

    padding: 22px;

    background: white;

    border: 1px solid #e5e7eb;

    border-radius: 14px;

}


.form-group {

    margin-bottom: 18px;

}


.form-group label {

    display: block;

    margin-bottom: 7px;

    font-size: 13px;

    font-weight: 600;

    color: #1f2937;

}


.form-group input,
.form-group select {

    width: 100%;

    box-sizing: border-box;

    padding: 11px 12px;

    border: 1px solid #d1d5db;

    border-radius: 9px;

    background: white;

    color: #111827;

    font-size: 14px;

    outline: none;

}


.form-group input:focus,
.form-group select:focus {

    border-color: #2563eb;

    box-shadow:
        0 0 0 3px
        rgba(37, 99, 235, 0.10);

}


.form-group small {

    display: block;

    margin-top: 5px;

    color: #888;

    font-size: 11px;

}


.form-actions {

    display: flex;

    justify-content: flex-end;

    gap: 8px;

    margin-top: 25px;

}


.btn-cancel,
.btn-save {

    display: inline-flex;

    align-items: center;

    justify-content: center;

    padding: 10px 15px;

    border-radius: 9px;

    font-size: 13px;

    font-weight: 600;

    text-decoration: none;

    cursor: pointer;

}


.btn-cancel {

    background: #f3f4f6;

    color: #374151;

}


.btn-save {

    border: 0;

    background: #2563eb;

    color: white;

}


@media (max-width: 600px) {

    .user-form {

        padding: 17px;

    }


    .form-header h1 {

        font-size: 19px;

    }


    .form-actions {

        flex-direction: column-reverse;

    }


    .btn-cancel,
    .btn-save {

        width: 100%;

    }

}

</style>

<script>
document.addEventListener("DOMContentLoaded", function () {

    const roleSelect =
        document.getElementById("role");

    const departmentSelect =
        document.getElementById("department_id");

    const sectionSelect =
        document.getElementById("section_id");


    /*
     * =====================================
     * SEKSI WAJIB UNTUK ASMAN
     * =====================================
     */

    function updateSectionRequirement() {

        const requiresSection =
            roleSelect.value === "asman" ||
            roleSelect.value === "teknisi";

        sectionSelect.required =
            requiresSection;
    }


    /*
     * =====================================
     * FILTER SEKSI BERDASARKAN BAGIAN
     * =====================================
     */

    const sectionOptions =
        Array.from(sectionSelect.options);


    function filterSections() {

        const departmentId =
            departmentSelect.value;


        sectionOptions.forEach(option => {

            // Option kosong selalu ditampilkan
            if (!option.value) {

                option.hidden = false;

                return;
            }


            // Tampilkan hanya Seksi
            // milik Bagian yang dipilih
            option.hidden =
                option.dataset.departmentId !==
                departmentId;

        });


        /*
         * Jika Seksi yang sedang dipilih
         * bukan milik Bagian baru,
         * kosongkan pilihan.
         */

        const selectedOption =
            sectionSelect.options[
                sectionSelect.selectedIndex
            ];


        if (
            selectedOption &&
            selectedOption.value &&
            selectedOption.dataset.departmentId !==
                departmentId
        ) {

            sectionSelect.value = "";

        }

    }


    /*
     * =====================================
     * EVENT
     * =====================================
     */

    roleSelect.addEventListener(
        "change",
        updateSectionRequirement
    );


    departmentSelect.addEventListener(
        "change",
        filterSections
    );


    /*
     * =====================================
     * INITIAL STATE
     * =====================================
     */

    updateSectionRequirement();

    filterSections();

});
</script>