<div class="page-container">

    <div class="page-header">

        <div>

            <h1>Tambah Hari Khusus</h1>

            <p>
                Tambahkan hari libur atau hari kerja khusus.
            </p>

        </div>

    </div>


    <div class="calendar-card">

        <form
            method="POST"
            action="/admin/business-calendar/exception"
        >


            <!-- TANGGAL -->

            <div class="form-group">

                <label for="tanggal">
                    Tanggal
                </label>

                <input
                    type="date"
                    id="tanggal"
                    name="tanggal"
                    required
                >

            </div>


            <!-- TIPE -->

            <div class="form-group">

                <label>
                    Jenis Hari
                </label>


                <div class="exception-type-options">

                    <label class="exception-option">

                        <input
                            type="radio"
                            name="tipe"
                            value="LIBUR"
                            checked
                        >

                        <span>
                            🟥 Hari Libur
                        </span>

                    </label>


                    <label class="exception-option">

                        <input
                            type="radio"
                            name="tipe"
                            value="KHUSUS"
                        >

                        <span>
                            🟡 Hari Kerja Khusus
                        </span>

                    </label>

                </div>

            </div>


            <!-- NAMA -->

            <div class="form-group">

                <label for="nama">
                    Nama
                </label>

                <input
                    type="text"
                    id="nama"
                    name="nama"
                    placeholder="Contoh: Hari Kemerdekaan"
                    maxlength="100"
                    required
                >

            </div>


            <!-- JAM KHUSUS -->

            <div
                id="special-hours"
                class="special-hours"
                hidden
            >

                <div class="form-row">

                    <div class="form-group">

                        <label for="jam_mulai">
                            Jam Mulai
                        </label>

                        <input
                            type="time"
                            id="jam_mulai"
                            name="jam_mulai"
                        >

                    </div>


                    <div class="form-group">

                        <label for="jam_selesai">
                            Jam Selesai
                        </label>

                        <input
                            type="time"
                            id="jam_selesai"
                            name="jam_selesai"
                        >

                    </div>

                </div>

            </div>


            <!-- KETERANGAN -->

            <div class="form-group">

                <label for="keterangan">
                    Keterangan
                </label>

                <textarea
                    id="keterangan"
                    name="keterangan"
                    rows="4"
                    maxlength="500"
                    placeholder="Keterangan tambahan..."
                ></textarea>

            </div>


            <!-- ACTION -->

            <div class="form-actions">

                <a
                    href="/admin/business-calendar"
                    class="btn-secondary"
                >
                    Batal
                </a>


                <button
                    type="submit"
                    class="btn-primary"
                >
                    Simpan
                </button>

            </div>


        </form>

    </div>

</div>


<script>

    const typeInputs =
        document.querySelectorAll(
            'input[name="tipe"]'
        );


    const specialHours =
        document.getElementById(
            "special-hours"
        );


    const jamMulai =
        document.getElementById(
            "jam_mulai"
        );


    const jamSelesai =
        document.getElementById(
            "jam_selesai"
        );


    function updateExceptionForm() {

        const selected =
            document.querySelector(
                'input[name="tipe"]:checked'
            );


        if (
            selected &&
            selected.value === "KHUSUS"
        ) {

            specialHours.hidden = false;

            jamMulai.required = true;
            jamSelesai.required = true;

        } else {

            specialHours.hidden = true;

            jamMulai.required = false;
            jamSelesai.required = false;

            jamMulai.value = "";
            jamSelesai.value = "";

        }

    }


    typeInputs.forEach(
        input => {

            input.addEventListener(
                "change",
                updateExceptionForm
            );

        }
    );


    updateExceptionForm();

</script>