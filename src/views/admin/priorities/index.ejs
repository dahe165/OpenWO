<style>
    /* =====================================================
       PRIORITY INDEX
       ===================================================== */

    .priority-page {
        max-width: 1100px;
        margin: 0 auto;
    }

    .priority-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 20px;
        margin-bottom: 24px;
    }

    .priority-title {
        margin: 0;
        font-size: 1.7rem;
        font-weight: 700;
        color: #111827;
    }

    .priority-description {
        margin: 7px 0 0;
        color: #6b7280;
    }

    .priority-add {
        white-space: nowrap;
    }


    /* =====================================================
       LIST
       ===================================================== */

    .priority-list {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }


    /* =====================================================
       CARD
       ===================================================== */

    .priority-card {
        display: flex;
        align-items: center;
        gap: 16px;

        padding: 18px 20px;

        background: white;
        border: 1px solid #e5e7eb;
        border-radius: 14px;

        box-shadow:
            0 3px 14px rgba(0, 0, 0, .04);
    }


    /* =====================================================
       ORDER
       ===================================================== */

    .priority-order {
        width: 42px;
        height: 42px;

        display: flex;
        align-items: center;
        justify-content: center;

        flex-shrink: 0;

        border-radius: 10px;

        background: #f3f4f6;

        color: #374151;

        font-size: .85rem;
        font-weight: 700;
    }


    /* =====================================================
       ICON
       ===================================================== */

    .priority-icon {
        font-size: 1.35rem;
        flex-shrink: 0;
    }


    /* =====================================================
       CONTENT
       ===================================================== */

    .priority-content {
        flex: 1;
        min-width: 0;
    }

    .priority-name {
        margin: 0 0 4px;

        color: #111827;

        font-size: 1rem;
        font-weight: 700;
    }

    .priority-meta {
        color: #6b7280;
        font-size: .8rem;
    }


    /* =====================================================
       STATUS
       ===================================================== */

    .priority-status {
        flex-shrink: 0;

        font-size: .78rem;
        font-weight: 700;
    }

    .priority-status.active {
        color: #047857;
    }

    .priority-status.inactive {
        color: #6b7280;
    }


    /* =====================================================
       ACTIONS
       ===================================================== */

    .priority-actions {
        display: flex;
        align-items: center;
        gap: 8px;

        flex-shrink: 0;
    }


    /* =====================================================
       EMPTY STATE
       ===================================================== */

    .priority-empty {
        padding: 50px 20px;

        text-align: center;

        background: white;

        border: 1px dashed #d1d5db;
        border-radius: 14px;

        color: #6b7280;
    }

    .priority-empty-icon {
        margin-bottom: 10px;
        font-size: 2rem;
    }

    .priority-empty-title {
        margin-bottom: 5px;

        color: #374151;

        font-weight: 700;
    }


    /* =====================================================
       MOBILE
       ===================================================== */

    @media (max-width: 700px) {

        .priority-header {
            flex-direction: column;
        }

        .priority-add {
            width: 100%;
        }

        .priority-card {
            align-items: flex-start;
            flex-wrap: wrap;
        }

        .priority-content {
            min-width: calc(100% - 110px);
        }

        .priority-status {
            margin-left: 58px;
        }

        .priority-actions {
            width: 100%;
            margin-left: 58px;
        }

        .priority-actions .btn {
            flex: 1;
        }

    }
</style>


<div class="priority-page">


    <!-- =================================================
         HEADER
         ================================================= -->

    <div class="priority-header">

        <div>

            <h1 class="priority-title">
                ⚡ Prioritas
            </h1>

            <p class="priority-description">
                Kelola tingkat prioritas Work Order OpenWO.
            </p>

        </div>


        <a
            href="/admin/priorities/create"
            class="btn btn-primary priority-add"
        >
            + Tambah Prioritas
        </a>

    </div>


    <!-- =================================================
         PRIORITY LIST
         ================================================= -->

    <% if (priorities && priorities.length > 0) { %>

        <div class="priority-list">

            <% priorities.forEach(function(priority) { %>

                <div class="priority-card">


                    <!-- URUTAN -->

                    <div class="priority-order">
                        <%= priority.urutan %>
                    </div>


                    <!-- ICON -->

                    <div class="priority-icon">
                        ⚡
                    </div>


                    <!-- CONTENT -->

                    <div class="priority-content">

                        <h2 class="priority-name">
                            <%= priority.nama %>
                        </h2>

                        <div class="priority-meta">
                            Urutan <%= priority.urutan %>
                        </div>

                    </div>


                    <!-- STATUS -->

                    <% if (priority.aktif === 1) { %>

                        <div class="priority-status active">
                            ● Aktif
                        </div>

                    <% } else { %>

                        <div class="priority-status inactive">
                            ● Tidak Aktif
                        </div>

                    <% } %>


                    <!-- ACTIONS -->

                    <div class="priority-actions">


                        <!-- EDIT -->

                        <a
                            href="/admin/priorities/<%= priority.id %>/edit"
                            class="btn btn-sm btn-outline-primary"
                        >
                            Edit
                        </a>


                        <!-- TOGGLE -->

                        <form
                            method="POST"
                            action="/admin/priorities/<%= priority.id %>/toggle"
                            onsubmit="
                                return confirm(
                                    'Ubah status prioritas ini?'
                                );
                            "
                        >

                            <% if (priority.aktif === 1) { %>

                                <button
                                    type="submit"
                                    class="btn btn-sm btn-outline-secondary"
                                >
                                    Nonaktifkan
                                </button>

                            <% } else { %>

                                <button
                                    type="submit"
                                    class="btn btn-sm btn-outline-success"
                                >
                                    Aktifkan
                                </button>

                            <% } %>

                        </form>


                    </div>

                </div>

            <% }); %>

        </div>


    <% } else { %>


        <!-- =================================================
             EMPTY STATE
             ================================================= -->

        <div class="priority-empty">

            <div class="priority-empty-icon">
                ⚡
            </div>

            <div class="priority-empty-title">
                Belum ada prioritas
            </div>

            <div>
                Tambahkan prioritas pertama untuk Work Order.
            </div>

        </div>


    <% } %>


</div>