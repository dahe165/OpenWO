<style>
    /* =====================================================
       MASTER KATEGORI
       Style dibuat scoped agar tidak mengganggu app.ejs
       ===================================================== */

    .category-page {
        max-width: 1200px;
        margin: 0 auto;
    }

    .category-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        margin-bottom: 28px;
    }

    .category-title {
        margin: 0;
        font-size: 1.7rem;
        font-weight: 700;
    }

    .category-description {
        margin: 6px 0 0;
        color: #6b7280;
    }

    .category-add-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 16px;
        border-radius: 10px;
        background: #2563eb;
        color: white;
        text-decoration: none;
        font-weight: 600;
        transition: .2s ease;
    }

    .category-add-btn:hover {
        background: #1d4ed8;
        color: white;
        transform: translateY(-1px);
    }

    .category-grid {
        display: grid;
        grid-template-columns: repeat(
            auto-fit,
            minmax(340px, 1fr)
        );
        gap: 20px;
    }

    .category-card {
        background: white;
        border: 1px solid #e5e7eb;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 4px 18px rgba(0, 0, 0, .05);
        transition: .2s ease;
    }

    .category-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 24px rgba(0, 0, 0, .08);
    }

    .category-card-header {
        padding: 20px;
        border-bottom: 1px solid #eef0f3;
    }

    .category-name-row {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 12px;
    }

    .category-name {
        margin: 0;
        font-size: 1.1rem;
        font-weight: 700;
        color: #111827;
    }

    .category-order {
        margin-top: 5px;
        font-size: .82rem;
        color: #9ca3af;
    }

    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 5px 9px;
        border-radius: 999px;
        font-size: .75rem;
        font-weight: 600;
        white-space: nowrap;
    }

    .status-active {
        background: #ecfdf5;
        color: #047857;
    }

    .status-inactive {
        background: #f3f4f6;
        color: #6b7280;
    }

    .status-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: currentColor;
    }

    .subcategory-section {
        padding: 18px 20px;
    }

    .subcategory-title {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 12px;
        font-size: .86rem;
        font-weight: 700;
        color: #374151;
    }

    .subcategory-count {
        min-width: 24px;
        height: 24px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0 7px;
        border-radius: 999px;
        background: #eff6ff;
        color: #2563eb;
        font-size: .75rem;
    }

    .subcategory-list {
        display: flex;
        flex-direction: column;
        gap: 7px;
    }

    .subcategory-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
        padding: 9px 11px;
        border: 1px solid #eef0f3;
        border-radius: 9px;
        background: #fafafa;
        font-size: .86rem;
    }

    .subcategory-name {
        color: #374151;
    }

    .subcategory-status {
        font-size: .72rem;
        font-weight: 600;
    }

    .subcategory-status.active {
        color: #059669;
    }

    .subcategory-status.inactive {
        color: #9ca3af;
    }

    .empty-subcategory {
        padding: 14px;
        border: 1px dashed #d1d5db;
        border-radius: 10px;
        color: #9ca3af;
        text-align: center;
        font-size: .82rem;
    }

    .category-card-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
        padding: 14px 20px;
        background: #fafafa;
        border-top: 1px solid #eef0f3;
    }

    .category-actions {
        display: flex;
        gap: 8px;
    }

    .category-btn {
        border: 0;
        border-radius: 8px;
        padding: 7px 11px;
        font-size: .78rem;
        font-weight: 600;
        cursor: pointer;
        text-decoration: none;
        transition: .2s ease;
    }

    .category-btn-edit {
        background: #eff6ff;
        color: #2563eb;
    }

    .category-btn-edit:hover {
        background: #dbeafe;
        color: #1d4ed8;
    }

    .category-btn-toggle {
        background: #f3f4f6;
        color: #4b5563;
    }

    .category-btn-toggle:hover {
        background: #e5e7eb;
    }

    .category-total {
        color: #9ca3af;
        font-size: .78rem;
    }

    .category-empty {
        padding: 50px 20px;
        text-align: center;
        background: white;
        border: 1px dashed #d1d5db;
        border-radius: 16px;
        color: #6b7280;
    }


    /* =====================================================
       MOBILE
       ===================================================== */

    @media (max-width: 700px) {

        .category-header {
            align-items: stretch;
            flex-direction: column;
        }

        .category-add-btn {
            justify-content: center;
        }

        .category-grid {
            grid-template-columns: 1fr;
        }

        .category-card-footer {
            align-items: stretch;
            flex-direction: column;
        }

        .category-actions {
            width: 100%;
        }

        .category-btn {
            flex: 1;
            text-align: center;
        }

    }
</style>


<div class="category-page">


    <!-- =================================================
         HEADER
         ================================================= -->

    <div class="category-header">

        <div>

            <h1 class="category-title">
                Master Kategori
            </h1>

            <p class="category-description">
                Kelola kategori dan subkategori Work Order.
            </p>

        </div>


        <a
            href="/admin/categories/create"
            class="category-add-btn"
        >
            <span>＋</span>
            Tambah Kategori
        </a>

    </div>


    <!-- =================================================
         CATEGORY LIST
         ================================================= -->

    <% if (!categories || categories.length === 0) { %>

        <div class="category-empty">

            <div style="font-size: 2rem; margin-bottom: 10px;">
                📂
            </div>

            <strong>
                Belum ada kategori
            </strong>

            <div style="margin-top: 6px;">
                Tambahkan kategori pertama untuk OpenWO.
            </div>

        </div>

    <% } else { %>


        <div class="category-grid">


            <% categories.forEach(category => { %>


                <div class="category-card">


                    <!-- =================================
                         CATEGORY HEADER
                         ================================= -->

                    <div class="category-card-header">

                        <div class="category-name-row">

                            <div>

                                <h2 class="category-name">
                                    <%= category.nama %>
                                </h2>

                                <div class="category-order">
                                    Urutan <%= category.urutan %>
                                </div>

                            </div>


                            <% if (category.aktif) { %>

                                <span class="status-badge status-active">
                                    <span class="status-dot"></span>
                                    Aktif
                                </span>

                            <% } else { %>

                                <span class="status-badge status-inactive">
                                    <span class="status-dot"></span>
                                    Tidak Aktif
                                </span>

                            <% } %>

                        </div>

                    </div>


                    <!-- =================================
                         SUBCATEGORY
                         ================================= -->

                    <div class="subcategory-section">

                        <div class="subcategory-title">

                            <span>
                                Subkategori
                            </span>

                            <span class="subcategory-count">
                                <%= category.subcategories.length %>
                            </span>

                        </div>


                        <% if (
                            category.subcategories &&
                            category.subcategories.length
                        ) { %>


                            <div class="subcategory-list">

                                <% category.subcategories.forEach(
                                    subcategory => {
                                %>

                                    <div class="subcategory-item">

                                        <span class="subcategory-name">
                                            <%= subcategory.nama %>
                                        </span>


                                        <div
                                            style="
                                                display: flex;
                                                align-items: center;
                                                gap: 8px;
                                            "
                                        >

                                            <% if (subcategory.aktif) { %>

                                                <span class="subcategory-status active">
                                                    Aktif
                                                </span>

                                            <% } else { %>

                                                <span class="subcategory-status inactive">
                                                    Tidak Aktif
                                                </span>

                                            <% } %>


                                            <!-- EDIT -->

                                            <a
                                                href="/admin/subcategories/<%= subcategory.id %>/edit"
                                                class="category-btn category-btn-edit"
                                            >
                                                Edit
                                            </a>


                                            <!-- TOGGLE -->

                                            <form
                                                method="POST"
                                                action="/admin/subcategories/<%= subcategory.id %>/toggle"
                                                style="margin: 0;"
                                            >

                                                <button
                                                    type="submit"
                                                    class="category-btn category-btn-toggle"
                                                >
                                                    <%= subcategory.aktif
                                                        ? "Nonaktifkan"
                                                        : "Aktifkan"
                                                    %>
                                                </button>

                                            </form>

                                        </div>

                                    </div>

                                <% }) %>

                            </div>


                        <% } else { %>


                            <div class="empty-subcategory">
                                Belum ada subkategori.
                            </div>


                        <% } %>

                        <!-- =================================
                            TAMBAH SUBKATEGORI
                            ================================= -->

                        <div class="mt-3">

                            <form
                                method="POST"
                                action="/admin/categories/<%= category.id %>/subcategories"
                                class="d-flex gap-2"
                            >

                                <input
                                    type="text"
                                    name="nama"
                                    class="form-control form-control-sm"
                                    placeholder="Nama subkategori..."
                                    required
                                >

                                <input
                                    type="number"
                                    name="urutan"
                                    class="form-control form-control-sm"
                                    value="<%= category.subcategories.length + 1 %>"
                                    min="0"
                                    style="max-width: 80px;"
                                    title="Urutan"
                                >

                                <button
                                    type="submit"
                                    class="btn btn-sm btn-primary"
                                >
                                    + Tambah
                                </button>

                            </form>

                        </div>

                    </div>


                    <!-- =================================
                         FOOTER / ACTION
                         ================================= -->

                    <div class="category-card-footer">

                        <span class="category-total">
                            <%= category.subcategories.length %>
                            subkategori
                        </span>


                        <div class="category-actions">


                            <a
                                href="/admin/categories/<%= category.id %>/edit"
                                class="category-btn category-btn-edit"
                            >
                                Edit
                            </a>


                            <form
                                method="POST"
                                action="/admin/categories/<%= category.id %>/toggle"
                                style="margin: 0;"
                            >

                                <button
                                    type="submit"
                                    class="category-btn category-btn-toggle"
                                >
                                    <%= category.aktif
                                        ? "Nonaktifkan"
                                        : "Aktifkan"
                                    %>
                                </button>

                            </form>


                        </div>

                    </div>


                </div>


            <% }) %>


        </div>


    <% } %>


</div>