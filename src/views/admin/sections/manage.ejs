<style>
.section-manage{max-width:1100px;margin:0 auto}
.category-subcategories{display:flex;flex-wrap:wrap;gap:5px;margin-top:7px}
.category-subcategory{display:inline-flex;align-items:center;min-height:20px;padding:2px 7px;border:1px solid #e2e8f0;border-radius:999px;background:#f8fafc;color:#64748b;font-size:9px;font-weight:600}
.selection-item input:checked+label .category-subcategory{border-color:#bfdbfe;background:#fff;color:#2563eb}
.category-follow-note{margin-top:7px;color:#94a3b8;font-size:10px}
.section-manage-header{display:flex;align-items:flex-start;justify-content:space-between;gap:20px;margin-bottom:22px}.section-manage-title h1{margin:0;font-size:25px;line-height:1.25;color:#1e293b}.section-manage-title p{margin:7px 0 0;color:#64748b;font-size:13px}.section-manage-back{display:inline-flex;align-items:center;gap:7px;padding:9px 13px;border:1px solid #dbe3ef;border-radius:10px;background:#fff;color:#475569;text-decoration:none;font-size:12px;font-weight:600;white-space:nowrap}.section-manage-back:hover{background:#f8fafc;color:#2563eb}.section-identity{display:flex;align-items:center;gap:14px;padding:18px 20px;margin-bottom:18px;background:#fff;border:1px solid #e2e8f0;border-radius:14px;box-shadow:0 3px 12px rgba(15,23,42,.04)}.section-identity-mark{width:44px;height:44px;flex:0 0 44px;display:flex;align-items:center;justify-content:center;border-radius:12px;background:#eff6ff;color:#2563eb;font-size:20px}.section-identity h2{margin:0;font-size:16px;color:#1e293b}.section-identity p{margin:4px 0 0;color:#64748b;font-size:12px}.section-manage-form{display:grid;gap:16px}.section-card{overflow:hidden;background:#fff;border:1px solid #e2e8f0;border-radius:14px;box-shadow:0 3px 12px rgba(15,23,42,.04)}.section-card-head{padding:17px 20px 14px;border-bottom:1px solid #eef2f7}.section-card-head h3{margin:0;font-size:15px;color:#1e293b}.section-card-head p{margin:4px 0 0;color:#64748b;font-size:12px}.section-card-body{padding:18px 20px 20px}.section-label{display:block;margin-bottom:8px;color:#334155;font-size:13px;font-weight:700}.section-field select{width:100%;min-height:42px;padding:0 12px;border:1px solid #dbe3ef;border-radius:10px;background:#fff;color:#1e293b;font:inherit;font-size:13px;outline:none}.section-field select:focus{border-color:#93c5fd;box-shadow:0 0 0 3px rgba(37,99,235,.08)}.section-help{display:block;margin-top:7px;color:#94a3b8;font-size:11px}.selection-count{display:inline-flex;align-items:center;min-height:24px;padding:4px 9px;margin-bottom:11px;border-radius:999px;background:#f1f5f9;color:#64748b;font-size:11px;font-weight:600}.selection-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}.selection-item{position:relative}.selection-item input{position:absolute;opacity:0;pointer-events:none}.selection-item label{min-height:62px;display:flex;align-items:center;gap:11px;padding:11px 13px;border:1px solid #e2e8f0;border-radius:11px;background:#fff;cursor:pointer;transition:.18s ease}.selection-item label:hover{border-color:#bfdbfe;background:#f8fbff}.selection-item input:checked+label{border-color:#93c5fd;background:#eff6ff;box-shadow:inset 0 0 0 1px rgba(37,99,235,.08)}.selection-check{width:18px;height:18px;flex:0 0 18px;display:flex;align-items:center;justify-content:center;border:1px solid #cbd5e1;border-radius:5px;color:transparent;background:#fff;font-size:11px;font-weight:800}.selection-item input:checked+label .selection-check{border-color:#2563eb;background:#2563eb;color:#fff}.selection-main{min-width:0}.selection-main strong{display:block;overflow:hidden;color:#1e293b;font-size:12px;line-height:1.35;text-overflow:ellipsis;white-space:nowrap}.selection-main small{display:block;margin-top:3px;color:#94a3b8;font-size:10px}.section-empty{padding:16px;border:1px dashed #cbd5e1;border-radius:10px;background:#f8fafc;color:#64748b;font-size:12px}.section-actions{display:flex;justify-content:flex-end;gap:9px;padding-top:2px}.section-btn{display:inline-flex;align-items:center;justify-content:center;min-height:40px;padding:0 15px;border-radius:10px;font-size:12px;font-weight:700;text-decoration:none;cursor:pointer}.section-btn-secondary{border:1px solid #dbe3ef;background:#fff;color:#475569}.section-btn-secondary:hover{background:#f8fafc}.section-btn-primary{border:1px solid #2563eb;background:#2563eb;color:#fff;box-shadow:0 4px 12px rgba(37,99,235,.18)}.section-btn-primary:hover{background:#1d4ed8}@media(max-width:900px){.selection-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:640px){.section-manage-header{flex-direction:column;align-items:stretch}.section-manage-back{align-self:flex-start}.selection-grid{grid-template-columns:1fr}.section-card-head,.section-card-body{padding-left:15px;padding-right:15px}.section-actions{flex-direction:column-reverse}.section-btn{width:100%}}
</style>

<div class="section-manage">
  <div class="section-manage-header">
    <div class="section-manage-title"><h1>Kelola Seksi</h1><p>Atur Asman, Teknisi, dan Kategori untuk Seksi ini.</p></div>
    <a href="/admin/sections" class="section-manage-back">← Kembali</a>
  </div>

  <div class="section-identity">
    <div class="section-identity-mark">▣</div>
    <div><h2><%= section.kode %> — <%= section.nama %></h2><p>Bagian: <strong><%= section.department_kode %> — <%= section.department_nama %></strong></p></div>
  </div>

  <form action="/admin/sections/<%= section.id %>/manage" method="POST" class="section-manage-form">
    <section class="section-card">
      <div class="section-card-head"><h3>Asman</h3><p>Penanggung jawab utama Seksi.</p></div>
      <div class="section-card-body"><div class="section-field">
        <label for="asman_id" class="section-label">Asman Penanggung Jawab</label>
        <select id="asman_id" name="asman_id"><option value="">— Pilih Asman —</option>
          <% asmans.forEach(asman => { %><option value="<%= asman.id %>" <%= Number(selectedAsmanId) === Number(asman.id) ? "selected" : "" %>><%= asman.nama %> (@<%= asman.username %>)</option><% }) %>
        </select>
        <small class="section-help">Satu Seksi memiliki satu Asman penanggung jawab.</small>
      </div></div>
    </section>

    <section class="section-card">
      <div class="section-card-head"><h3>Teknisi</h3><p>Pilih Teknisi yang menjadi anggota Seksi ini.</p></div>
      <div class="section-card-body">
        <% if (!technicians || technicians.length === 0) { %><div class="section-empty">Belum ada Teknisi yang dapat ditempatkan pada Seksi ini.</div><% } else { %>
          <div class="selection-count"><%= selectedTechnicianIds.length %> dipilih</div>
          <div class="selection-grid"><% technicians.forEach(technician => { %>
            <div class="selection-item"><input type="checkbox" id="teknisi_<%= technician.id %>" name="teknisi_ids" value="<%= technician.id %>" <%= selectedTechnicianIds.includes(Number(technician.id)) ? "checked" : "" %>>
              <label for="teknisi_<%= technician.id %>"><span class="selection-check">✓</span><span class="selection-main"><strong><%= technician.nama %></strong><small>@<%= technician.username %></small></span></label>
            </div>
          <% }) %></div>
          <small class="section-help">Hanya Teknisi yang dipilih yang menjadi anggota Seksi ini.</small>
        <% } %>
      </div>
    </section>

    <section class="section-card">
      <div class="section-card-head"><h3>Kategori</h3><p>Tentukan kategori pekerjaan yang ditangani Seksi ini.</p></div>
      <div class="section-card-body">
        <% if (!categories || categories.length === 0) { %><div class="section-empty">Belum ada Kategori aktif.</div><% } else { %>
          <div class="selection-count"><%= selectedCategoryIds.length %> dipilih</div>
          <div class="selection-grid"><% categories.forEach(category => { %>
            <div class="selection-item"><input type="checkbox" id="kategori_<%= category.id %>" name="category_ids" value="<%= category.id %>" <%= selectedCategoryIds.includes(Number(category.id)) ? "checked" : "" %>>
              <label for="kategori_<%= category.id %>">
                <span class="selection-check">✓</span>
                <span class="selection-main">
                  <strong><%= category.nama %></strong>
                  <% if (category.subcategories && category.subcategories.length) { %>
                    <span class="category-subcategories">
                      <% category.subcategories.forEach(subcategory => { %>
                        <span class="category-subcategory"><%= subcategory.nama %></span>
                      <% }) %>
                    </span>
                  <% } else { %>
                    <small>Belum ada Subkategori aktif</small>
                  <% } %>
                </span>
              </label>
            </div>
          <% }) %></div>
          <small class="section-help">Pilih Kategori. Seluruh Subkategori aktif di bawahnya otomatis mengikuti Seksi ini.</small>
        <% } %>
      </div>
    </section>

    <div class="section-actions"><a href="/admin/sections" class="section-btn section-btn-secondary">Batal</a><button type="submit" class="section-btn section-btn-primary">Simpan Perubahan</button></div>
  </form>
</div>
