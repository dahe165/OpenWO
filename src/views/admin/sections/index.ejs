<%
    // Kelompokkan Seksi berdasarkan Bagian.
    const grouped = {};

    (sections || []).forEach(section => {
        const id = section.department_id;

        if (!grouped[id]) {
            grouped[id] = {
                id,
                kode: section.department_kode,
                nama: section.department_nama,
                sections: []
            };
        }

        grouped[id].sections.push(section);
    });

    const departments = Object.values(grouped);
    const colors = ["blue", "purple", "green", "orange", "pink", "cyan"];
%>

<style>
    .master-section{max-width:1180px;margin:0 auto}
    .ms-head{display:flex;justify-content:space-between;align-items:flex-start;gap:20px;margin-bottom:18px}
    .ms-head h1{margin:0;color:#172554;font-size:26px;line-height:1.25}
    .ms-head p{margin:6px 0 0;color:#64748b;font-size:13px}
    .ms-add{display:inline-flex;align-items:center;min-height:40px;padding:0 15px;border-radius:10px;background:#2563eb;color:#fff;text-decoration:none;font-size:12px;font-weight:700}
    .ms-add:hover{background:#1d4ed8}

    .ms-tools{display:grid;grid-template-columns:1fr 260px;gap:12px;margin-bottom:18px}
    .ms-search,.ms-filter{width:100%;box-sizing:border-box;min-height:42px;padding:0 13px;border:1px solid #dbe3ef;border-radius:10px;background:#fff;color:#1e293b;font:inherit;font-size:13px;outline:0}
    .ms-search:focus,.ms-filter:focus{border-color:#93c5fd;box-shadow:0 0 0 3px rgba(37,99,235,.08)}

    .dept{overflow:hidden;margin-bottom:16px;border:1px solid #dfe7f1;border-radius:14px;background:#fff;box-shadow:0 3px 14px rgba(15,23,42,.045)}
    .dept-head{display:flex;align-items:center;gap:13px;padding:12px 16px;border-bottom:1px solid #edf2f7;cursor:pointer}
    .dept-mark{width:48px;height:48px;flex:0 0 48px;display:flex;align-items:center;justify-content:center;border-radius:11px;font-size:15px;font-weight:800}
    .blue .dept-mark{background:#dbeafe;color:#2563eb}.purple .dept-mark{background:#f3e8ff;color:#7e22ce}
    .green .dept-mark{background:#dcfce7;color:#15803d}.orange .dept-mark{background:#ffedd5;color:#c2410c}
    .pink .dept-mark{background:#fce7f3;color:#be185d}.cyan .dept-mark{background:#cffafe;color:#0e7490}
    .dept-info{min-width:0;flex:1}.dept-name{color:#172554;font-size:15px;font-weight:800}.dept-meta{margin-top:3px;color:#64748b;font-size:11px}
    .dept-toggle{width:34px;height:34px;border:0;border-radius:9px;background:#f8fafc;color:#334155;cursor:pointer;font-size:16px}
    .dept-body{padding:10px}.section-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}

    .section-card{min-width:0;min-height:138px;padding:13px;box-sizing:border-box;border:1px solid #e2e8f0;border-radius:11px;background:#fff;transition:.16s}
    .section-card:hover{border-color:#bfdbfe;box-shadow:0 4px 12px rgba(37,99,235,.06);transform:translateY(-1px)}
    .section-top{display:flex;justify-content:space-between;align-items:flex-start;gap:10px}
    .section-code{color:#334155;font-size:12px;font-weight:800}
    .status{display:inline-flex;align-items:center;gap:5px;padding:5px 8px;border-radius:999px;font-size:10px;font-weight:700}
    .status.active{background:#ecfdf5;color:#047857}.status.inactive{background:#f1f5f9;color:#64748b}
    .dot{width:6px;height:6px;border-radius:50%;background:currentColor}
    .section-name{min-height:40px;margin-top:7px;color:#172554;font-size:13px;font-weight:800;line-height:1.35}
    .section-bottom{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-top:10px}
    .order{color:#64748b;font-size:11px;white-space:nowrap}
    .actions{display:flex;gap:6px;flex-wrap:wrap;justify-content:flex-end}
    .action{display:inline-flex;align-items:center;justify-content:center;min-height:32px;padding:0 10px;border:1px solid transparent;border-radius:8px;background:#f8fafc;color:#334155;text-decoration:none;font-size:10px;font-weight:700;cursor:pointer}
    .edit,.manage{background:#eff6ff;color:#2563eb}.edit:hover,.manage:hover{background:#dbeafe}
    .toggle{border-color:#e2e8f0}.toggle:hover{background:#f1f5f9}
    .empty{padding:28px;text-align:center;border:1px dashed #cbd5e1;border-radius:10px;color:#64748b;font-size:12px}
    .ms-footer{display:flex;justify-content:space-between;margin-top:4px;color:#64748b;font-size:11px}
    .no-result{display:none;padding:28px;text-align:center;border:1px dashed #cbd5e1;border-radius:12px;background:#f8fafc;color:#64748b;font-size:12px}

    @media(max-width:1000px){.section-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
    @media(max-width:700px){
        .ms-head{flex-direction:column}.ms-add{align-self:flex-start}
        .ms-tools{grid-template-columns:1fr}.section-grid{grid-template-columns:1fr}
        .section-card{min-height:auto}.section-bottom{align-items:flex-start;flex-direction:column}
        .actions{width:100%;justify-content:flex-start}
    }
</style>

<div class="master-section">
    <div class="ms-head">
        <div>
            <h1>Master Seksi</h1>
            <p>Kelola Seksi berdasarkan Bagian organisasi.</p>
        </div>
        <a href="/admin/sections/create" class="ms-add">+ Tambah Seksi</a>
    </div>

    <div class="ms-tools">
        <input id="sectionSearch" class="ms-search" type="search"
               placeholder="Cari nama Seksi, kode, atau Bagian..." autocomplete="off">
        <select id="departmentFilter" class="ms-filter">
            <option value="">Semua Bagian</option>
            <% departments.forEach(dept => { %>
                <option value="<%= dept.id %>"><%= dept.kode %> — <%= dept.nama %></option>
            <% }) %>
        </select>
    </div>

    <div id="departmentList">
        <% if (departments.length === 0) { %>
            <div class="empty">Belum ada data Seksi.</div>
        <% } else { %>

            <% departments.forEach((dept, i) => { %>
                <section class="dept <%= colors[i % colors.length] %>" data-department-id="<%= dept.id %>">

                    <div class="dept-head" onclick="toggleDepartment(this)">
                        <div class="dept-mark"><%= dept.kode %></div>
                        <div class="dept-info">
                            <div class="dept-name"><%= dept.nama %></div>
                            <div class="dept-meta"><%= dept.sections.length %> Seksi</div>
                        </div>
                        <button type="button" class="dept-toggle" aria-label="Buka atau tutup Bagian">⌃</button>
                    </div>

                    <div class="dept-body">
                        <div class="section-grid">

                            <% dept.sections.forEach(section => { %>
                                <article class="section-card"
                                         data-search="<%= [section.kode,section.nama,section.department_kode,section.department_nama].join(' ').toLowerCase() %>">

                                    <div class="section-top">
                                        <div class="section-code"><%= section.kode %></div>

                                        <% if (section.aktif === 1) { %>
                                            <span class="status active"><span class="dot"></span>Aktif</span>
                                        <% } else { %>
                                            <span class="status inactive"><span class="dot"></span>Tidak Aktif</span>
                                        <% } %>
                                    </div>

                                    <div class="section-name"><%= section.nama %></div>

                                    <div class="section-bottom">
                                        <span class="order">Urutan <%= section.urutan %></span>

                                        <div class="actions">
                                            <a class="action edit" href="/admin/sections/<%= section.id %>/edit">Edit</a>
                                            <a class="action manage" href="/admin/sections/<%= section.id %>/manage">Kelola</a>

                                            <form action="/admin/sections/<%= section.id %>/toggle" method="POST" style="display:inline">
                                                <button type="submit" class="action toggle">
                                                    <%= section.aktif === 1 ? "Nonaktifkan" : "Aktifkan" %>
                                                </button>
                                            </form>
                                        </div>
                                    </div>
                                </article>
                            <% }) %>

                        </div>
                    </div>
                </section>
            <% }) %>

        <% } %>
    </div>

    <div id="noResult" class="no-result">Tidak ada Seksi yang cocok dengan pencarian.</div>

    <div class="ms-footer">
        <span>Total: <strong><%= departments.length %></strong> Bagian · <strong><%= sections.length %></strong> Seksi</span>
        <span>Kelola Seksi berdasarkan Bagian</span>
    </div>
</div>

<script>
(function () {
    const search = document.getElementById("sectionSearch");
    const filter = document.getElementById("departmentFilter");
    const panels = Array.from(document.querySelectorAll(".dept"));
    const noResult = document.getElementById("noResult");

    function applyFilter() {
        const q = (search.value || "").trim().toLowerCase();
        const deptId = filter.value;
        let visiblePanels = 0;

        panels.forEach(panel => {
            if (deptId && panel.dataset.departmentId !== deptId) {
                panel.style.display = "none";
                return;
            }

            let visibleCards = 0;

            panel.querySelectorAll(".section-card").forEach(card => {
                const visible = !q || (card.dataset.search || "").includes(q);
                card.style.display = visible ? "" : "none";
                if (visible) visibleCards++;
            });

            panel.style.display = visibleCards ? "" : "none";
            if (visibleCards) visiblePanels++;
        });

        noResult.style.display = visiblePanels ? "none" : "block";
    }

    search.addEventListener("input", applyFilter);
    filter.addEventListener("change", applyFilter);
})();

function toggleDepartment(header) {
    const panel = header.closest(".dept");
    const body = panel.querySelector(".dept-body");
    const button = panel.querySelector(".dept-toggle");
    const open = body.style.display !== "none";

    body.style.display = open ? "none" : "";
    button.textContent = open ? "⌄" : "⌃";
}
</script>
