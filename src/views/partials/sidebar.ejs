<aside class="app-sidebar">

    <!-- BRAND -->

    <div class="sidebar-brand">

        <div class="brand-logo">
            🚀
        </div>

        <div>

            <strong>
                OpenWO
            </strong>

            <small>
                Work Order System
            </small>

        </div>

    </div>


    <!-- MENU -->

    <nav class="sidebar-nav">

        <div class="nav-section-title">
            MENU UTAMA
        </div>


        <a
            href="/dashboard"
            class="<%= title === 'Dashboard' ? 'active' : '' %>"
        >

            <span class="nav-icon">
                🏠
            </span>

            <span>
                Dashboard
            </span>

        </a>


        <a
            href="/workorder"
            class="<%= title === 'Work Order Saya' ? 'active' : '' %>"
        >

            <span class="nav-icon">
                📋
            </span>

            <span>
                Work Order Saya
            </span>

        </a>


        <a
            href="/report"
            class="<%= title === 'Laporan' ? 'active' : '' %>"
        >

            <span class="nav-icon">
                📊
            </span>

            <span>
                Laporan
            </span>

        </a>


        <div class="nav-section-title nav-section-setting">
            SISTEM
        </div>


        <a
            href="/setting"
            class="<%= title === 'Pengaturan' ? 'active' : '' %>"
        >

            <span class="nav-icon">
                ⚙️
            </span>

            <span>
                Pengaturan
            </span>

        </a>

    </nav>


    <!-- SIDEBAR FOOTER -->

    <div class="sidebar-footer">

        <div class="sidebar-user">

            <%
                const sidebarUser =
                    user || {};

                const sidebarNama =
                    sidebarUser.nama || "Pengguna";

                const sidebarRole =
                    sidebarUser.role || "pengguna";

                const sidebarAvatar =
                    sidebarNama
                        .split(" ")
                        .filter(Boolean)
                        .map(word => word[0])
                        .join("")
                        .substring(0, 2)
                        .toUpperCase();
            %>

            <div class="sidebar-avatar">
                <%= sidebarAvatar %>
            </div>

            <div>

                <strong>
                    <%= sidebarNama %>
                </strong>

                <small>
                    <%= sidebarRole.charAt(0).toUpperCase() +
                        sidebarRole.slice(1) %>
                </small>

            </div>

        </div>

    </div>

</aside>