<!DOCTYPE html>
<html lang="id">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Akses Ditolak • OpenWO</title>

    <style>

        * {
            box-sizing: border-box;
        }

        body {
            min-height: 100vh;
            margin: 0;

            display: flex;
            align-items: center;
            justify-content: center;

            background: #f5f7fb;

            font-family:
                Arial,
                Helvetica,
                sans-serif;

            color: #172033;
        }

        .access-page {
            width: 100%;
            max-width: 430px;
            padding: 24px;
        }

        .access-card {
            background: #ffffff;

            border: 1px solid #e2e6ee;
            border-radius: 18px;

            padding: 38px 32px;

            text-align: center;

            box-shadow:
                0 12px 35px
                rgba(20, 35, 60, 0.08);
        }

        .access-icon {
            width: 68px;
            height: 68px;

            margin: 0 auto 20px;

            display: flex;
            align-items: center;
            justify-content: center;

            border-radius: 18px;

            background: #fff4e5;

            font-size: 32px;
        }

        .access-code {
            margin-bottom: 8px;

            font-size: 13px;
            font-weight: 700;

            letter-spacing: 1px;

            color: #d97706;
        }

        h1 {
            margin: 0 0 10px;
            font-size: 25px;
        }

        p {
            margin: 0;

            line-height: 1.6;

            font-size: 14px;

            color: #6b7280;
        }

        .access-action {
            display: inline-block;

            margin-top: 26px;

            padding: 11px 22px;

            border-radius: 10px;

            background: #2864e8;
            color: #ffffff;

            text-decoration: none;

            font-size: 14px;
            font-weight: 600;
        }

        .access-action:hover {
            background: #2058d2;
        }

    </style>

</head>

<body>

    <main class="access-page">

        <section class="access-card">

            <div class="access-icon">
                🔒
            </div>

            <div class="access-code">
                ERROR 403
            </div>

            <h1>
                Akses Ditolak
            </h1>

            <p>
                Anda tidak memiliki otoritas
                untuk mengakses halaman atau
                melakukan tindakan ini.
            </p>

            <a
                href="/dashboard"
                class="access-action"
            >
                Kembali ke Dashboard
            </a>

        </section>

    </main>

</body>

</html>