<%
    /*
     * ==========================================
     * SLA HEALTH — REUSABLE GAUGE COMPONENT
     * ==========================================
     *
     * Input:
     * sla = {
     *     onTrack: 78,
     *     warning: 15,
     *     breach: 7
     * }
     */

    const data = sla || {};

    const onTrack = Number(data.onTrack || 0);
    const warning = Number(data.warning || 0);
    const breach = Number(data.breach || 0);

    const total = onTrack + warning + breach;

    const healthPercentage = total
        ? Math.round((onTrack / total) * 100)
        : 0;

    let healthLabel = "Belum Ada Data";

    if (total > 0) {
        if (healthPercentage >= 90) {
            healthLabel = "Excellent";
        } else if (healthPercentage >= 75) {
            healthLabel = "On Track";
        } else if (healthPercentage >= 50) {
            healthLabel = "Warning";
        } else {
            healthLabel = "Critical";
        }
    }

    /*
     * Gauge:
     * 0   = kiri
     * 100 = kanan
     *
     * Sudut jarum:
     * -90° sampai +90°
     */
    const needleAngle = -90 + (healthPercentage * 1.8);
%>

<section
    class="sla-health-gauge"
    data-sla-health
>

    <!-- HEADER -->
    <div class="sla-gauge-header">

        <div>
            <div class="sla-gauge-title">
               📈  SLA IT SERVICE
            </div>

            <div class="sla-gauge-subtitle">
                <p>Kesehatan SLA Work Order</p>
            </div>
        </div>

        <div class="sla-gauge-total">
            <strong><%= total %></strong>
            <span>WO</span>
        </div>

    </div>


    <!-- GAUGE -->
    <div class="sla-gauge">

        <div class="sla-gauge-arc">

            <div class="sla-gauge-zone sla-zone-breach"></div>

            <div class="sla-gauge-zone sla-zone-warning"></div>

            <div class="sla-gauge-zone sla-zone-track"></div>

        </div>


        <!-- TICK MARKS -->
        <div class="sla-gauge-ticks">

            <% for (let i = 0; i <= 10; i++) { %>

                <span
                    style="
                        transform:
                        rotate(<%= -90 + (i * 18) %>deg)
                        translateY(-76px);
                    "
                ></span>

            <% } %>

        </div>


        <!-- NEEDLE -->
        <div
            class="sla-gauge-needle"
            style="
                transform:
                translateX(-50%)
                rotate(<%= needleAngle %>deg);
            "
        >
            <span></span>
        </div>


        <!-- CENTER -->
        <div class="sla-gauge-center">

            <div class="sla-gauge-value">
                <%= healthPercentage %>%
            </div>

            <div class="sla-gauge-status">
                <%= healthLabel %>
            </div>

        </div>

    </div>


    <!-- STATUS SUMMARY -->
    <div class="sla-gauge-summary">

        <button
            type="button"
            class="sla-summary-item"
            data-sla-status="ON_TRACK"
        >
            <span class="sla-dot sla-dot-track"></span>

            <span>
                <strong><%= onTrack %></strong>
                <small>On Track</small>
            </span>
        </button>


        <button
            type="button"
            class="sla-summary-item"
            data-sla-status="WARNING"
        >
            <span class="sla-dot sla-dot-warning"></span>

            <span>
                <strong><%= warning %></strong>
                <small>Warning</small>
            </span>
        </button>


        <button
            type="button"
            class="sla-summary-item"
            data-sla-status="BREACH"
        >
            <span class="sla-dot sla-dot-breach"></span>

            <span>
                <strong><%= breach %></strong>
                <small>Breach</small>
            </span>
        </button>

    </div>


    <!-- DETAIL -->
    <button
        type="button"
        class="sla-detail-button"
        data-sla-detail
    >
        Lihat Detail SLA
        <span>→</span>
    </button>

</section>


<style>

    /* ==========================================
       CONTAINER
       ========================================== */

    .sla-health-gauge {
        position: relative;

        width: 100%;
        height: 100%;
        min-height: 100%;

        padding: 24px;

        box-sizing: border-box;

        border-radius: 12px;

        background: #ffffff;

        border: 1px solid #e5e7eb;

        overflow: hidden;
    }


    /* ==========================================
       HEADER
       ========================================== */

    .sla-gauge-header {
        display: flex;

        align-items: center;

        justify-content: space-between;

        gap: 8px;
    }


    .sla-gauge-title {
        font-size: 17px;
        margin-bottom: 24px; 
        font-weight: 800;

        letter-spacing: .02em;
    }


    .sla-gauge-subtitle {
        margin-top: -22px;
        font-size: 13px;

        color: #8a94a6;
    }


    .sla-gauge-total {
        display: flex;

        align-items: baseline;

        gap: 3px;

        color: #7c8798;
    }


    .sla-gauge-total strong {
        font-size: 13px;

        color: #172033;
    }


    .sla-gauge-total span {
        font-size: 8px;
    }


    /* ==========================================
       GAUGE AREA
       ========================================== */

    .sla-gauge {
        position: relative;

        width: 100%;
        max-width: 220px;

        height: 145px;

        margin: 8px auto 0;

        overflow: hidden;
    }


    /*
     * Outer arc
     */

    .sla-gauge-arc {
        position: absolute;

        left: 50%;
        top: 4px;

        width: 190px;
        height: 220px;

        transform: translateX(-50%);

        border-radius: 50%;

        background:
            conic-gradient(
                from 270deg,
                #ef4444 0deg 54deg,
                #f59e0b 54deg 108deg,
                #22c55e 108deg 180deg,
                transparent 180deg 360deg
            );

        -webkit-mask:
            radial-gradient(
                farthest-side,
                transparent calc(100% - 15px),
                #000 calc(100% - 14px)
            );

        mask:
            radial-gradient(
                farthest-side,
                transparent calc(100% - 15px),
                #000 calc(100% - 14px)
            );
    }


    /*
     * Ticks
     */

    .sla-gauge-ticks {
        position: absolute;

        left: 50%;

        bottom: 6px;

        width: 2px;

        height: 2px;

        transform: translateX(-50%);
    }


    .sla-gauge-ticks span {
        position: absolute;

        left: 0;

        top: 0;

        width: 2px;

        height: 6px;

        border-radius: 2px;

        background: #cbd5e1;

        transform-origin: 1px 76px;
    }


    /* ==========================================
       NEEDLE
       ========================================== */

    .sla-gauge-needle {
        position: absolute;

        left: 50%;
        bottom: 22px;

        width: 2px;
        height: 80px;

        transform-origin: 50% 100%;

        transition:
            transform .6s
            cubic-bezier(.2,.8,.2,1);
    }


    .sla-gauge-needle span {
        position: absolute;

        left: 50%;

        bottom: 0;

        width: 5px;

        height: 5px;

        transform: translateX(-50%);

        border-radius: 50%;

        background: #64748b;

        box-shadow:
            0 0 0 3px #ffffff,
            0 1px 5px rgba(0,0,0,.15);
    }


    .sla-gauge-needle::before {
        content: "";

        position: absolute;

        left: 50%;

        top: 0;

        width: 3px;

        height: 58px;

        transform:
            translateX(-50%);

        border-radius: 4px;

        background: #475569;
    }


    /* ==========================================
       CENTER TEXT
       ========================================== */

    .sla-gauge-center {
        position: absolute;

        left: 50%;
        bottom: 12px;

        transform: translateX(-50%);

        text-align: center;

        pointer-events: none;
    }


    .sla-gauge-value {
        font-size: 22px;

        line-height: 1;

        font-weight: 900;

        letter-spacing: -.04em;

        color: #172033;
    }


    .sla-gauge-status {
        margin-top: 3px;

        font-size: 8px;

        font-weight: 700;

        color: #64748b;
    }


    /* ==========================================
       SUMMARY
       ========================================== */

    .sla-gauge-summary {
        display: grid;

        grid-template-columns:
            repeat(3, 1fr);

        gap: 5px;

        margin-top: -2px;
    }


    .sla-summary-item {
        display: flex;

        align-items: center;

        justify-content: center;

        gap: 4px;

        min-width: 0;

        padding: 5px 3px;

        border: 0;

        border-radius: 7px;

        background: #f8fafc;

        cursor: pointer;

        font-family: inherit;
    }


    .sla-summary-item:hover {
        background: #f1f5f9;
    }


    .sla-summary-item > span:last-child {
        display: flex;

        flex-direction: column;

        align-items: flex-start;
    }


    .sla-summary-item strong {
        font-size: 10px;

        line-height: 1;
    }


    .sla-summary-item small {
        margin-top: 2px;

        font-size: 7px;

        color: #8a94a6;
    }


    .sla-dot {
        width: 5px;

        height: 5px;

        flex: 0 0 5px;

        border-radius: 50%;
    }


    .sla-dot-track {
        background: #22c55e;
    }


    .sla-dot-warning {
        background: #f59e0b;
    }


    .sla-dot-breach {
        background: #ef4444;
    }


    /* ==========================================
       DETAIL BUTTON
       ========================================== */

    .sla-detail-button {
        display: block;

        width: 100%;

        margin-top: 8px;

        padding: 5px;

        border: 0;

        border-radius: 7px;

        background: transparent;

        color: #2563eb;

        font-family: inherit;

        font-size: 8px;

        font-weight: 700;

        cursor: pointer;
    }


    .sla-detail-button:hover {
        background: #eff6ff;
    }


    .sla-detail-button span {
        margin-left: 3px;

        transition:
            margin-left .15s ease;
    }


    .sla-detail-button:hover span {
        margin-left: 6px;
    }


    /* ==========================================
       MOBILE
       ========================================== */

    @media (max-width: 900px) {

        .sla-gauge {
            max-width: 220px;
        }

        .sla-gauge-title {
            font-size: 13px;
        }

        .sla-gauge-subtitle {
            font-size: 9px;
        }

    }

</style>


<script>

    /*
     * ==========================================
     * SLA HEALTH EVENTS
     * ==========================================
     */

    document
        .querySelectorAll(
            '[data-sla-health]'
        )
        .forEach((component) => {

            component
                .querySelectorAll(
                    '[data-sla-status]'
                )
                .forEach((item) => {

                    item.addEventListener(
                        'click',
                        () => {

                            const status =
                                item.dataset.slaStatus;

                            console.log(
                                '[SLA HEALTH]',
                                status
                            );

                        }
                    );

                });


            const detailButton =
                component.querySelector(
                    '[data-sla-detail]'
                );


            if (detailButton) {

                detailButton.addEventListener(
                    'click',
                    () => {

                        console.log(
                            '[SLA HEALTH] DETAIL'
                        );

                    }
                );

            }

        });

</script>