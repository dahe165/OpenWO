<%
    const data = Array.isArray(technicianPerformance)
        ? technicianPerformance
        : [];
%>

<div class="technician-performance">

    <% if (data.length === 0) { %>

        <div class="text-center text-muted py-4">
            <div class="fs-3 mb-2">👨‍🔧</div>
            <div class="fw-semibold">
                Belum ada data performa teknisi
            </div>
            <small>
                Data akan muncul setelah terdapat Work Order yang selesai.
            </small>
        </div>

    <% } else { %>

        <div class="table-responsive">
            <table class="table align-middle mb-0">

                <thead>
                    <tr>
                        <th>Teknisi</th>
                        <th class="text-center">WO</th>
                        <th style="min-width: 160px;">Compliance</th>
                        <th class="text-center">Avg Resolution</th>
                        <th class="text-center">Avg Waiting</th>
                    </tr>
                </thead>

                <tbody>

                    <% data.forEach((item) => { %>

                        <%
                            const compliance =
                                Number(item.compliance) || 0;

                            const resolution =
                                Number(item.averageResolutionMinutes) || 0;

                            const waiting =
                                Number(item.averageWaitingMinutes) || 0;

                            let complianceClass = "bg-success";

                            if (compliance < 75) {
                                complianceClass = "bg-danger";
                            } else if (compliance < 90) {
                                complianceClass = "bg-warning";
                            }
                        %>

                        <tr>

                            <!-- TEKNISI -->
                            <td>
                                <div class="d-flex align-items-center gap-2">

                                    <div class="technician-avatar">
                                        <span>👨‍🔧</span>
                                    </div>

                                    <div>
                                        <div class="fw-semibold">
                                            <%= item.teknisi || "Tidak diketahui" %>
                                        </div>
                                    </div>

                                </div>
                            </td>

                            <!-- TOTAL WO -->
                            <td class="text-center">
                                <span class="badge text-bg-light border">
                                    <%= item.total || 0 %>
                                </span>
                            </td>

                            <!-- COMPLIANCE -->
                            <td>

                                <div class="d-flex justify-content-between mb-1">

                                    <small class="fw-semibold">
                                        <%= compliance.toFixed(1) %>%
                                    </small>

                                </div>

                                <div
                                    class="progress"
                                    role="progressbar"
                                    aria-valuenow="<%= compliance %>"
                                    aria-valuemin="0"
                                    aria-valuemax="100"
                                    style="height: 7px;"
                                >
                                    <div
                                        class="progress-bar <%= complianceClass %>"
                                        style="width: <%= Math.min(compliance, 100) %>%"
                                    ></div>
                                </div>

                            </td>

                            <!-- AVG RESOLUTION -->
                            <td class="text-center">

                                <div class="fw-semibold">
                                    <%= resolution.toFixed(1) %>
                                </div>

                                <small class="text-muted">
                                    menit
                                </small>

                            </td>

                            <!-- AVG WAITING -->
                            <td class="text-center">

                                <div class="fw-semibold">
                                    <%= waiting.toFixed(1) %>
                                </div>

                                <small class="text-muted">
                                    menit
                                </small>

                            </td>

                        </tr>

                    <% }); %>

                </tbody>

            </table>
        </div>

    <% } %>

</div>


<style>
    .technician-performance {
        width: 100%;
    }

    .technician-performance table {
        font-size: 0.9rem;
    }

    .technician-performance thead th {
        font-size: 0.78rem;
        font-weight: 600;
        color: #6c757d;
        white-space: nowrap;
        border-bottom-width: 1px;
    }

    .technician-performance tbody tr:last-child td {
        border-bottom: 0;
    }

    .technician-avatar {
        width: 36px;
        height: 36px;
        border-radius: 10px;
        background: #f1f3f5;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .technician-avatar span {
        font-size: 18px;
    }

    .technician-performance .progress {
        background: #e9ecef;
        border-radius: 20px;
        overflow: hidden;
    }

    .technician-performance .progress-bar {
        border-radius: 20px;
    }

    @media (max-width: 768px) {

        .technician-performance table {
            min-width: 650px;
        }

    }
</style>